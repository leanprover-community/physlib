module

public import Mathlib.Analysis.Normed.Lp.MeasurableSpace
public import Mathlib.Analysis.Normed.Module.WeakDual
public import Physlib.SpaceAndTime.TimeAndSpace.Basic

/-!
# Glimm–Jaffe field configurations

Real scalar field configurations, their complex pairing and their time translation.

## i. Overview

A field configuration of a real scalar Euclidean quantum field is a tempered distribution `ω`,
so the basic observable is its evaluation `ω f` on a real Schwartz test function `f`.
Time translation acts by duality on complex-linear functionals of complex Schwartz tests,
which include the complex-linear extensions of field configurations.

The parameter `d` counts spatial dimensions. Spacetime is Physlib's
`TimeAndSpace d = Time × Space d`, so the source's total dimension is `d + 1`.
Field configurations carry the weak dual topology and the cylinder sigma algebra.
Their pairing with complex Schwartz functions is extended complex linearly.

## ii. Key results

* `FieldConfiguration`: real tempered distributions with the cylinder sigma algebra.
* `FieldConfiguration.pairing`: the complex-linear extension of a field configuration.
* `timeTranslation`: time translation of a field by duality.

## iii. Table of contents

- A. Field configurations
- B. Time translation

## iv. References

* Glimm and Jaffe, *Quantum Physics*. [ref: glimm1987quantum]
-/

@[expose] public section
noncomputable section

open scoped SchwartzMap

namespace GlimmJaffe

/-! ## A. Field configurations -/

/-- Real scalar field configurations, with the weak dual topology on tempered distributions. -/
abbrev FieldConfiguration (d : ℕ) := WeakDual ℝ (𝓢(TimeAndSpace d, ℝ))

namespace FieldConfiguration

/-- The cylinder sigma algebra generated by all real Schwartz evaluations. -/
instance fieldConfigurationMeasurableSpace (d : ℕ) : MeasurableSpace (FieldConfiguration d) :=
  MeasurableSpace.comap (fun ω f => ω f) inferInstance

variable {d : ℕ}

/-- The complex-linear extension of a real field to complex Schwartz tests,
as an element of the complex weak dual. -/
def pairing (ω : FieldConfiguration d) : WeakDual ℂ (𝓢(TimeAndSpace d, ℂ)) :=
  WeakDual.extendRCLikeL (𝕜 := ℂ) (ω.comp (SchwartzMap.postcompCLM Complex.reCLM))

/-- The pairing evaluates as `ω (Re f) + i ω (Im f)`. -/
lemma pairing_apply (ω : FieldConfiguration d) (f : 𝓢(TimeAndSpace d, ℂ)) :
    pairing ω f = (ω (SchwartzMap.postcompCLM Complex.reCLM f) : ℂ) +
      Complex.I * (ω (SchwartzMap.postcompCLM Complex.imCLM f) : ℂ) := by
  have h : SchwartzMap.postcompCLM Complex.reCLM (Complex.I • f) =
      -SchwartzMap.postcompCLM Complex.imCLM f := by
    ext x
    simp
  change (ω (SchwartzMap.postcompCLM Complex.reCLM f) : ℂ) -
    Complex.I * (ω (SchwartzMap.postcompCLM Complex.reCLM (Complex.I • f)) : ℂ) = _
  rw [h, map_neg, Complex.ofReal_neg]
  ring

/-! ## B. Time translation -/

/-- Time translation of a (complexified) field by duality,
  `(T_s ω)(f) = ω((t, x) ↦ f(t - s, x))`.
The dimension assumption retains the source's requirement of at least one spatial dimension. -/
@[nolint unusedArguments]
def timeTranslation [Fact (1 ≤ d)] (s : ℝ) (ω : WeakDual ℂ (𝓢(TimeAndSpace d, ℂ))) :
    WeakDual ℂ (𝓢(TimeAndSpace d, ℂ)) :=
  ω.comp (SchwartzMap.compSubConstCLM ℂ (⟨s⟩, 0))

end FieldConfiguration
end GlimmJaffe

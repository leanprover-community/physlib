module

-- Explicit public imports are needed for the bump and measurable-space instances;
-- their private transitive imports through Schwartz space do not expose the instances.
public import Mathlib.Analysis.Calculus.BumpFunction.InnerProduct
public import Mathlib.Analysis.Calculus.BumpFunction.Normed
public import Mathlib.Analysis.Distribution.SchwartzSpace.Basic
public import Mathlib.Analysis.LocallyConvex.WeakDual
public import Mathlib.Analysis.Normed.Lp.MeasurableSpace
public import Mathlib.MeasureTheory.Measure.ProbabilityMeasure
public import Physlib.SpaceAndTime.Space.EuclideanGroup.AffineGroup

/-!
# Glimm–Jaffe Euclidean fields

Test functions, field configurations and generating functionals for a real scalar field.

## i. Overview

This is the measure-based setup used by `OSforGFF`, adapted to Mathlib and Physlib.
The parameter `d` counts all Euclidean spacetime coordinates, with coordinate zero
designated as time. Field configurations are real tempered distributions with their
weak dual topology and cylinder sigma algebra. Their pairing with complex Schwartz
functions is extended complex linearly.

Translations use Mathlib's Schwartz pullback; Euclidean transformations use Physlib's
full Euclidean group, including reflections. The reflected conjugate is a named map,
so it does not change the pointwise `Star` instance on Schwartz functions.

## ii. Key results

* `FieldConfiguration`: real tempered distributions with the cylinder sigma algebra.
* `generatingFunctional` and `generatingFunctionalReal`: characteristic functionals.
* `reflectedConjugate`: conjugation combined with Euclidean time reflection.
* `smearedTwoPointFunction`: the two-point function at a specified mollifier scale.

## iii. Table of contents

- A. Field configurations and generating functionals
- B. Euclidean symmetries and positive time
- C. Smeared two-point functions

## iv. References

* Glimm and Jaffe, *Quantum Physics*. [ref: glimm1987quantum]
* Cherkis et al., *OSforGFF*, `Spacetime/Basic.lean`,
  `Spacetime/PositiveTimeTestFunction.lean`, `Spacetime/TimeTranslation.lean`,
  and `Schwinger/TwoPoint.lean`. [ref: osforgff]
-/

@[expose] public section
noncomputable section

open MeasureTheory
open scoped SchwartzMap

namespace GlimmJaffe

/-! ## A. Field configurations and generating functionals -/

/-- Euclidean spacetime with `d` total coordinates; coordinate zero is time. -/
abbrev EuclideanSpacetime (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- Real scalar field configurations, with the weak dual topology on tempered distributions. -/
abbrev FieldConfiguration (d : ℕ) := WeakDual ℝ (𝓢(EuclideanSpacetime d, ℝ))

/-- The cylinder sigma algebra generated by all real Schwartz evaluations. -/
instance fieldConfigurationMeasurableSpace (d : ℕ) : MeasurableSpace (FieldConfiguration d) :=
  MeasurableSpace.comap (fun ω f => ω f) inferInstance

variable {d : ℕ}

/-- The complex-linear extension of the pairing of a real field with a Schwartz test. -/
def pairing (ω : FieldConfiguration d) (f : 𝓢(EuclideanSpacetime d, ℂ)) : ℂ :=
  (ω (SchwartzMap.postcompCLM Complex.reCLM f) : ℂ) +
    Complex.I * (ω (SchwartzMap.postcompCLM Complex.imCLM f) : ℂ)

/-- The characteristic functional `Z[f] = ∫ exp(i ⟨ω, f⟩) dμ` on complex tests. -/
def generatingFunctional (μ : ProbabilityMeasure (FieldConfiguration d))
    (f : 𝓢(EuclideanSpacetime d, ℂ)) : ℂ :=
  ∫ ω, Complex.exp (Complex.I * pairing ω f) ∂μ.toMeasure

/-- The characteristic functional restricted to real Schwartz tests. -/
def generatingFunctionalReal (μ : ProbabilityMeasure (FieldConfiguration d))
    (f : 𝓢(EuclideanSpacetime d, ℝ)) : ℂ :=
  ∫ ω, Complex.exp (Complex.I * (ω f : ℂ)) ∂μ.toMeasure

/-! ## B. Euclidean symmetries and positive time -/

/-- Pullback of a complex test by the inverse of a full Euclidean transformation. -/
def euclideanAction (g : EuclideanGroup d) :
    𝓢(EuclideanSpacetime d, ℂ) →L[ℂ] 𝓢(EuclideanSpacetime d, ℂ) :=
  let e := EuclideanGroup.toAffineIsometryHom g⁻¹
  SchwartzMap.compCLMOfAntilipschitz ℂ (K := 1)
    (g := fun x => e.linearIsometryEquiv x + e 0)
    (e.linearIsometryEquiv.toContinuousLinearMap.hasTemperateGrowth.add (by fun_prop))
    (by
      have he : (fun x => e.linearIsometryEquiv x + e 0) = e := by
        funext x
        simpa only [vadd_eq_add, add_zero] using (e.map_vadd 0 x).symm
      rw [he]
      exact e.antilipschitzWith)

/-- The Euclidean action is pullback by the inverse affine isometry. -/
@[simp]
lemma euclideanAction_apply (g : EuclideanGroup d) (f : 𝓢(EuclideanSpacetime d, ℂ))
    (x : EuclideanSpacetime d) :
    euclideanAction g f x = f (EuclideanGroup.toAffineIsometryHom g⁻¹ x) := by
  change f (_ + _) = _
  congr 1
  simpa only [vadd_eq_add, add_zero] using
    ((EuclideanGroup.toAffineIsometryHom g⁻¹).map_vadd 0 x).symm

variable [Fact (2 ≤ d)]

/-- The distinguished Euclidean time coordinate. -/
def timeIndex : Fin d := ⟨0, by have := Fact.out (p := 2 ≤ d); omega⟩

/-- Reflection of the time coordinate, as a continuous linear equivalence. -/
def timeReflection : EuclideanSpacetime d ≃L[ℝ] EuclideanSpacetime d :=
  (EuclideanSpace.equiv (Fin d) ℝ).trans
    ((ContinuousLinearEquiv.piCongrRight fun i : Fin d =>
      if i = timeIndex then ContinuousLinearEquiv.neg ℝ else ContinuousLinearEquiv.refl ℝ ℝ).trans
        (EuclideanSpace.equiv (Fin d) ℝ).symm)

/-- Time reflection negates the time coordinate and fixes every spatial coordinate. -/
lemma timeReflection_apply (x : EuclideanSpacetime d) (i : Fin d) :
    timeReflection x i = if i = timeIndex then -x i else x i := by
  change (if i = timeIndex then ContinuousLinearEquiv.neg ℝ else
    ContinuousLinearEquiv.refl ℝ ℝ) (x i) = _
  split <;> rfl

/-- Complex conjugation after time reflection: `f ↦ (x ↦ conj (f (Θ x)))`. -/
def reflectedConjugate (f : 𝓢(EuclideanSpacetime d, ℂ)) : 𝓢(EuclideanSpacetime d, ℂ) :=
  SchwartzMap.postcompCLM Complex.conjCLE.toContinuousLinearMap
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℝ timeReflection f)

/-- The reflected conjugate includes both time reflection and complex conjugation. -/
@[simp]
lemma reflectedConjugate_apply (f : 𝓢(EuclideanSpacetime d, ℂ))
    (x : EuclideanSpacetime d) :
    reflectedConjugate f x = starRingEnd ℂ (f (timeReflection x)) := rfl

/-- Applying the reflected conjugation twice recovers the original test. -/
@[simp]
lemma reflectedConjugate_involutive (f : 𝓢(EuclideanSpacetime d, ℂ)) :
    reflectedConjugate (reflectedConjugate f) = f := by
  ext x
  simp only [reflectedConjugate_apply, starRingEnd_self_apply]
  congr 1
  ext i
  simp only [timeReflection_apply]
  split <;> simp_all

/-- Complex Schwartz functions whose topological support lies strictly at positive time.
This retains the support convention of `OSforGFF`. -/
abbrev PositiveTimeTestFunction (d : ℕ) [Fact (2 ≤ d)] :=
  {f : 𝓢(EuclideanSpacetime d, ℂ) | tsupport f ⊆ {x | 0 < x timeIndex}}

/-- Time translation of a field by duality: `(T_s ω)(f) = ω(x ↦ f(x - s e₀))`.
The corresponding source convention on test functions is `T_s f(x) = f(x + s e₀)`. -/
def timeTranslation (s : ℝ) (ω : FieldConfiguration d) : FieldConfiguration d :=
  ω.comp (SchwartzMap.compSubConstCLM ℝ (EuclideanSpace.single timeIndex s))

/-! ## C. Smeared two-point functions -/

omit [Fact (2 ≤ d)] in
/-- Standard bump with outer radius `1 / (n + 1)` and half that inner radius. -/
def standardMollifier (n : ℕ) : ContDiffBump (0 : EuclideanSpacetime d) where
  rIn := 1 / (2 * (n + 1 : ℕ))
  rOut := 1 / (n + 1 : ℕ)
  rIn_pos := by positivity
  rIn_lt_rOut := by
    have hn : (0 : ℝ) < (n + 1 : ℕ) := by positivity
    exact one_div_lt_one_div_of_lt hn (by linarith)

omit [Fact (2 ≤ d)] in
/-- The normalized standard mollifier as a real Schwartz test, with integral one. -/
def mollifierTest (n : ℕ) : 𝓢(EuclideanSpacetime d, ℝ) :=
  ((standardMollifier (d := d) n).hasCompactSupport_normed (μ := volume)).toSchwartzMap
    (standardMollifier n).contDiff_normed

omit [Fact (2 ≤ d)] in
/-- The second moment smeared at zero and at `x` with normalized mollifiers of scale `n`. -/
def smearedTwoPointFunction (μ : ProbabilityMeasure (FieldConfiguration d))
    (n : ℕ) (x : EuclideanSpacetime d) : ℝ :=
  ∫ ω, ω (SchwartzMap.compSubConstCLM ℝ x (mollifierTest n)) * ω (mollifierTest n)
    ∂μ.toMeasure

end GlimmJaffe

module

-- Explicit public imports are needed for the bump and measurable-space instances;
-- their private transitive imports through Schwartz space do not expose the instances.
public import Mathlib.Analysis.Calculus.BumpFunction.InnerProduct
public import Mathlib.Analysis.Calculus.BumpFunction.Normed
public import Mathlib.Analysis.Normed.Lp.MeasurableSpace
public import Mathlib.MeasureTheory.Measure.ProbabilityMeasure
public import Physlib.SpaceAndTime.Space.EuclideanGroup.AffineGroup
public import Physlib.SpaceAndTime.TimeAndSpace.Basic

/-!
# Glimm–Jaffe Euclidean fields

Test functions, field configurations and generating functionals for a real scalar field.

## i. Overview

This is the measure-based formulation of a real scalar Euclidean quantum field.
A field configuration is a tempered distribution `ω`, so the basic observable is its
evaluation `ω f` on a real Schwartz test function `f`.
A probability measure on these configurations specifies the field statistics, in a way that
Schwinger functions are expectations of products of field evaluations, and the
generating functional is the expectation of `exp(i ⟨ω, f⟩)`. The Glimm–Jaffe axioms
in the companion file impose analyticity, growth bounds, Euclidean invariance,
reflection positivity and ergodicity on this measure. This setup supplies the
Euclidean data for reconstruction.

The parameter `d` counts spatial dimensions. Spacetime is Physlib's
`TimeAndSpace d = Time × Space d`, with the standard origins used by its real
vector-space instances. Thus the source's total dimension is `d + 1`.
Field configurations carry the weak dual topology and the cylinder sigma algebra.
Their pairing with complex Schwartz functions is extended complex linearly.

The full `EuclideanGroup (d + 1)` action is transported through time-first Euclidean
coordinates, so it includes transformations mixing time and space. The normalized
bumps are constructed in those Euclidean coordinates and pulled back to
`TimeAndSpace d`, preserving the source's Euclidean mollifier sequence.
The reflected conjugate combines complex conjugation with time reflection.

## ii. Key results

* `FieldConfiguration`: real tempered distributions with the cylinder sigma algebra.
* `FieldConfiguration.generatingFunctional`: the complex characteristic functional.
* `reflectedConjugate`: conjugation combined with Euclidean time reflection.
* `smearedTwoPointFunction`: the two-point function smeared with an arbitrary normalized bump.

## iii. Table of contents

- A. Field configurations and generating functionals
- B. Euclidean symmetries and positive time
- C. Smeared two-point functions

## iv. References

* Glimm and Jaffe, *Quantum Physics*. [ref: glimm1987quantum]
-/

@[expose] public section
noncomputable section

open MeasureTheory
open scoped SchwartzMap

namespace GlimmJaffe

/-! ## A. Field configurations and generating functionals -/

/-- Real scalar field configurations, with the weak dual topology on tempered distributions. -/
abbrev FieldConfiguration (d : ℕ) := WeakDual ℝ (𝓢(TimeAndSpace d, ℝ))

namespace FieldConfiguration

/-- The cylinder sigma algebra generated by all real Schwartz evaluations. -/
instance fieldConfigurationMeasurableSpace (d : ℕ) : MeasurableSpace (FieldConfiguration d) :=
  MeasurableSpace.comap (fun ω f => ω f) inferInstance

variable {d : ℕ}

/-- The complex-linear extension of the pairing of a real field with a Schwartz test. -/
def pairing (ω : FieldConfiguration d) (f : 𝓢(TimeAndSpace d, ℂ)) : ℂ :=
  (ω (SchwartzMap.postcompCLM Complex.reCLM f) : ℂ) +
    Complex.I * (ω (SchwartzMap.postcompCLM Complex.imCLM f) : ℂ)

/-- The characteristic functional `Z[f] = ∫ exp(i ⟨ω, f⟩) dμ` on complex tests. -/
def generatingFunctional (μ : ProbabilityMeasure (FieldConfiguration d))
    (f : 𝓢(TimeAndSpace d, ℂ)) : ℂ :=
  ∫ ω, Complex.exp (Complex.I * pairing ω f) ∂μ.toMeasure

end FieldConfiguration

open FieldConfiguration

variable {d : ℕ}

/-! ## B. Euclidean symmetries and positive time -/

/-- Pullback by a full Euclidean transformation, including rotations mixing time and space. -/
def euclideanAction (g : EuclideanGroup (d + 1)) :
    𝓢(TimeAndSpace d, ℂ) →L[ℂ] 𝓢(TimeAndSpace d, ℂ) :=
  let e := TimeAndSpace.euclideanCoordinates (d := d)
  let a := EuclideanGroup.toAffineIsometryHom g⁻¹
  let pullback := SchwartzMap.compCLMOfAntilipschitz ℂ (K := 1)
    (g := fun x => a.linearIsometryEquiv x + a 0)
    (a.linearIsometryEquiv.toContinuousLinearMap.hasTemperateGrowth.add (by fun_prop))
    (by
      have ha : (fun x => a.linearIsometryEquiv x + a 0) = a := by
        funext x
        simpa only [vadd_eq_add, add_zero] using (a.map_vadd 0 x).symm
      rw [ha]
      exact a.antilipschitzWith)
  (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ e).comp
    (pullback.comp (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ e.symm))

/-- The full Euclidean pullback expressed in time-first coordinates. -/
@[simp]
lemma euclideanAction_apply (g : EuclideanGroup (d + 1)) (f : 𝓢(TimeAndSpace d, ℂ))
    (x : TimeAndSpace d) :
    euclideanAction g f x = f (TimeAndSpace.euclideanCoordinates.symm
      (EuclideanGroup.toAffineIsometryHom g⁻¹ (TimeAndSpace.euclideanCoordinates x))) := by
  change f (TimeAndSpace.euclideanCoordinates.symm (_ + _)) = _
  congr 2
  simpa only [ContinuousLinearEquiv.coe_coe, vadd_eq_add, add_zero] using
    ((EuclideanGroup.toAffineIsometryHom g⁻¹).map_vadd 0
      (TimeAndSpace.euclideanCoordinates x)).symm

/-- Complex conjugation after time reflection: `f ↦ (x ↦ conj (f (Θ x)))`.
The dimension restriction retains the source's domain of at least two total dimensions. -/
@[nolint unusedArguments]
def reflectedConjugate [Fact (1 ≤ d)] (f : 𝓢(TimeAndSpace d, ℂ)) :
    𝓢(TimeAndSpace d, ℂ) :=
  SchwartzMap.postcompCLM Complex.conjCLE.toContinuousLinearMap
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℝ TimeAndSpace.timeReflection f)

/-- The reflected conjugate includes both time reflection and complex conjugation. -/
@[simp]
lemma reflectedConjugate_apply [Fact (1 ≤ d)] (f : 𝓢(TimeAndSpace d, ℂ))
    (x : TimeAndSpace d) :
    reflectedConjugate f x = starRingEnd ℂ (f (TimeAndSpace.timeReflection x)) := rfl

/-- Applying the reflected conjugation twice recovers the original test. -/
@[simp]
lemma reflectedConjugate_involutive [Fact (1 ≤ d)] (f : 𝓢(TimeAndSpace d, ℂ)) :
    reflectedConjugate (reflectedConjugate f) = f := by
  ext x
  simp only [reflectedConjugate_apply, starRingEnd_self_apply,
    TimeAndSpace.timeReflection_involutive]

/-- Complex Schwartz functions whose topological support lies strictly at positive time.
This retains the support convention of `OSforGFF` and its domain of at least
two total dimensions. -/
@[nolint unusedArguments]
abbrev PositiveTimeTestFunction (d : ℕ) [Fact (1 ≤ d)] :=
  {f : 𝓢(TimeAndSpace d, ℂ) | tsupport f ⊆ {x | 0 < x.1}}

/-- Time translation of a field by duality: `(T_s ω)(f) = ω((t, x) ↦ f(t - s, x))`.
The corresponding source convention on test functions is `T_s f(t, x) = f(t + s, x)`.
The dimension restriction retains the source's domain of at least two total dimensions. -/
def timeTranslation [Fact (1 ≤ d)] (s : ℝ)
    (ω : WeakDual ℂ (𝓢(TimeAndSpace d, ℂ))) :
    WeakDual ℂ (𝓢(TimeAndSpace d, ℂ)) :=
  ω.comp (SchwartzMap.compSubConstCLM ℂ (⟨s⟩, 0))

/-! ## C. Smeared two-point functions -/

/-- The real `n`-point Schwinger function, the expectation of the product of field evaluations. -/
def schwingerFunction (dμ_config : ProbabilityMeasure (FieldConfiguration d)) (n : ℕ)
    (f : Fin n → 𝓢(TimeAndSpace d, ℝ)) : ℝ :=
  ∫ ω, (∏ i, ω (f i)) ∂dμ_config.toMeasure

/-- The real two-point Schwinger function evaluated on two Schwartz tests. -/
def schwingerFunction₂ (dμ_config : ProbabilityMeasure (FieldConfiguration d))
    (f g : 𝓢(TimeAndSpace d, ℝ)) : ℝ :=
  schwingerFunction dμ_config 2 ![f, g]

/-- Convert a smooth bump centered at zero to a real Schwartz test with integral one. -/
def bumpToSchwartz (φ : ContDiffBump (0 : EuclideanSpace ℝ (Fin (d + 1)))) :
    𝓢(TimeAndSpace d, ℝ) :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ TimeAndSpace.euclideanCoordinates
    ((φ.hasCompactSupport_normed (μ := volume)).toSchwartzMap φ.contDiff_normed)

/-- The Euclidean bump retains integral one after transport to time and space coordinates. -/
@[simp]
lemma integral_bumpToSchwartz (φ : ContDiffBump (0 : EuclideanSpace ℝ (Fin (d + 1)))) :
    ∫ x, bumpToSchwartz φ x = 1 := by
  change ∫ x, φ.normed volume (TimeAndSpace.euclideanCoordinates x) = 1
  rw [TimeAndSpace.euclideanCoordinates_measurePreserving.integral_comp
    TimeAndSpace.euclideanCoordinates.toHomeomorph.measurableEmbedding]
  exact φ.integral_normed

/-- Translate a real Schwartz test by `a`, with value `f (x - a)` at `x`. -/
def translateSchwartz (f : 𝓢(TimeAndSpace d, ℂ))
    (a : TimeAndSpace d) : 𝓢(TimeAndSpace d, ℂ) :=
  SchwartzMap.compSubConstCLM ℂ a f

/-- The two-point Schwinger function smeared at `x` and zero with an arbitrary normalized bump.
This follows `SmearedTwoPointFunction` in `OSforGFF`, with the bump supplied independently
of the standard sequence used in the OS1 endpoint condition. -/
def smearedTwoPointFunction (dμ_config : ProbabilityMeasure (FieldConfiguration d))
    (φ : ContDiffBump (0 : EuclideanSpace ℝ (Fin (d + 1)))) (x : TimeAndSpace d) : ℝ :=
  schwingerFunction₂ dμ_config
    (SchwartzMap.postcompCLM Complex.reCLM
      (translateSchwartz (SchwartzMap.postcompCLM Complex.ofRealCLM (bumpToSchwartz φ)) x))
    (bumpToSchwartz φ)

/-- The standard bump sequence from `OSforGFF`, with outer radius `1 / n` for nonzero `n`. -/
def standardBumpSequence (n : ℕ) (hn : n ≠ 0) :
    ContDiffBump (0 : EuclideanSpace ℝ (Fin (d + 1))) where
  rIn := 1 / (2 * n)
  rOut := 1 / n
  rIn_pos := by positivity
  rIn_lt_rOut := by
    have hn' : (0 : ℝ) < n := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hn)
    exact one_div_lt_one_div_of_lt hn' (by linarith)

end GlimmJaffe

module

public import Physlib.CondensedMatter.Crystal.Symmetry.Basic
public import Mathlib.Algebra.Group.Action.Pointwise.Finset
public import Mathlib.Combinatorics.SimpleGraph.Finite

/-!
# Periodic graphs of crystals

A finite set of bonds, repeated in every unit cell, gives the connections of a crystal.

## i. Overview

A crystal is a set of sites with a translation action. Connections between sites, such as the
nearest-neighbor links of a square lattice, give it a graph. Since the crystal is periodic, so is
its graph: translating both ends of a connection preserves adjacency,

`Adj (a +ᵥ x) (a +ᵥ y) ↔ Adj x y`.

It is enough to list the connections once. A finite set of bonds gives a periodic graph, and
conversely every periodic graph in which each site has finitely many neighbors comes from finitely
many bonds.

A symmetry of the crystal need not respect these connections. A quarter turn of a square lattice
with bonds along one axis only carries bonded sites to unbonded ones. A symmetry keeps the graph
when it carries bonded sites to bonded sites. The graph repeats under translations. It is therefore
enough to check the finitely many bonds of the reference cell. A symmetry keeps the graph exactly
when it permutes these bonds.

## ii. Key results

- `PeriodicGraph` : a graph on the sites that is invariant under translation and has finitely
  many neighbors at each site.
- `PeriodicGraph.ofBonds` : the periodic graph generated by a finite set of bonds.
- `PeriodicGraph.eq_ofBonds` : every periodic graph is generated by finitely many bonds.
- `PeriodicGraph.degree_vadd` : every copy of a site has the same number of neighbors.
- `PeriodicGraph.graphAutomorphisms` : the adjacency-preserving permutations of the sites.
- `PeriodicGraph.PreservesBonds` : a crystal symmetry that maps the reference-cell bonds to bonds.
- `PeriodicGraph.preservesBonds_iff_smul_eq` : such a symmetry permutes the set of bonds.
- `PeriodicGraph.PreservesBonds.map_adj` : such a symmetry preserves adjacency.
- `PeriodicGraph.PreservesBonds.inv` : the inverse of such a symmetry has the same property.
- `PeriodicGraph.degree_ofBonds_of_unique` : the degree of a site in a graph generated by bonds,
  for a crystal with one site per cell, is the number of steps.

## iii. Table of contents

- A. Translation-invariant connectivity
- B. Building the graph from bonds
- C. Adjacency depends on cell differences
- D. The periodic graph of a finite set of bonds
- E. Every periodic graph comes from bonds
- F. Graph automorphisms
- G. Symmetries preserving the bonds

## iv. References

* F. Göhmann, *Introduction to Solid State Physics*, lecture L3, Section 3.1, for the standard
  description of a crystal. [ref: goehmann_solid_state_2021]

-/

@[expose] public section

open Pointwise

namespace Physlib.CondensedMatter.Crystal

variable {G : Type*} [AddCommGroup G] [AddGroup.FG G] {C : Crystal G}

/-! ## A. Translation-invariant connectivity -/

/-- A periodic pattern of undirected connections between crystal sites, with finitely many
neighbors at each site. -/
structure PeriodicGraph (C : Crystal G) where
  /-- The undirected connections between crystal sites. -/
  toSimpleGraph : SimpleGraph C.Site
  /-- Translating both sites preserves their connection. -/
  adj_vadd : ∀ (a : G) (x y : C.Site),
    toSimpleGraph.Adj (a +ᵥ x) (a +ᵥ y) ↔ toSimpleGraph.Adj x y
  /-- Each site is connected to only finitely many other sites. -/
  [locallyFinite : toSimpleGraph.LocallyFinite]

attribute [instance] PeriodicGraph.locallyFinite

namespace PeriodicGraph

/-- Periodic graphs are equal when their underlying graphs are. -/
@[ext] lemma ext {g g' : PeriodicGraph C} (h : g.toSimpleGraph = g'.toSimpleGraph) : g = g' := by
  cases g; cases g'
  cases h
  congr
  exact Subsingleton.elim _ _

/-- A translation is an automorphism of the graph. -/
def translateIso (g : PeriodicGraph C) (a : G) : g.toSimpleGraph ≃g g.toSimpleGraph where
  toEquiv := AddAction.toPerm a
  map_rel_iff' := g.adj_vadd a _ _

/-- The degree, the number of neighbors, is the same for all translates of a site. -/
lemma degree_vadd (g : PeriodicGraph C) (a : G) (x : C.Site) :
    g.toSimpleGraph.degree (a +ᵥ x) = g.toSimpleGraph.degree x :=
  SimpleGraph.Embedding.degree_eq_of_neighborSet_subset_range (f := (g.translateIso a).toEmbedding)
    fun y _ => ⟨(-a) +ᵥ y, by simp [translateIso]⟩

/-- The degree of a site depends only on its label. -/
lemma degree_cell (g : PeriodicGraph C) (n : G) (i : C.UnitCell) :
    g.toSimpleGraph.degree ⟨n, i⟩ = g.toSimpleGraph.degree ⟨0, i⟩ := by
  have := g.degree_vadd n (⟨0, i⟩ : C.Site)
  rwa [Site.vadd_def, add_zero] at this

/-! ## B. Building the graph from bonds -/

/-- The undirected graph generated by translating every bond in the set. -/
def graphOfBonds (bonds : Finset (Bond C)) : SimpleGraph C.Site :=
  SimpleGraph.fromRel fun x y => ∃ b ∈ bonds, b.Links x y

/-- Two sites are adjacent when they are different and joined by a bond in either direction. -/
lemma adj_graphOfBonds (bonds : Finset (Bond C)) (x y : C.Site) :
    (graphOfBonds bonds).Adj x y ↔ x ≠ y ∧ ∃ b ∈ bonds, b.Links x y ∨ b.Links y x := by
  simp only [graphOfBonds, SimpleGraph.fromRel_adj, ← exists_or, and_or_left]

/-- Adjacency generated by bonds is unchanged by a common cell translation. -/
@[simp] lemma graphOfBonds_adj_vadd (bonds : Finset (Bond C)) (a : G) (x y : C.Site) :
    (graphOfBonds bonds).Adj (a +ᵥ x) (a +ᵥ y) ↔ (graphOfBonds bonds).Adj x y := by
  simp only [adj_graphOfBonds, Bond.links_vadd, ne_eq, vadd_left_cancel_iff]

/-! ## C. Adjacency depends on cell differences -/

/-- Adjacency depends only on the labels of the sites and the difference of their cells. -/
lemma adj_iff (g : PeriodicGraph C) (x y : C.Site) :
    g.toSimpleGraph.Adj x y ↔
      g.toSimpleGraph.Adj ⟨0, x.label⟩ ⟨y.cell - x.cell, y.label⟩ := by
  rw [← g.adj_vadd (-x.cell)]
  have hx : -x.cell +ᵥ x = ⟨0, x.label⟩ := Site.ext (neg_add_cancel _) rfl
  have hy : -x.cell +ᵥ y = ⟨y.cell - x.cell, y.label⟩ := Site.ext (neg_add_eq_sub _ _) rfl
  rw [hx, hy]

/-! ## D. The periodic graph of a finite set of bonds -/

variable [DecidableEq G] [DecidableEq C.UnitCell]

/-- Connections generated by a finite set of bonds can be decided. -/
instance (bonds : Finset (Bond C)) : DecidableRel (graphOfBonds bonds).Adj := fun x y =>
  decidable_of_iff _ (adj_graphOfBonds bonds x y).symm

/-- The sites reached from `x` by following a bond forwards or backwards. -/
def candidates (bonds : Finset (Bond C)) (x : C.Site) : Finset C.Site :=
  bonds.biUnion fun b => {⟨x.cell + b.displacement, b.target⟩, ⟨x.cell - b.displacement, b.source⟩}

/-- The neighbors of a site in the graph generated by finitely many bonds. -/
def neighborsOfBonds (bonds : Finset (Bond C)) (x : C.Site) : Finset C.Site :=
  (candidates bonds x).filter ((graphOfBonds bonds).Adj x)

/-- The enumerated neighbors are exactly the adjacent sites. -/
lemma mem_neighborsOfBonds (bonds : Finset (Bond C)) (x y : C.Site) :
    y ∈ neighborsOfBonds bonds x ↔ (graphOfBonds bonds).Adj x y := by
  refine ⟨fun h => (Finset.mem_filter.1 h).2, fun h => Finset.mem_filter.2 ⟨?_, h⟩⟩
  obtain ⟨-, b, hb, h | h⟩ := (adj_graphOfBonds bonds x y).1 h
  · exact Finset.mem_biUnion.2 ⟨b, hb, Finset.mem_insert.2 (Or.inl (Site.ext h.2.2 h.2.1))⟩
  · exact Finset.mem_biUnion.2 ⟨b, hb, Finset.mem_insert_of_mem (Finset.mem_singleton.2
      (Site.ext (eq_sub_of_add_eq h.2.2.symm) h.1))⟩

/-- The periodic graph obtained by repeating the given bonds in every cell. -/
def ofBonds (bonds : Finset (Bond C)) : PeriodicGraph C where
  toSimpleGraph := graphOfBonds bonds
  adj_vadd := graphOfBonds_adj_vadd bonds
  locallyFinite x := Fintype.ofFinset (neighborsOfBonds bonds x) (mem_neighborsOfBonds bonds x)

/-- Two sites are adjacent in the graph from bonds when they are joined by one of the bonds. -/
@[simp] lemma adj_ofBonds (bonds : Finset (Bond C)) (x y : C.Site) :
    (ofBonds bonds).toSimpleGraph.Adj x y ↔ x ≠ y ∧ ∃ b ∈ bonds, b.Links x y ∨ b.Links y x :=
  adj_graphOfBonds bonds x y

/-- The nonzero displacements of the bonds, taken forwards and backwards. -/
def steps (bonds : Finset (Bond C)) : Finset G :=
  (bonds.image Bond.displacement ∪ bonds.image fun b => -b.displacement).erase 0

section Unique

variable [Unique C.UnitCell]

omit [DecidableEq G] [DecidableEq C.UnitCell] in
/-- With one site per cell, a bond joins `x` to the sites whose cell is shifted by its
displacement. -/
lemma links_iff_of_unique (b : Bond C) (x y : C.Site) :
    b.Links x y ↔ y.cell = x.cell + b.displacement := by
  simp [Bond.Links, Subsingleton.elim x.label b.source, Subsingleton.elim y.label b.target]

/-- With one site per cell, two sites are adjacent when their cells differ by a step. -/
lemma adj_ofBonds_of_unique (bonds : Finset (Bond C)) (x y : C.Site) :
    (ofBonds bonds).toSimpleGraph.Adj x y ↔ y.cell - x.cell ∈ steps bonds := by
  have key (d : G) : (y.cell = x.cell + d ∨ x.cell = y.cell + d) ↔
      (d = y.cell - x.cell ∨ -d = y.cell - x.cell) := by
    constructor <;> rintro (h | h)
    · exact Or.inl (by rw [h, add_sub_cancel_left])
    · exact Or.inr (by rw [h, sub_add_cancel_left])
    · exact Or.inl (by rw [h]; exact (add_sub_cancel _ _).symm)
    · exact Or.inr (by rw [← neg_neg d, h, ← sub_eq_add_neg, sub_sub_cancel])
  have hne : x ≠ y ↔ y.cell - x.cell ≠ 0 := by
    rw [sub_ne_zero, ne_comm, Ne, Ne, Site.ext_iff]
    simp [Subsingleton.elim x.label y.label]
  simp only [adj_ofBonds, steps, Finset.mem_erase, Finset.mem_union, Finset.mem_image,
    links_iff_of_unique, key, and_or_left, exists_or, hne]

/-- With one site per cell, the degree of a site in the graph generated by bonds is the number of
steps. -/
lemma degree_ofBonds_of_unique (bonds : Finset (Bond C)) (x : C.Site) :
    (ofBonds bonds).toSimpleGraph.degree x = (steps bonds).card := by
  rw [← SimpleGraph.card_neighborFinset_eq_degree]
  exact Finset.card_nbij' (·.cell - x.cell) (fun v => ⟨x.cell + v, default⟩)
    (fun y hy => by simpa only [Finset.mem_coe, SimpleGraph.mem_neighborFinset,
      adj_ofBonds_of_unique] using hy)
    (fun v hv => by simpa only [Finset.mem_coe, SimpleGraph.mem_neighborFinset,
      adj_ofBonds_of_unique, add_sub_cancel_left] using hv)
    (fun y _ => Site.ext (by simp) (Subsingleton.elim _ _)) fun v _ => by simp

end Unique

/-! ## E. Every periodic graph comes from bonds -/

section
variable [Fintype C.UnitCell]

/-- The bonds that join a site of the reference cell to one of its neighbors. -/
def bonds (g : PeriodicGraph C) : Finset (Bond C) :=
  Finset.univ.biUnion fun i => (g.toSimpleGraph.neighborFinset ⟨0, i⟩).image
    fun y => ⟨i, y.label, y.cell⟩

/-- A bond of `g.bonds` joins a site of the reference cell to one of its neighbors. -/
lemma mem_bonds (g : PeriodicGraph C) (b : Bond C) :
    b ∈ g.bonds ↔ g.toSimpleGraph.Adj ⟨0, b.source⟩ ⟨b.displacement, b.target⟩ := by
  simp only [bonds, Finset.mem_biUnion, Finset.mem_univ, Finset.mem_image, true_and,
    SimpleGraph.mem_neighborFinset]
  exact ⟨fun ⟨_, y, hy, h⟩ => h ▸ hy, fun h => ⟨b.source, ⟨b.displacement, b.target⟩, h, rfl⟩⟩

/-- Sites joined by a bond of `g.bonds` are adjacent in `g`. -/
lemma adj_of_links (g : PeriodicGraph C) {b : Bond C} (hb : b ∈ g.bonds) {x y : C.Site}
    (h : b.Links x y) : g.toSimpleGraph.Adj x y := by
  rw [adj_iff, h.1, h.2.1, h.2.2, add_sub_cancel_left]
  exact (g.mem_bonds b).1 hb

/-- Sites joined by a bond are adjacent exactly when the bond is one of `g.bonds`. -/
lemma adj_iff_mem_bonds (g : PeriodicGraph C) {b : Bond C} {x y : C.Site} (h : b.Links x y) :
    g.toSimpleGraph.Adj x y ↔ b ∈ g.bonds := by
  rw [mem_bonds, adj_iff, h.1, h.2.1, h.2.2, add_sub_cancel_left]

/-- Every periodic graph is generated by the finitely many bonds leaving the reference cell. -/
lemma toSimpleGraph_eq_graphOfBonds (g : PeriodicGraph C) :
    g.toSimpleGraph = graphOfBonds g.bonds := by
  ext x y
  rw [adj_graphOfBonds]
  refine ⟨fun h => ⟨h.ne, ⟨x.label, y.label, y.cell - x.cell⟩,
    (g.mem_bonds _).2 ((adj_iff g x y).1 h), Or.inl ⟨rfl, rfl, by simp⟩⟩, ?_⟩
  rintro ⟨-, b, hb, h | h⟩
  exacts [g.adj_of_links hb h, (g.adj_of_links hb h).symm]

/-- Every periodic graph is generated by the finitely many bonds leaving the reference
cell. -/
lemma eq_ofBonds (g : PeriodicGraph C) : g = ofBonds g.bonds :=
  PeriodicGraph.ext g.toSimpleGraph_eq_graphOfBonds

end

/-! ## F. Graph automorphisms -/

/-- The automorphism group of the underlying graph, without requiring crystal symmetry. -/
def graphAutomorphisms (g : PeriodicGraph C) : Subgroup (Equiv.Perm C.Site) where
  carrier := {φ | ∀ x y, g.toSimpleGraph.Adj (φ x) (φ y) ↔ g.toSimpleGraph.Adj x y}
  one_mem' _ _ := Iff.rfl
  mul_mem' hφ hψ x y := (hφ _ _).trans (hψ x y)
  inv_mem' {φ} hφ x y := by simpa using (hφ (φ⁻¹ x) (φ⁻¹ y)).symm

/-! ## G. Symmetries preserving the bonds -/

section PreservesBonds

variable {g : PeriodicGraph C} {φ : Symmetry C} [Fintype C.UnitCell]

/-- A crystal symmetry maps every bond of the reference cell to another such bond. -/
def PreservesBonds (g : PeriodicGraph C) (φ : Symmetry C) : Prop :=
  ∀ b ∈ g.bonds, φ • b ∈ g.bonds

/-- A symmetry preserves the bonds exactly when it permutes the set of reference-cell bonds. -/
lemma preservesBonds_iff_smul_eq : g.PreservesBonds φ ↔ φ • g.bonds = g.bonds := by
  constructor
  · intro h
    refine Finset.eq_of_subset_of_card_le ?_ (by rw [Finset.card_smul_finset])
    intro b hb
    obtain ⟨c, hc, rfl⟩ := Finset.mem_smul_finset.1 hb
    exact h c hc
  · intro h b hb
    rw [← h]
    exact Finset.smul_mem_smul_finset hb

/-- Preserving the reference-cell bonds implies preserving adjacency in the forward direction. -/
lemma PreservesBonds.map_adj (h : g.PreservesBonds φ) {x y : C.Site}
    (hxy : g.toSimpleGraph.Adj x y) : g.toSimpleGraph.Adj (φ x) (φ y) := by
  have hl : (⟨x.label, y.label, y.cell - x.cell⟩ : Bond C).Links x y :=
    ⟨rfl, rfl, (add_sub_cancel _ _).symm⟩
  exact g.adj_of_links (h _ (g.adj_iff_mem_bonds hl |>.1 hxy)) (φ.mapBond_links hl)

/-- The inverse of a symmetry that preserves the bonds preserves them as well. -/
lemma PreservesBonds.inv (h : g.PreservesBonds φ) : g.PreservesBonds φ⁻¹ :=
  preservesBonds_iff_smul_eq.2 (inv_smul_eq_iff.2 (preservesBonds_iff_smul_eq.1 h).symm)

end PreservesBonds

end PeriodicGraph

end Physlib.CondensedMatter.Crystal

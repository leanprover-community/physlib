module

public import Physlib.CondensedMatter.Crystal.Bonds
public import Mathlib.Combinatorics.SimpleGraph.Finite

/-!
# Periodic graphs of crystals

A finite set of bonds, repeated in every unit cell, gives the connections of a crystal.

## i. Overview

A crystal is a set of sites with a translation action. Connections between sites, such as the
nearest-neighbor links of a square lattice, give it a graph. Since the crystal is periodic, it is
enough to list the connections once. A bond records the connection from a site of the reference
cell to a neighbor.

A periodic graph is such a list of bonds. Every connection can be read in both directions, so the
list contains the reverse of each of its bonds. It contains no bond from a site to itself. The
graph on the sites is built from the list: two sites are connected when a bond links them.
Translating both sites preserves the connection, and each site has finitely many neighbors.

A symmetry of the crystal need not respect these connections. A quarter turn of a square lattice
with bonds along one axis only carries bonded sites to unbonded ones. A symmetry keeps the graph
exactly when it permutes the bonds. This is why the bonds are the primary data.

## ii. Key results

- `PeriodicGraph` : a finite set of bonds, closed under reversal and without trivial bonds.
- `PeriodicGraph.toSimpleGraph` : the graph on the sites that the bonds generate.
- `PeriodicGraph.adj_iff_mem_bonds` : sites linked by a bond are adjacent exactly when the bond is
  one of the graph.
- `PeriodicGraph.degree_vadd` : every copy of a site has the same number of neighbors.
- `PeriodicGraph.ofBonds` : the periodic graph generated by any finite set of bonds.

## iii. Table of contents

- A. Periodic graphs
- B. The graph on the sites
- C. Adjacency and bonds
- D. Periodic graphs from arbitrary bonds

## iv. References

* F. Göhmann, *Introduction to Solid State Physics*, lecture L3, Section 3.1, for the standard
  description of a crystal. [ref: goehmann_solid_state_2021]

-/

@[expose] public section

namespace Physlib.CondensedMatter.Crystal

variable {G : Type*} [AddCommGroup G] [AddGroup.FG G] {C : Crystal G}

/-! ## A. Periodic graphs -/

/-- A periodic pattern of connections between crystal sites: the finitely many bonds that leave the
reference cell. -/
structure PeriodicGraph (C : Crystal G) where
  /-- The bonds that leave the reference cell. -/
  bonds : Finset (Bond C)
  /-- Every connection can be read in both directions. -/
  reverse_mem : ∀ b ∈ bonds, b.reverse ∈ bonds
  /-- No site is connected to itself. -/
  not_isLoop : ∀ b ∈ bonds, ¬ b.IsLoop

namespace PeriodicGraph

/-- Periodic graphs are equal when their bonds are. -/
@[ext] lemma ext {g g' : PeriodicGraph C} (h : g.bonds = g'.bonds) : g = g' := by
  cases g
  cases g'
  cases h
  rfl

/-! ## B. The graph on the sites -/

/-- The graph on the sites in which two sites are adjacent when a bond links them. -/
def toSimpleGraph (g : PeriodicGraph C) : SimpleGraph C.Site where
  Adj x y := ∃ b ∈ g.bonds, b.Links x y
  symm := ⟨by
    rintro x y ⟨b, hb, h⟩
    exact ⟨b.reverse, g.reverse_mem b hb, Bond.links_reverse.2 h⟩⟩
  loopless := ⟨by
    rintro x ⟨b, hb, h⟩
    exact g.not_isLoop b hb (Bond.isLoop_of_links h)⟩

/-- Two sites are adjacent when a bond of the graph links them. -/
lemma adj_def (g : PeriodicGraph C) (x y : C.Site) :
    g.toSimpleGraph.Adj x y ↔ ∃ b ∈ g.bonds, b.Links x y := Iff.rfl

/-- Translating both sites preserves their connection. -/
lemma adj_vadd (g : PeriodicGraph C) (a : G) (x y : C.Site) :
    g.toSimpleGraph.Adj (a +ᵥ x) (a +ᵥ y) ↔ g.toSimpleGraph.Adj x y := by
  simp only [adj_def, Bond.links_vadd]

/-- Each site is connected to finitely many other sites. -/
noncomputable instance (g : PeriodicGraph C) : g.toSimpleGraph.LocallyFinite := fun x =>
  ((g.bonds.finite_toSet.image fun b => (⟨x.cell + b.displacement, b.target⟩ : C.Site)).subset
    (by
      rintro y ⟨b, hb, hx, hy, hc⟩
      exact ⟨b, hb, Site.ext hc.symm hy.symm⟩)).fintype

/-- A translation is an automorphism of the graph. -/
def translateIso (g : PeriodicGraph C) (a : G) : g.toSimpleGraph ≃g g.toSimpleGraph where
  toEquiv := AddAction.toPerm a
  map_rel_iff' := g.adj_vadd a _ _

/-- The degree, the number of neighbors, is the same for all translates of a site. -/
lemma degree_vadd (g : PeriodicGraph C) (a : G) (x : C.Site) :
    g.toSimpleGraph.degree (a +ᵥ x) = g.toSimpleGraph.degree x :=
  SimpleGraph.Embedding.degree_eq_of_neighborSet_subset_range (f := (g.translateIso a).toEmbedding)
    fun y _ => ⟨(-a) +ᵥ y, by simp [translateIso]⟩

/-- The degree of a site depends only on its label. -/
lemma degree_cell (g : PeriodicGraph C) (n : G) (i : C.UnitCell) :
    g.toSimpleGraph.degree ⟨n, i⟩ = g.toSimpleGraph.degree (Site.ref i) := by
  have := g.degree_vadd n (Site.ref i)
  rwa [Site.vadd_def, add_zero] at this

/-! ## C. Adjacency and bonds -/

/-- Sites linked by a bond are adjacent exactly when the bond is one of the graph. -/
lemma adj_iff_mem_bonds (g : PeriodicGraph C) {b : Bond C} {x y : C.Site} (h : b.Links x y) :
    g.toSimpleGraph.Adj x y ↔ b ∈ g.bonds := by
  refine ⟨?_, fun hb => ⟨b, hb, h⟩⟩
  rintro ⟨b', hb', h'⟩
  rwa [Bond.eq_of_links h h']

/-- A bond belongs to the graph exactly when it joins a site of the reference cell to one of its
neighbors. -/
lemma mem_bonds_iff (g : PeriodicGraph C) (b : Bond C) :
    b ∈ g.bonds ↔ g.toSimpleGraph.Adj (Site.ref b.source) ⟨b.displacement, b.target⟩ :=
  (g.adj_iff_mem_bonds b.links_reference).symm

/-! ## D. Periodic graphs from arbitrary bonds -/

section OfBonds

variable [DecidableEq G] [DecidableEq C.UnitCell]

/-- The periodic graph generated by any finite set of bonds: add the reverse of each bond and drop
the trivial bonds. -/
def ofBonds (bonds : Finset (Bond C)) : PeriodicGraph C where
  bonds := (bonds ∪ bonds.image Bond.reverse).filter fun b => ¬ b.IsLoop
  reverse_mem b hb := by
    simp only [Finset.mem_filter, Finset.mem_union, Finset.mem_image, Bond.isLoop_reverse] at hb ⊢
    obtain ⟨hb | ⟨c, hc, rfl⟩, h⟩ := hb
    · exact ⟨Or.inr ⟨b, hb, rfl⟩, by simpa using h⟩
    · exact ⟨Or.inl (by simpa using hc), by simpa using h⟩
  not_isLoop _ hb := (Finset.mem_filter.1 hb).2

/-- A bond belongs to the generated graph when it or its reverse is one of the bonds and it is not
trivial. -/
lemma mem_bonds_ofBonds (bonds : Finset (Bond C)) (b : Bond C) :
    b ∈ (ofBonds bonds).bonds ↔ ¬ b.IsLoop ∧ (b ∈ bonds ∨ b.reverse ∈ bonds) := by
  simp only [ofBonds, Finset.mem_filter, Finset.mem_union, Finset.mem_image]
  grind [Bond.reverse_reverse]

/-- Two sites are adjacent in the graph from bonds when they are different and joined by one of the
bonds in either direction. -/
lemma adj_ofBonds (bonds : Finset (Bond C)) (x y : C.Site) :
    (ofBonds bonds).toSimpleGraph.Adj x y ↔ x ≠ y ∧ ∃ b ∈ bonds, b.Links x y ∨ b.Links y x := by
  simp only [adj_def, mem_bonds_ofBonds]
  constructor
  · rintro ⟨b, ⟨hl, hb | hb⟩, h⟩
    · exact ⟨fun hxy => hl (Bond.isLoop_of_links (hxy ▸ h)), b, hb, Or.inl h⟩
    · exact ⟨fun hxy => hl (Bond.isLoop_of_links (hxy ▸ h)), _, hb, Or.inr (Bond.links_reverse.2 h)⟩
  · rintro ⟨hxy, b, hb, h | h⟩
    · exact ⟨b, ⟨fun hl => hxy (Bond.eq_of_isLoop_links hl h), Or.inl hb⟩, h⟩
    · refine ⟨b.reverse, ⟨fun hl => hxy ?_, Or.inr (by simpa using hb)⟩, Bond.links_reverse.2 h⟩
      exact (Bond.eq_of_isLoop_links ((Bond.isLoop_reverse b).1 hl) h).symm

end OfBonds

end PeriodicGraph

end Physlib.CondensedMatter.Crystal

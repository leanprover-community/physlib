module

public import Physlib.CondensedMatter.Crystal.Embedding
public import Physlib.CondensedMatter.Crystal.PeriodicGraph

/-!
# Bond lengths

The length of a bond is the same in every cell.

## i. Overview

In an embedded crystal, a bond joins two sites whose positions differ by a vector that does not
depend on the cell. So all the edges generated by one bond have the same length, and a periodic
graph generated by bonds of equal length has all its edges of that length.

## ii. Key results

- `Crystal.Embedding.bondVector` : the vector from the source to the target of a bond.
- `Crystal.Embedding.dist_position_of_links` : the distance between the sites joined by a bond is
  the norm of its bond vector.
- `Crystal.Embedding.dist_position_of_adj` : all the edges of a graph generated by bonds of equal
  length have that length.

## iii. Table of contents

- A. Bond lengths

## iv. References

* N. Ashcroft & N. D. Mermin, Solid State Physics, Chapter 4.

-/

@[expose] public section

namespace Physlib.CondensedMatter.Crystal

/-! ## A. Bond lengths -/

namespace Embedding

variable {G : Type*} [AddCommGroup G] [AddGroup.FG G] {C : Crystal G}
  {E : Type*} [NormedAddCommGroup E] (R : Embedding C E)

/-- The vector from the position of the source of a bond to the position of its target. It does
not depend on the cell of the source. -/
def bondVector (b : Bond C) : E := R.vector b.displacement + R.basis b.target - R.basis b.source

/-- The distance between the two sites joined by a bond is the norm of its bond vector. -/
lemma dist_position_of_links {b : Bond C} {x y : C.Site} (h : b.Links x y) :
    Dist.dist (R.position x) (R.position y) = ‖R.bondVector b‖ := by
  obtain ⟨hx, hy, hc⟩ := h
  rw [dist_eq_norm, norm_sub_rev]
  congr 1
  simp only [position, bondVector, hc, hx, hy, map_add]
  abel

/-- If every bond in a finite set has length `ℓ`, every edge of the graph they generate has
length `ℓ`. -/
lemma dist_position_of_adj [DecidableEq G] [DecidableEq C.UnitCell] (bonds : Finset (Bond C))
    {ℓ : ℝ} (hℓ : ∀ b ∈ bonds, ‖R.bondVector b‖ = ℓ) {x y : C.Site}
    (hadj : (PeriodicGraph.ofBonds bonds).toSimpleGraph.Adj x y) :
    Dist.dist (R.position x) (R.position y) = ℓ := by
  obtain ⟨-, b, hb, h | h⟩ := (PeriodicGraph.adj_ofBonds bonds x y).1 hadj
  · exact (R.dist_position_of_links h).trans (hℓ b hb)
  · rw [dist_comm]
    exact (R.dist_position_of_links h).trans (hℓ b hb)

end Embedding


end Physlib.CondensedMatter.Crystal

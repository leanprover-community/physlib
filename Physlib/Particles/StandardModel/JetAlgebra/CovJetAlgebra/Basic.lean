    Set.mem_iUnion_of_mem l <| Or.inl <| Or.inl <| Or.inl <| Or.inl <| Or.inl <| Or.inl <|
      Or.inl <| Or.inr <| ⟨φ, rfl⟩

/-- The conjugate up-type quark tower lies in the covariant subalgebra. -/
lemma covDerivBarU_mem_covAlgebra (i : Fin 3) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))

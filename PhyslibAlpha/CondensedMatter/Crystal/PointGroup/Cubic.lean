module

public import PhyslibAlpha.CondensedMatter.Crystal.PointGroup.Count
public import PhyslibAlpha.CondensedMatter.Crystal.Examples.ThreeDimensional

/-!

# The point groups of the face-centred and body-centred cubic lattices

The point group of both cubic Bravais lattices with centring has order forty-eight.

## i. Overview

By `PeriodicGraph.card_pointGroup`, the order of the point group of a Bravais lattice is the
number of triples of neighbour displacements that define a lattice automorphism preserving the
neighbours. For the face-centred cubic lattice, with its twelve neighbours, and the body-centred
cubic lattice, with its eight neighbours, this number is `48`, the order of the full octahedral
group, the symmetry group of the cube with reflections.

## ii. Key results

- `fcc_card_pointGroup` : the point group of the face-centred cubic lattice has order `48`.
- `bcc_card_pointGroup` : the point group of the body-centred cubic lattice has order `48`.

## iii. Table of contents

- A. Neighbour displacements
- B. Computing the count
- C. The cubic lattices

## iv. References

* N. Ashcroft & N. D. Mermin, Solid State Physics, Chapter 7.

-/

@[expose] public section

namespace CondensedMatter.Crystal

namespace PeriodicGraph

/-! ## A. Neighbour displacements -/

/-! ## B. Computing the count -/

variable {n : ℕ}

/-- The neighbour displacements of a bond list on a one-site cell: the bond displacements and
their negatives, without zero. -/
def bondNeighbors (bonds : List (Bond (Fin n → ℤ) Unit)) : Finset (Fin n → ℤ) :=
  ((bonds.map Bond.displacement ++ bonds.map fun b => -b.displacement).toFinset).erase 0

lemma mem_bondNeighbors (bonds : List (Bond (Fin n → ℤ) Unit)) (d : Fin n → ℤ) :
    d ∈ bondNeighbors bonds ↔ d ≠ 0 ∧ ∃ b ∈ bonds, d = b.displacement ∨ d = -b.displacement := by
  simp only [bondNeighbors, Finset.mem_erase, List.mem_toFinset, List.mem_append, List.mem_map]
  constructor
  · rintro ⟨h0, ⟨b, hb, rfl⟩ | ⟨b, hb, rfl⟩⟩
    · exact ⟨h0, b, hb, Or.inl rfl⟩
    · exact ⟨h0, b, hb, Or.inr rfl⟩
  · rintro ⟨h0, b, hb, rfl | rfl⟩
    · exact ⟨h0, Or.inl ⟨b, hb, rfl⟩⟩
    · exact ⟨h0, Or.inr ⟨b, hb, rfl⟩⟩

/-- The bonded displacements of a graph generated by bonds on a one-site cell. -/
lemma bonded_ofBonds_unit (bonds : List (Bond (Fin n → ℤ) Unit)) (d : Fin n → ℤ) :
    (PeriodicGraph.ofBonds bonds).Bonded () () d ↔ d ∈ bondNeighbors bonds := by
  rw [mem_bondNeighbors]
  change (⟨0, ()⟩ ≠ (⟨d, ()⟩ : CellSite (Fin n → ℤ) Unit) ∧ ∃ b ∈ bonds,
    b.Links ⟨0, ()⟩ ⟨d, ()⟩ ∨ b.Links ⟨d, ()⟩ ⟨0, ()⟩) ↔ _
  simp only [Bond.Links, true_and, ne_eq, CellSite.mk.injEq, and_true, zero_add]
  refine and_congr ⟨fun h h0 => h h0.symm, fun h h0 => h h0.symm⟩ ?_
  refine exists_congr fun b => and_congr_right fun _ => or_congr Iff.rfl ?_
  rw [eq_neg_iff_add_eq_zero, eq_comm]

/-- The admissible triples can be counted among triples of neighbour displacements. -/
def admissibleEquiv (N : Finset (Fin n → ℤ)) :
    {v // Admissible N v} ≃ {w : Fin n → ↥N // Admissible N (fun j => (w j : Fin n → ℤ))} where
  toFun v := ⟨fun j => ⟨v.1 j, v.2.mem j⟩, v.2⟩
  invFun w := ⟨fun j => (w.1 j : Fin n → ℤ), w.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

instance (N : Finset (Fin n → ℤ)) (v : Fin n → Fin n → ℤ) : Decidable (Admissible N v) :=
  decidable_of_iff ((∀ j, v j ∈ N) ∧ (∀ d ∈ N, act v d ∈ N) ∧
      ∀ d ∈ N, ∀ d' ∈ N, act v d = act v d' → d = d')
    ⟨fun ⟨h1, h2, h3⟩ => ⟨h1, h2, fun d hd d' hd' h => h3 d hd d' hd' h⟩,
      fun ⟨h1, h2, h3⟩ => ⟨h1, h2, fun _d hd _d' hd' h => h3 hd hd' h⟩⟩


end PeriodicGraph

/-! ## C. The cubic lattices -/

/-- **The point group of the face-centred cubic lattice has order `48`.** -/
lemma fcc_card_pointGroup : Nat.card fccGraph.pointGroup = 48 := by
  refine (PeriodicGraph.card_pointGroup (N := PeriodicGraph.bondNeighbors fccBonds) ?_
    (PeriodicGraph.bonded_ofBonds_unit fccBonds)).trans ?_
  · intro j
    fin_cases j <;> decide
  · rw [Nat.card_congr (PeriodicGraph.admissibleEquiv _), Nat.card_eq_fintype_card]
    decide +kernel

/-- **The point group of the body-centred cubic lattice has order `48`.** -/
lemma bcc_card_pointGroup : Nat.card bccGraph.pointGroup = 48 := by
  refine (PeriodicGraph.card_pointGroup (N := PeriodicGraph.bondNeighbors bccBonds) ?_
    (PeriodicGraph.bonded_ofBonds_unit bccBonds)).trans ?_
  · intro j
    fin_cases j <;> decide
  · rw [Nat.card_congr (PeriodicGraph.admissibleEquiv _), Nat.card_eq_fintype_card]
    decide +kernel

end CondensedMatter.Crystal

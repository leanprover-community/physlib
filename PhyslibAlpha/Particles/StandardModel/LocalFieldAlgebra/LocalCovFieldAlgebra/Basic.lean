/-!

## E. The statistics of the towers

The field-strength tower and the two Higgs towers are central; any two fermion towers
anticommute, by `GaugeFieldData.LocalCovFieldAlgebra.covFermion_anticomm_covFermion` and its
companions.

-/

/-- The field-strength tower is central in the covariant field algebra of the Standard Model. -/
lemma fieldStrength_commute {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3)) (μ ν : Fin 1 ⊕ Fin 3)
    (ψ : Module.Dual ℝ globalGaugeGroup.lieSubalgebra) (x : fieldData.LocalCovFieldAlgebra) :
    Commute (fieldStrength l μ ν ψ) x :=
  GaugeFieldData.LocalCovFieldAlgebra.commute_covFieldStrength (List.ofFn l) μ ν ψ x

/-- The Higgs tower is central in the covariant field algebra of the Standard Model. -/
lemma higgsField_commute {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ HiggsVec)
    (x : fieldData.LocalCovFieldAlgebra) : Commute (higgsField l φ) x := by
  -- elaborated apart from the goal: against the goal the unifier times out matching
  -- `Module.Dual ℂ HiggsVec` with `Module.Dual ℂ (fieldData.BosonValue ())`
  have h := GaugeFieldData.LocalCovFieldAlgebra.commute_covBoson (T := fieldData) () l φ x
  exact h

/-- The conjugate Higgs tower is central in the covariant field algebra of the Standard Model. -/
lemma conjHiggsField_commute {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
    (φ : Module.Dual ℂ (ConjModule HiggsVec)) (x : fieldData.LocalCovFieldAlgebra) :
    Commute (conjHiggsField l φ) x := by
  have h := GaugeFieldData.LocalCovFieldAlgebra.commute_covConjBoson (T := fieldData) () l φ x
  exact h

/-!

## F. The mass-weight polynomial

The mass-weight polynomial of the jet algebra makes every covariant generator an eigenvector.
The gauge-field symbols have weight `2 * (1 + |p|)`, the fermion symbols `3 + 2 |s|` and the
Higgs symbols `2 + 2 |s|`, so the generic lemmas `GaugeFieldData.massWeight_covDerivFieldStrength`,
`GaugeFieldData.massWeight_covDerivFermion` and their companions give the weights of the
towers. It therefore restricts to the covariant field algebra of the Standard Model.

-/

/-- Every covariant generator is a mass-weight eigenvector. -/
lemma exists_massWeightPoly_eq_monomial_of_mem_covGenerators {b : fieldData.LocalFieldAlgebra}
    (hb : b ∈ fieldData.covGenerators) :
    ∃ w : ℕ, fieldData.massWeightPoly b = Polynomial.monomial w b :=
  GaugeFieldData.LocalCovFieldAlgebra.covGenerators_cases
    (P := fun b => ∃ w : ℕ, fieldData.massWeightPoly b = Polynomial.monomial w b) hb
    (fun l μ ν φ => ⟨_, GaugeFieldData.massWeight_covDerivFieldStrength
      fieldData.massWeightPoly (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData))
      l μ ν φ⟩)
    (fun i {_n} l φ => ⟨_, GaugeFieldData.massWeight_covDerivFermion
      fieldData.massWeightPoly
      (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) i 3
      (massWeightPoly_fieldData_fermionSymbol i) l φ⟩)
    (fun i {_n} l φ => ⟨_, GaugeFieldData.massWeight_covDerivConjFermion
      fieldData.massWeightPoly
      (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) i 3
      (massWeightPoly_fieldData_conjFermionSymbol i) l φ⟩)
    (fun j {_n} l φ => ⟨_, GaugeFieldData.massWeight_covDerivBoson
      fieldData.massWeightPoly
      (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) j 2
      (massWeightPoly_fieldData_bosonSymbol j) l φ⟩)
    (fun j {_n} l φ => ⟨_, GaugeFieldData.massWeight_covDerivConjBoson
      fieldData.massWeightPoly
      (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) j 2
      (massWeightPoly_fieldData_conjBosonSymbol j) l φ⟩)

/-- The mass-weight polynomial of the jet algebra carries the covariant field algebra of the
  Standard Model into the polynomials with coefficients in it. -/
lemma jetMassWeightPoly_mem_polyRange (x : fieldData.LocalCovFieldAlgebra) :
    fieldData.massWeightPoly (x : fieldData.LocalFieldAlgebra)
      ∈ Subalgebra.polyRange (R := ℂ) (A := fieldData.LocalFieldAlgebra)
        fieldData.LocalCovFieldAlgebra := by
  have h := GaugeFieldData.LocalCovFieldAlgebra.map_mem_polyRange
    fieldData.massWeightPoly
    (fun _ hb => exists_massWeightPoly_eq_monomial_of_mem_covGenerators hb) x
  exact h

/-- The mass-weight polynomial of the covariant field algebra of the Standard Model, that of
  the jet algebra restricted. -/
noncomputable abbrev massWeightPoly :
    fieldData.LocalCovFieldAlgebra →ₐ[ℂ] Polynomial fieldData.LocalCovFieldAlgebra :=
  Subalgebra.polyRestrict (R := ℂ) (A := fieldData.LocalFieldAlgebra)
    fieldData.LocalCovFieldAlgebra fieldData.massWeightPoly
    jetMassWeightPoly_mem_polyRange

/-- The mass-weight polynomial of the covariant field algebra of the Standard Model, pushed
  back into the jet algebra, is that of the jet algebra. -/
lemma mapAlgHom_massWeightPoly (x : fieldData.LocalCovFieldAlgebra) :
    Polynomial.mapAlgHom fieldData.LocalCovFieldAlgebra.val (massWeightPoly x)
      = fieldData.massWeightPoly (x : fieldData.LocalFieldAlgebra) :=
  Subalgebra.mapAlgHom_polyRestrict _ x

/-- A mass-weight eigenvalue equation in the covariant field algebra of the Standard Model is the
  one in the jet algebra. -/
lemma massWeightPoly_eq_monomial_iff {n : ℕ} (x : fieldData.LocalCovFieldAlgebra) :
    massWeightPoly x = Polynomial.monomial n x
      ↔ fieldData.massWeightPoly (x : fieldData.LocalFieldAlgebra)
        = Polynomial.monomial n (x : fieldData.LocalFieldAlgebra) :=
  Subalgebra.polyRestrict_eq_monomial_iff _ x

/-- A mass-weight eigenvalue equation of the jet algebra, for an element of the covariant field
  algebra of the Standard Model, is a mass-weight eigenvalue equation there. -/
lemma massWeightPoly_eq_monomial {n : ℕ} {x : fieldData.LocalCovFieldAlgebra}
    (hx : fieldData.massWeightPoly (x : fieldData.LocalFieldAlgebra)
      = Polynomial.monomial n (x : fieldData.LocalFieldAlgebra)) :
    massWeightPoly x = Polynomial.monomial n x :=
  (massWeightPoly_eq_monomial_iff x).mpr hx

/-!

### F.1. The mass weights of the towers

-/

/-- The mass weight of the field-strength tower is `2 * (2 + n)`, that is mass dimension
  `2 + n`. -/
lemma massWeightPoly_fieldStrength {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3)) (μ ν : Fin 1 ⊕ Fin 3)
    (φ : Module.Dual ℝ globalGaugeGroup.lieSubalgebra) :
    massWeightPoly (fieldStrength l μ ν φ)
      = Polynomial.monomial (2 * (2 + n)) (fieldStrength l μ ν φ) := by
  refine massWeightPoly_eq_monomial ?_
  have h := GaugeFieldData.massWeight_covDerivFieldStrength fieldData.massWeightPoly
    (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) (List.ofFn l) μ ν φ
  rw [List.length_ofFn, show 4 + 2 * n = 2 * (2 + n) by ring] at h
  exact h

/-- The mass weight of the Higgs tower is `2 * (1 + n)`. -/
lemma massWeightPoly_higgsField {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
    (φ : Module.Dual ℂ HiggsVec) :
    massWeightPoly (higgsField l φ) = Polynomial.monomial (2 * (1 + n)) (higgsField l φ) := by
  refine massWeightPoly_eq_monomial ?_
  have h := GaugeFieldData.massWeight_covDerivBoson fieldData.massWeightPoly
    (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) () 2
    (massWeightPoly_fieldData_bosonSymbol ()) l φ
  rw [show 2 + 2 * n = 2 * (1 + n) by ring] at h
  exact h

/-- The mass weight of the conjugate Higgs tower is `2 * (1 + n)`. -/
lemma massWeightPoly_conjHiggsField {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
    (φ : Module.Dual ℂ (ConjModule HiggsVec)) :
    massWeightPoly (conjHiggsField l φ)
      = Polynomial.monomial (2 * (1 + n)) (conjHiggsField l φ) := by
  refine massWeightPoly_eq_monomial ?_
  have h := GaugeFieldData.massWeight_covDerivConjBoson fieldData.massWeightPoly
    (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) () 2
    (massWeightPoly_fieldData_conjBosonSymbol ()) l φ
  rw [show 2 + 2 * n = 2 * (1 + n) by ring] at h
  exact h

/-- The mass weight of the tower of every fermion species is `3 + 2 * n`. -/
lemma massWeightPoly_covFermion (t : FermionType) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
    (φ : Module.Dual ℂ (fieldData.FermionValue t)) :
    massWeightPoly (GaugeFieldData.LocalCovFieldAlgebra.covFermion fieldData t l φ)
      = Polynomial.monomial (3 + 2 * n)
          (GaugeFieldData.LocalCovFieldAlgebra.covFermion fieldData t l φ) :=
  massWeightPoly_eq_monomial (GaugeFieldData.massWeight_covDerivFermion
    fieldData.massWeightPoly
    (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) t 3
    (massWeightPoly_fieldData_fermionSymbol t) l φ)

/-- The mass weight of the conjugate tower of every fermion species is `3 + 2 * n`. -/
lemma massWeightPoly_covConjFermion (t : FermionType) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
    (φ : Module.Dual ℂ (ConjModule (fieldData.FermionValue t))) :
    massWeightPoly (GaugeFieldData.LocalCovFieldAlgebra.covConjFermion fieldData t l φ)
      = Polynomial.monomial (3 + 2 * n)
          (GaugeFieldData.LocalCovFieldAlgebra.covConjFermion fieldData t l φ) :=
  massWeightPoly_eq_monomial (GaugeFieldData.massWeight_covDerivConjFermion
    fieldData.massWeightPoly
    (GaugeFieldData.massWeightPoly_gaugeField (T := fieldData)) t 3
    (massWeightPoly_fieldData_conjFermionSymbol t) l φ)

/-- The mass weight of the down-type quark singlet tower is `3 + 2 * n`. -/
lemma massWeightPoly_downSingletField (i : Fin 3) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))

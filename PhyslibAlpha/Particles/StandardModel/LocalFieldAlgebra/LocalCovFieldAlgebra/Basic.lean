/-- The conjugate lepton doublet tower is equivariant for the global gauge group. -/
lemma repGaugeGroupI_conjLeptonDoubletField (g : GaugeGroupI) (i : Fin 3) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (ConjModule LeptonDoubletV)) :
    repGaugeGroupI g (conjLeptonDoubletField i l φ)
      = conjLeptonDoubletField i l (LeptonDoubletV.repGaugeGroupI.conj.dual g φ) := by
  have h := GaugeFieldData.LocalCovFieldAlgebra.repValue_covConjFermion_eq_dual (T := fieldData)
    gaugeGroupEquiv.toMonoidHom (.leptonDoublet i) (ρ := LeptonDoubletV.repGaugeGroupI)
    LeptonDoubletV.matterField_rep_gaugeGroupEquiv g l φ
  exact (repGaugeGroupI_apply g _).trans h


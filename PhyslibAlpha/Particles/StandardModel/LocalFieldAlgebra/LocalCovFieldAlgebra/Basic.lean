lemma repGaugeGroupI_conjDownSingletField (g : GaugeGroupI) (i : Fin 3) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (ConjModule DownSinglet)) :
    repGaugeGroupI g (conjDownSingletField i l φ)
      = conjDownSingletField i l (DownSinglet.repGaugeGroupI.conj.dual g φ) := by

    repGaugeGroupI g (leptonSingletField i l φ)
      = leptonSingletField i l (LeptonSinglet.repGaugeGroupI.dual g φ) := by
  have h := GaugeFieldData.LocalCovFieldAlgebra.repValue_covFermion_eq_dual (T := fieldData)
    gaugeGroupEquiv.toMonoidHom (.leptonSinglet i) (ρ := LeptonSinglet.repGaugeGroupI)
    LeptonSinglet.matterField_rep_gaugeGroupEquiv g l φ

    IsLorentzCovDerivTransforms repLorentzGroup
      (Representation.trivial ℂ SL(2,ℂ) HiggsVec) (fun {_n} l => higgsField l) :=
  GaugeFieldData.LocalCovFieldAlgebra.isLorentzCovDerivTransforms_covBoson
    fieldData_gaugeLorentzCompatible ()
    (MonoidHom.ext fun Λ => HiggsVec.matterField_repLorentz_eq Λ)


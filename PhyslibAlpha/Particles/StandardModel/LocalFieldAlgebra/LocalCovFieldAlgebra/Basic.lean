/-- The lepton doublet tower is equivariant for the global gauge group. -/
lemma repGaugeGroupI_leptonDoubletField (g : GaugeGroupI) (i : Fin 3) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ LeptonDoubletV) :

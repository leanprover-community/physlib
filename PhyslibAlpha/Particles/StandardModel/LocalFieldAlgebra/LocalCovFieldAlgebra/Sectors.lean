module

public import PhyslibAlpha.Particles.StandardModel.LocalFieldAlgebra.LocalCovFieldAlgebra.MassWeight
/-!
# The one-kind sectors of the Standard Model

The pure gauge, Higgs and fermion sectors of the Standard Model as its three sector algebras.

## i. Overview

The sectors of the covariant field algebra of the Standard Model are the generic sectors
`fieldData.sector A` of its field datum, and their weight pieces are
`fieldData.sectorMassWeight A w`. The Higgs is the only bosonic species, so the scalar kind is
the Higgs kind.

The Standard Model sector files work with three algebras: `GaugeSector.gaugeAlgebra`, generated
by the field-strength towers, `ScalarSector.higgsAlgebra`, generated by the Higgs towers, and
`FermionSector.fermionAlgebra`, generated by the fermion towers. Each is generated by covariant
generators of one kind, and contains all of them. So at a non-zero weight `w` the weight-`w`
piece of the sector of that kind is the weight-`w` piece of the algebra. At weight zero the
algebras also contain the constants, which the generic decomposition files under the sector
of `∅`.

## ii. Key results

- `sectorMassWeight_gauge_eq`, `sectorMassWeight_higgs_eq`, `sectorMassWeight_fermion_eq` : at
  a non-zero weight the one-kind sectors are the weight pieces of the three sector algebras.

## iii. Table of contents

- A. The field-strength tower at a functional on the Lie algebra
- B. The sector algebras and the generators of their kind
- C. The one-kind sectors are the sector algebras

## iv. References

* None.

-/

@[expose] public section

namespace StandardModel

open MatrixGroups
open GaugeFieldData (FieldKind)

namespace LocalCovFieldAlgebra

/-!

## A. The field-strength tower at a functional on the Lie algebra

-/

/-- The tower `covF`, indexed by functionals on `GaugeAlgebra`, at the transport of a
  functional on the Lie algebra of the global gauge group, is the tower `fieldStrength`,
  indexed by functionals on that Lie algebra. -/
lemma covF_comp_gaugeAlgebraEquiv {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
    (μ ν : Fin 1 ⊕ Fin 3) (φ : Module.Dual ℝ globalGaugeGroup.lieSubalgebra) :
    LocalCovFieldAlgebra.covF l μ ν
        (φ ∘ₗ (gaugeAlgebraEquiv : GaugeAlgebra →ₗ[ℝ] globalGaugeGroup.lieSubalgebra))
      = fieldStrength l μ ν φ := by
  show fieldStrength l μ ν (gaugeDualToLie
    (φ ∘ₗ (gaugeAlgebraEquiv : GaugeAlgebra →ₗ[ℝ] globalGaugeGroup.lieSubalgebra))) = _
  congr 1
  exact LinearMap.ext fun x => congrArg φ (gaugeAlgebraEquiv.apply_symm_apply x)

/-!

## B. The sector algebras and the generators of their kind

-/

/-- The field-strength towers generating `GaugeSector.gaugeAlgebra` are gauge generators. -/
lemma gaugeAlgebra_generators_subset :
    (⋃ (n : ℕ) (l : Fin n → Fin 1 ⊕ Fin 3) (μ : Fin 1 ⊕ Fin 3) (ν : Fin 1 ⊕ Fin 3),
      Set.range (gaugeFieldStrength l μ ν))
      ⊆ fieldData.kindGenerators .gauge := by
  intro b hb
  simp only [Set.mem_iUnion, Set.mem_range] at hb
  obtain ⟨n, l, μ, ν, ψ, rfl⟩ := hb
  exact GaugeFieldData.covFieldStrength_mem_kindGenerators fieldData (List.ofFn l) μ ν
    (gaugeDualToLie ψ)

/-- Every gauge generator lies in `GaugeSector.gaugeAlgebra`. -/
lemma kindGenerators_gauge_subset_gaugeAlgebra :
    fieldData.kindGenerators .gauge ⊆ GaugeSector.gaugeAlgebra := by
  intro b hb
  simp only [GaugeFieldData.kindGenerators, Set.mem_iUnion, Set.mem_range] at hb
  obtain ⟨l, μ, ν, φ, rfl⟩ := hb
  obtain ⟨n, l', rfl⟩ : ∃ (n : ℕ) (l' : Fin n → (Fin 1 ⊕ Fin 3)), l = List.ofFn l' :=
    ⟨_, l.get, (List.ofFn_get l).symm⟩
  rw [SetLike.mem_coe, GaugeSector.gaugeAlgebra]
  exact Algebra.subset_adjoin (Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨l',
    Set.mem_iUnion.mpr ⟨μ, Set.mem_iUnion.mpr ⟨ν, _, covF_comp_gaugeAlgebraEquiv l' μ ν φ⟩⟩⟩⟩)

/-- The Higgs towers generating `ScalarSector.higgsAlgebra` are scalar generators. -/
lemma higgsAlgebra_generators_subset :
    (⋃ (k : ℕ) (d : Fin k → (Fin 1 ⊕ Fin 3)),
      Set.range (ScalarSector.covH k d) ∪ Set.range (ScalarSector.covBarH k d))
      ⊆ fieldData.kindGenerators .scalar := by
  intro b hb
  simp only [Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
  obtain ⟨k, d, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
  · exact GaugeFieldData.covBoson_mem_kindGenerators fieldData () d φ
  · exact GaugeFieldData.covConjBoson_mem_kindGenerators fieldData () d φ

/-- Every scalar generator lies in `ScalarSector.higgsAlgebra`, the Higgs being the only bosonic
  species. -/
lemma kindGenerators_scalar_subset_higgsAlgebra :
    fieldData.kindGenerators .scalar ⊆ ScalarSector.higgsAlgebra := by
  intro b hb
  simp only [GaugeFieldData.kindGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
  obtain ⟨j, n, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
  · exact ScalarSector.covH_mem_higgsAlgebra l φ
  · exact ScalarSector.covBarH_mem_higgsAlgebra l φ

/-- The fermion towers generating `FermionSector.fermionAlgebra` are fermionic generators. -/
lemma fermionAlgebra_generators_subset :
    (⋃ (i : Fin 3) (n : ℕ) (l : Fin n → Fin 1 ⊕ Fin 3),
      Set.range (FermionSector.d i l) ∪ Set.range (FermionSector.bard i l) ∪
      Set.range (FermionSector.u i l) ∪ Set.range (FermionSector.baru i l) ∪
      Set.range (FermionSector.Q i l) ∪ Set.range (FermionSector.barQ i l) ∪
      Set.range (FermionSector.L i l) ∪ Set.range (FermionSector.barL i l) ∪
      Set.range (FermionSector.e i l) ∪ Set.range (FermionSector.bare i l))
      ⊆ fieldData.kindGenerators .fermion := by
  intro b hb
  simp only [Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
  obtain ⟨i, n, l, (((((((((⟨φ, rfl⟩ | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) |
    ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩)⟩ := hb
  exacts [GaugeFieldData.covFermion_mem_kindGenerators fieldData (.downSinglet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.downSinglet i) l φ,
    GaugeFieldData.covFermion_mem_kindGenerators fieldData (.upSinglet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.upSinglet i) l φ,
    GaugeFieldData.covFermion_mem_kindGenerators fieldData (.quarkDoublet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.quarkDoublet i) l φ,
    GaugeFieldData.covFermion_mem_kindGenerators fieldData (.leptonDoublet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.leptonDoublet i) l φ,
    GaugeFieldData.covFermion_mem_kindGenerators fieldData (.leptonSinglet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.leptonSinglet i) l φ]

/-- Every fermionic generator lies in `FermionSector.fermionAlgebra`. The witness is read off
  the species, `d` for the down-type singlets, `u` for the up-type singlets, `Q` for the quark
  doublets, `L` for the lepton doublets and `e` for the charged-lepton singlets. -/
lemma kindGenerators_fermion_subset_fermionAlgebra :
    fieldData.kindGenerators .fermion ⊆ FermionSector.fermionAlgebra := by
  intro b hb
  simp only [GaugeFieldData.kindGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
  rw [SetLike.mem_coe, FermionSector.fermionAlgebra]
  refine Algebra.subset_adjoin ?_
  simp only [Set.mem_iUnion, Set.mem_union, Set.mem_range]
  obtain ⟨t, n, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
  · cases t with
    | downSinglet i => exact ⟨i, n, l, Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl
        (Or.inl (Or.inl ⟨φ, rfl⟩))))))))⟩
    | upSinglet i => exact ⟨i, n, l, Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl
        (Or.inr ⟨φ, rfl⟩)))))))⟩
    | quarkDoublet i => exact ⟨i, n, l, Or.inl (Or.inl (Or.inl (Or.inl (Or.inl
        (Or.inr ⟨φ, rfl⟩)))))⟩
    | leptonDoublet i => exact ⟨i, n, l, Or.inl (Or.inl (Or.inl (Or.inr ⟨φ, rfl⟩)))⟩
    | leptonSinglet i => exact ⟨i, n, l, Or.inl (Or.inr ⟨φ, rfl⟩)⟩
  · cases t with
    | downSinglet i => exact ⟨i, n, l, Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl
        (Or.inl (Or.inr ⟨φ, rfl⟩))))))))⟩
    | upSinglet i => exact ⟨i, n, l, Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl
        (Or.inr ⟨φ, rfl⟩))))))⟩
    | quarkDoublet i => exact ⟨i, n, l, Or.inl (Or.inl (Or.inl (Or.inl
        (Or.inr ⟨φ, rfl⟩))))⟩
    | leptonDoublet i => exact ⟨i, n, l, Or.inl (Or.inl (Or.inr ⟨φ, rfl⟩))⟩
    | leptonSinglet i => exact ⟨i, n, l, Or.inr ⟨φ, rfl⟩⟩

/-!

## C. The one-kind sectors are the sector algebras

-/

/-- The weight-`w` piece of the gauge sector lies in the weight-`w` piece of
  `GaugeSector.gaugeAlgebra`. -/
lemma sectorMassWeight_gauge_le (w : ℕ) :
    fieldData.sectorMassWeight {FieldKind.gauge} w ≤ GaugeSector.massWeightSubmodule w :=
  GaugeFieldData.sectorMassWeight_le_inf isMassWeightPoly
    (fun k hk => by rw [Finset.mem_singleton.1 hk]; exact kindGenerators_gauge_subset_gaugeAlgebra)
    w

/-- At a non-zero weight the weight piece of the gauge sector is the weight piece of
  `GaugeSector.gaugeAlgebra`. At weight zero the algebra also contains the constants. -/
lemma sectorMassWeight_gauge_eq {w : ℕ} (hw : w ≠ 0) :
    fieldData.sectorMassWeight {FieldKind.gauge} w = GaugeSector.massWeightSubmodule w :=
  le_antisymm (sectorMassWeight_gauge_le w)
    (GaugeFieldData.inf_massWeightSubmodule_le_sectorMassWeight isMassWeightPoly
      gaugeAlgebra_generators_subset hw)

/-- The weight-`w` piece of the Higgs sector lies in the weight-`w` piece of
  `ScalarSector.higgsAlgebra`. -/
lemma sectorMassWeight_higgs_le (w : ℕ) :
    fieldData.sectorMassWeight {FieldKind.scalar} w ≤ ScalarSector.massWeightSubmodule w :=
  GaugeFieldData.sectorMassWeight_le_inf isMassWeightPoly
    (fun k hk => by
      rw [Finset.mem_singleton.1 hk]
      exact kindGenerators_scalar_subset_higgsAlgebra)
    w

/-- At a non-zero weight the weight piece of the Higgs sector is the weight piece of
  `ScalarSector.higgsAlgebra`. At weight zero the algebra also contains the constants. -/
lemma sectorMassWeight_higgs_eq {w : ℕ} (hw : w ≠ 0) :
    fieldData.sectorMassWeight {FieldKind.scalar} w = ScalarSector.massWeightSubmodule w :=
  le_antisymm (sectorMassWeight_higgs_le w)
    (GaugeFieldData.inf_massWeightSubmodule_le_sectorMassWeight isMassWeightPoly
      higgsAlgebra_generators_subset hw)

/-- The weight-`w` piece of the fermion sector lies in the weight-`w` piece of
  `FermionSector.fermionAlgebra`. -/
lemma sectorMassWeight_fermion_le (w : ℕ) :
    fieldData.sectorMassWeight {FieldKind.fermion} w ≤ FermionSector.massWeightSubmodule w :=
  GaugeFieldData.sectorMassWeight_le_inf isMassWeightPoly
    (fun k hk => by
      rw [Finset.mem_singleton.1 hk]
      exact kindGenerators_fermion_subset_fermionAlgebra)
    w

/-- At a non-zero weight the weight piece of the fermion sector is the weight piece of
  `FermionSector.fermionAlgebra`. At weight zero the algebra also contains the constants. -/
lemma sectorMassWeight_fermion_eq {w : ℕ} (hw : w ≠ 0) :
    fieldData.sectorMassWeight {FieldKind.fermion} w = FermionSector.massWeightSubmodule w :=
  le_antisymm (sectorMassWeight_fermion_le w)
    (GaugeFieldData.inf_massWeightSubmodule_le_sectorMassWeight isMassWeightPoly
      fermionAlgebra_generators_subset hw)

end LocalCovFieldAlgebra

end StandardModel

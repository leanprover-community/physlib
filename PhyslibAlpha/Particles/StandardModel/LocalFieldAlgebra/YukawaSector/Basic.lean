module

public import PhyslibAlpha.Particles.StandardModel.LocalFieldAlgebra.LocalCovFieldAlgebra.Sectors
public import PhyslibAlpha.Particles.StandardModel.LocalFieldAlgebra.ScalarSector.MassWeight.Basic
/-!
# The Yukawa sector's mass-weight submodules

The Yukawa sector of the covariant field algebra of the Standard Model, as a join of products.

## i. Overview

Everything below is stated about the covariant field algebra `fieldData.LocalCovFieldAlgebra` of the
Standard Model.

The mixed Higgs-fermion sector — the `{scalar, fermion}` two-class sector of
`Sectors.lean` — is the home of the Yukawa couplings. Since the Higgs sector is
bosonic, its algebra commutes with the fermion algebra
(`commute_of_mem_higgsAlgebra_of_mem_fermionAlgebra`), which feeds the abstract
two-class machinery `sectorMassWeight_pair_le` to bound each weight-`w` piece of the
sector by a join of products of the two sectors' own mass-weight submodules
(`sectorMassWeight_higgs_fermion_le`). Combined with the explicit low-weight tables
for the Higgs sector (vanishing at odd weight) and the fermion sector (vanishing at
weight `1`, `2` and `4`), this pins the sector down explicitly up to weight eight: it
vanishes below weight five and at weight six, and at weights five, seven and eight it
sits inside the expected Yukawa-type products, the last of these being the weight of
the Yukawa term `H ψ ψ` itself.

## ii. Key results

- `commute_of_mem_higgsAlgebra_of_mem_fermionAlgebra` : the algebra generated by the Higgs towers
  commutes with the algebra generated by the fermion towers.
- `sectorMassWeight_higgs_fermion_le` : the Yukawa sector at weight `w` lies in the join, over the
  splittings of `w` into two non-zero parts, of the products of the Higgs-sector and
  fermion-sector mass-weight submodules.
- `sectorMassWeight_higgs_fermion_five`, `sectorMassWeight_higgs_fermion_seven`,
  `sectorMassWeight_higgs_fermion_eight` : the Yukawa sector at weights five, seven and eight.

## iii. Table of contents

- A. Cross-algebra commutation
- B. The Yukawa sector at a fixed mass weight

## iv. References

* None.

-/

@[expose] public section

namespace StandardModel

open GaugeFieldData (FieldKind)

open TensorProduct Matrix MatrixGroups Lorentz


namespace LocalCovFieldAlgebra

/-!

## A. Cross-algebra commutation

The Higgs sector is bosonic, so its algebra commutes with the fermion algebra
elementwise. This is the algebraic input to the whole Yukawa-sector decomposition.

-/

/-- The Higgs sector is bosonic. Every element of the algebra generated by the
  Higgs towers commutes with every element of the algebra generated by the fermion
  towers. -/
lemma commute_of_mem_higgsAlgebra_of_mem_fermionAlgebra {x y : fieldData.LocalCovFieldAlgebra}
    (hx : x ∈ ScalarSector.higgsAlgebra) (hy : y ∈ FermionSector.fermionAlgebra) :
    Commute x y := by
  have hgen : ∀ a ∈ (⋃ (k : ℕ) (dd : Fin k → (Fin 1 ⊕ Fin 3)),
      Set.range (higgsField dd) ∪ Set.range (conjHiggsField dd)),
      ∀ b ∈ (⋃ (i : Fin 3) (k : ℕ) (dd : Fin k → (Fin 1 ⊕ Fin 3)),
        Set.range (downSingletField i dd) ∪ Set.range
          (conjDownSingletField i dd) ∪ Set.range (upSingletField i dd)
          ∪
        Set.range (conjUpSingletField i dd) ∪ Set.range
          (quarkDoubletField i dd) ∪ Set.range (conjQuarkDoubletField i
          dd) ∪
        Set.range (leptonDoubletField i dd) ∪ Set.range
          (conjLeptonDoubletField i dd) ∪ Set.range (leptonSingletField
          i dd) ∪
        Set.range (conjLeptonSingletField i dd)), Commute a b := by
    intro a ha b hb
    simp only [Set.mem_iUnion, Set.mem_union, Set.mem_range] at ha hb
    obtain ⟨k1, d1, ⟨φ1, rfl⟩ | ⟨φ1, rfl⟩⟩ := ha <;>
      obtain ⟨i, k2, dd, (((((((((⟨φ2, rfl⟩ | ⟨φ2, rfl⟩) | ⟨φ2, rfl⟩) | ⟨φ2, rfl⟩) | ⟨φ2, rfl⟩) |
        ⟨φ2, rfl⟩) | ⟨φ2, rfl⟩) | ⟨φ2, rfl⟩) | ⟨φ2, rfl⟩) | ⟨φ2, rfl⟩)⟩ := hb
    · exact LocalCovFieldAlgebra.H_comm_d _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_bard _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_u _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_baru _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_Q _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_barQ _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_L _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_barL _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_e _ _ _ _ _
    · exact LocalCovFieldAlgebra.H_comm_bare _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_d _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_bard _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_u _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_baru _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_Q _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_barQ _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_L _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_barL _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_e _ _ _ _ _
    · exact LocalCovFieldAlgebra.barH_comm_bare _ _ _ _ _
  rw [ScalarSector.higgsAlgebra] at hx
  rw [FermionSector.fermionAlgebra] at hy
  refine Algebra.commute_of_mem_adjoin_of_forall_mem_commute hy fun b hb => ?_
  exact (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hx
    fun a ha => (hgen a ha b hb).symm).symm

/-- The fermion-sector and Higgs-sector mass-weight submodules commute past each
  other, in the order needed by `sectorMassWeight_pair_le`. -/
lemma fermionMassWeight_mul_higgsMassWeight_le (a b : ℕ) :
    FermionSector.massWeightSubmodule a * ScalarSector.massWeightSubmodule b
      ≤ ScalarSector.massWeightSubmodule b * FermionSector.massWeightSubmodule a := by
  refine Submodule.mul_le.mpr fun x hx y hy => ?_
  rw [← (LocalCovFieldAlgebra.commute_of_mem_higgsAlgebra_of_mem_fermionAlgebra
    (ScalarSector.mem_higgsAlgebra_of_mem_massWeightSubmodule hy)
    (FermionSector.mem_fermionAlgebra_of_mem_massWeightSubmodule hx)).eq]
  exact Submodule.mul_mem_mul hy hx

/-!

## B. The Yukawa sector at a fixed mass weight

-/

/-- The Yukawa-sector decomposition. The weight-`w` piece of the `{scalar,
  fermion}` sector is contained in the join, over the splittings of `w` into two
  non-zero parts, of the products of the Higgs-sector and fermion-sector mass-weight
  submodules. -/
lemma sectorMassWeight_higgs_fermion_le (w : ℕ) :
    fieldData.sectorMassWeight {FieldKind.scalar, FieldKind.fermion} w
      ≤ ⨆ (p : ℕ × ℕ) (_ : p.1 + p.2 = w) (_ : p.1 ≠ 0) (_ : p.2 ≠ 0),
        ScalarSector.massWeightSubmodule p.1 * FermionSector.massWeightSubmodule p.2 :=
  GaugeFieldData.sectorMassWeight_pair_le LocalCovFieldAlgebra.hasPositiveMassWeights (by decide)
    LocalCovFieldAlgebra.sectorMassWeight_higgs_le LocalCovFieldAlgebra.sectorMassWeight_fermion_le
    ScalarSector.one_le_massWeightSubmodule_zero
    FermionSector.one_le_massWeightSubmodule_zero
    ScalarSector.massWeightSubmodule_mul_le FermionSector.massWeightSubmodule_mul_le
    LocalCovFieldAlgebra.fermionMassWeight_mul_higgsMassWeight_le w

/-- Below weight five, the Yukawa sector vanishes. No splitting of a total weight
  under five into two non-zero parts survives, since the Higgs part is either odd (hence
  zero) or equal to two, forcing the fermion part to be one or two (hence also
  zero). -/
lemma sectorMassWeight_higgs_fermion_eq_bot_of_lt_five {w : ℕ} (hw : w < 5) :
    fieldData.sectorMassWeight {FieldKind.scalar, FieldKind.fermion} w = ⊥ := by
  refine le_antisymm (le_trans (LocalCovFieldAlgebra.sectorMassWeight_higgs_fermion_le w) ?_) bot_le
  refine iSup_le fun p => iSup_le fun hp => iSup_le fun h1 => iSup_le fun h2 => ?_
  obtain ⟨a, b⟩ := p
  simp only at hp h1 h2
  have ha0 : 0 < a := Nat.pos_of_ne_zero h1
  have ha3 : a ≤ 3 := by omega
  interval_cases a
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 1 (by decide), Submodule.bot_mul]
  · have hb0 : 0 < b := Nat.pos_of_ne_zero h2
    have hb2 : b ≤ 2 := by omega
    interval_cases b
    · rw [FermionSector.massWeightSubmodule_one_eq, Submodule.mul_bot]
    · rw [FermionSector.massWeightSubmodule_two_eq, Submodule.mul_bot]
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 3 (by decide), Submodule.bot_mul]

/-- The Yukawa sector vanishes at weight six, since every splitting of six into two
  non-zero parts has either an odd Higgs part or a fermion part of weight two or
  four, all of which vanish. -/
lemma sectorMassWeight_higgs_fermion_six :
    fieldData.sectorMassWeight {FieldKind.scalar, FieldKind.fermion} 6 = ⊥ := by
  refine le_antisymm (le_trans (LocalCovFieldAlgebra.sectorMassWeight_higgs_fermion_le 6) ?_) bot_le
  refine iSup_le fun p => iSup_le fun hp => iSup_le fun h1 => iSup_le fun h2 => ?_
  obtain ⟨a, b⟩ := p
  simp only at hp h1 h2
  have ha0 : 0 < a := Nat.pos_of_ne_zero h1
  have ha5 : a ≤ 5 := by omega
  interval_cases a
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 1 (by decide), Submodule.bot_mul]
  · have hb : b = 4 := by omega
    rw [hb, FermionSector.massWeightSubmodule_four_eq, Submodule.mul_bot]
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 3 (by decide), Submodule.bot_mul]
  · have hb : b = 2 := by omega
    rw [hb, FermionSector.massWeightSubmodule_two_eq, Submodule.mul_bot]
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 5 (by decide), Submodule.bot_mul]

/-- A product of a Higgs-weight piece and a fermion-weight piece lands in the Yukawa
  sector of the total weight. -/
lemma mul_le_sectorMassWeight_higgs_fermion {a b w : ℕ}
    {X Y : Submodule ℂ fieldData.LocalCovFieldAlgebra}
    (ha : a ≠ 0) (hb : b ≠ 0) (hab : a + b = w)
    (hX : X ≤ ScalarSector.massWeightSubmodule a)
    (hY : Y ≤ FermionSector.massWeightSubmodule b) :
    X * Y ≤ fieldData.sectorMassWeight {FieldKind.scalar, FieldKind.fermion}
      w := by
  have hset : ({FieldKind.scalar} ∪ {FieldKind.fermion} : Finset FieldKind)
      = {FieldKind.scalar, FieldKind.fermion} := by decide
  refine Submodule.mul_le.mpr fun x hx y hy => ?_
  have hx' : x ∈ fieldData.sectorMassWeight {FieldKind.scalar} a := by
    rw [LocalCovFieldAlgebra.sectorMassWeight_higgs_eq ha]; exact hX hx
  have hy' : y ∈ fieldData.sectorMassWeight {FieldKind.fermion} b := by
    rw [LocalCovFieldAlgebra.sectorMassWeight_fermion_eq hb]; exact hY hy
  have hmem := GaugeFieldData.mul_mem_sectorMassWeight hx' hy'
  rwa [hset, hab] at hmem

/-- The weight-five Yukawa sector. The only surviving splitting is the Higgs
  field itself (weight two) against the underived fermion towers (weight three). -/
lemma sectorMassWeight_higgs_fermion_five :
    fieldData.sectorMassWeight {FieldKind.scalar, FieldKind.fermion} 5
      = ScalarSector.derivSubmodule 0 * FermionSector.derivSubmodule 0 := by
  refine le_antisymm ?_ ?_
  case refine_2 =>
    exact LocalCovFieldAlgebra.mul_le_sectorMassWeight_higgs_fermion (a := 2) (b := 3) (by norm_num)
      (by norm_num) (by norm_num)
      (le_of_eq ScalarSector.massWeightSubmodule_two_eq_deriv.symm)
      (le_of_eq FermionSector.massWeightSubmodule_three_eq.symm)
  rw [← ScalarSector.massWeightSubmodule_two_eq_deriv]
  refine le_trans (LocalCovFieldAlgebra.sectorMassWeight_higgs_fermion_le 5) ?_
  refine iSup_le fun p => iSup_le fun hp => iSup_le fun h1 => iSup_le fun h2 => ?_
  obtain ⟨a, b⟩ := p
  simp only at hp h1 h2
  have ha0 : 0 < a := Nat.pos_of_ne_zero h1
  have ha4 : a ≤ 4 := by omega
  interval_cases a
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 1 (by decide), Submodule.bot_mul]
    exact bot_le
  · have hb : b = 3 := by omega
    rw [hb, FermionSector.massWeightSubmodule_three_eq]
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 3 (by decide), Submodule.bot_mul]
    exact bot_le
  · have hb : b = 1 := by omega
    rw [hb, FermionSector.massWeightSubmodule_one_eq, Submodule.mul_bot]
    exact bot_le

/-- The weight-seven Yukawa sector. The surviving splittings pair the Higgs
  field (weight two) with the once-derived fermion towers (weight five), or the
  once-derived Higgs field (weight four) with the underived fermion towers (weight
  three). -/
lemma sectorMassWeight_higgs_fermion_seven :
    fieldData.sectorMassWeight {FieldKind.scalar, FieldKind.fermion} 7
      = ScalarSector.derivSubmodule 0 * FermionSector.derivSubmodule 1
        ⊔ ScalarSector.derivSubmodule 1 * FermionSector.derivSubmodule 0
        ⊔ ScalarSector.derivSubmodule 0 * ScalarSector.derivSubmodule 0
          * FermionSector.derivSubmodule 0 := by
  refine le_antisymm ?_ ?_
  case refine_2 =>
    refine sup_le (sup_le ?_ ?_) ?_
    · exact LocalCovFieldAlgebra.mul_le_sectorMassWeight_higgs_fermion (a := 2) (b := 5)
        (by norm_num)
        (by norm_num) (by norm_num)
        (le_of_eq ScalarSector.massWeightSubmodule_two_eq_deriv.symm)
        (le_of_eq FermionSector.massWeightSubmodule_five_eq.symm)
    · exact LocalCovFieldAlgebra.mul_le_sectorMassWeight_higgs_fermion (a := 4) (b := 3)
        (by norm_num)
        (by norm_num) (by norm_num)
        (by rw [ScalarSector.massWeightSubmodule_four_eq_deriv]; exact le_sup_left)
        (le_of_eq FermionSector.massWeightSubmodule_three_eq.symm)
    · exact LocalCovFieldAlgebra.mul_le_sectorMassWeight_higgs_fermion (a := 4) (b := 3)
        (by norm_num)
        (by norm_num) (by norm_num)
        (by rw [ScalarSector.massWeightSubmodule_four_eq_deriv]; exact le_sup_right)
        (le_of_eq FermionSector.massWeightSubmodule_three_eq.symm)
  refine le_trans (LocalCovFieldAlgebra.sectorMassWeight_higgs_fermion_le 7) ?_
  refine iSup_le fun p => iSup_le fun hp => iSup_le fun h1 => iSup_le fun h2 => ?_
  obtain ⟨a, b⟩ := p
  simp only at hp h1 h2
  have ha0 : 0 < a := Nat.pos_of_ne_zero h1
  have ha6 : a ≤ 6 := by omega
  interval_cases a
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 1 (by decide), Submodule.bot_mul]
    exact bot_le
  · have hb : b = 5 := by omega
    rw [hb, FermionSector.massWeightSubmodule_five_eq,
      ScalarSector.massWeightSubmodule_two_eq_deriv]
    exact le_sup_left.trans le_sup_left
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 3 (by decide), Submodule.bot_mul]
    exact bot_le
  · have hb : b = 3 := by omega
    rw [hb, FermionSector.massWeightSubmodule_three_eq,
      ScalarSector.massWeightSubmodule_four_eq_deriv, Submodule.sup_mul]
    exact sup_le (le_sup_right.trans le_sup_left) le_sup_right
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 5 (by decide), Submodule.bot_mul]
    exact bot_le
  · have hb : b = 1 := by omega
    rw [hb, FermionSector.massWeightSubmodule_one_eq, Submodule.mul_bot]
    exact bot_le

/-- The weight-eight Yukawa sector. The only surviving splitting pairs the Higgs
  field (weight two) with the product of two underived fermion towers (weight six), the
  sector of the Yukawa term `H ψ ψ` itself. -/
lemma sectorMassWeight_higgs_fermion_eight :
    fieldData.sectorMassWeight {FieldKind.scalar, FieldKind.fermion} 8
      = ScalarSector.derivSubmodule 0
        * (FermionSector.derivSubmodule 0 * FermionSector.derivSubmodule 0) := by
  refine le_antisymm ?_ ?_
  case refine_2 =>
    exact LocalCovFieldAlgebra.mul_le_sectorMassWeight_higgs_fermion (a := 2) (b := 6) (by norm_num)
      (by norm_num) (by norm_num)
      (le_of_eq ScalarSector.massWeightSubmodule_two_eq_deriv.symm)
      (le_of_eq FermionSector.massWeightSubmodule_six_eq.symm)
  rw [← ScalarSector.massWeightSubmodule_two_eq_deriv]
  refine le_trans (LocalCovFieldAlgebra.sectorMassWeight_higgs_fermion_le 8) ?_
  refine iSup_le fun p => iSup_le fun hp => iSup_le fun h1 => iSup_le fun h2 => ?_
  obtain ⟨a, b⟩ := p
  simp only at hp h1 h2
  have ha0 : 0 < a := Nat.pos_of_ne_zero h1
  have ha7 : a ≤ 7 := by omega
  interval_cases a
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 1 (by decide), Submodule.bot_mul]
    exact bot_le
  · have hb : b = 6 := by omega
    rw [hb, FermionSector.massWeightSubmodule_six_eq]
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 3 (by decide), Submodule.bot_mul]
    exact bot_le
  · have hb : b = 4 := by omega
    rw [hb, FermionSector.massWeightSubmodule_four_eq, Submodule.mul_bot]
    exact bot_le
  · rw [ScalarSector.massWeightSubmodule_odd_eq_bot 5 (by decide), Submodule.bot_mul]
    exact bot_le
  · have hb : b = 2 := by omega
    rw [hb, FermionSector.massWeightSubmodule_two_eq, Submodule.mul_bot]
    exact bot_le
  · have hb : b = 1 := by omega
    rw [hb, FermionSector.massWeightSubmodule_one_eq, Submodule.mul_bot]
    exact bot_le

end LocalCovFieldAlgebra

end StandardModel

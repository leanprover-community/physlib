/-!
# The derivative submodules of the scalar sector

The span of the Higgs and conjugate Higgs symbols with a fixed number of derivatives.

## i. Overview

The scalar symbols (the Higgs and its conjugate) carrying a fixed number `n` of derivatives
span the submodule `derivSubmodule n`. The Higgs is bosonic, so these submodules commute
with one another, and since neither the gauge nor the Lorentz action changes the number
of derivatives they are closed under both.

The gauge weight decomposition of these submodules lives in `GaugeWeight.lean`,
and the sign they carry at the centre of `SL(2,ℂ)` in `Centre.lean`.

## ii. Key results

- `derivSubmodule` : the submodule of the covariant field algebra generated by the Higgs symbols
  and their conjugates carrying `n` derivatives.
- `commute_of_mem_derivSubmodule` : any element of a derivative submodule commutes with any element
  of any derivative submodule, the Higgs being bosonic.
- `derivSubmodule_map_rep_le`, `derivSubmodule_map_repLorentz_le` : the derivative submodules are
  closed under the gauge and Lorentz actions.

## iii. Table of contents

- A. The derivative submodules of the scalar sector

## iv. References

* None.

-/

/-!

## A. The derivative submodules of the scalar sector

-/

@[expose] public section

namespace StandardModel

open TensorProduct Matrix MatrixGroups Lorentz
open LocalCovFieldAlgebra (repGaugeGroupI repLorentzGroup massWeightPoly)

namespace ScalarSector

/-- The submodule of the covariant field algebra generated by the Higgs symbols and their
  conjugates carrying `n` derivatives. -/
noncomputable def derivSubmodule (n : ℕ) : Submodule ℂ fieldData.LocalCovFieldAlgebra :=
  higgsSubmodule n ⊔ barHiggsSubmodule n

/-- Every element of a derivative submodule commutes with a fixed Higgs symbol. -/
lemma derivSubmodule_le_ker_H {n k : ℕ} (d : Fin k → (Fin 1 ⊕ Fin 3))
    (φ : Module.Dual ℂ HiggsVec) :
    derivSubmodule n
      ≤ LinearMap.ker (LinearMap.mulLeft ℂ (covH k d φ)
        - LinearMap.mulRight ℂ (covH k d φ)) := by
  rw [derivSubmodule]
  refine sup_le ?_ ?_
  · rw [higgsSubmodule]
    refine iSup_le fun d' => ?_
    rintro _ ⟨ψ, rfl⟩
    simp only [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.mulLeft_apply,
      LinearMap.mulRight_apply, sub_eq_zero]
    exact (H_comm_H φ ψ k n d d').eq
  · rw [barHiggsSubmodule]
    refine iSup_le fun d' => ?_
    rintro _ ⟨ψ, rfl⟩
    simp only [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.mulLeft_apply,
      LinearMap.mulRight_apply, sub_eq_zero]
    exact (H_comm_barH φ ψ k n d d').eq

/-- Every element of a derivative submodule commutes with a fixed conjugate-Higgs
  symbol. -/
lemma derivSubmodule_le_ker_barH {n k : ℕ} (d : Fin k → (Fin 1 ⊕ Fin 3))
    (φ : Module.Dual ℂ (ConjModule HiggsVec)) :
    derivSubmodule n
      ≤ LinearMap.ker (LinearMap.mulLeft ℂ (covBarH k d φ)
        - LinearMap.mulRight ℂ (covBarH k d φ)) := by
  rw [derivSubmodule]
  refine sup_le ?_ ?_
  · rw [higgsSubmodule]
    refine iSup_le fun d' => ?_
    rintro _ ⟨ψ, rfl⟩
    simp only [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.mulLeft_apply,
      LinearMap.mulRight_apply, sub_eq_zero]
    exact ((H_comm_barH ψ φ n k d' d).symm).eq
  · rw [barHiggsSubmodule]
    refine iSup_le fun d' => ?_
    rintro _ ⟨ψ, rfl⟩
    simp only [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.mulLeft_apply,
      LinearMap.mulRight_apply, sub_eq_zero]
    exact (barH_comm_barH φ ψ k n d d').eq

/-- Any element of a derivative submodule commutes with any element of any derivative
  submodule, the Higgs being bosonic. -/
lemma commute_of_mem_derivSubmodule {n m : ℕ} {x y : fieldData.LocalCovFieldAlgebra}
    (hx : x ∈ derivSubmodule n) (hy : y ∈ derivSubmodule m) : Commute x y := by
  have step : derivSubmodule n
      ≤ LinearMap.ker (LinearMap.mulRight ℂ y - LinearMap.mulLeft ℂ y) := by
    rw [derivSubmodule]
    refine sup_le ?_ ?_
    · rw [higgsSubmodule]
      refine iSup_le fun d => ?_
      rintro _ ⟨φ, rfl⟩
      have := derivSubmodule_le_ker_H (n := m) d φ hy
      simp only [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.mulLeft_apply,
        LinearMap.mulRight_apply, sub_eq_zero] at this ⊢
      exact this
    · rw [barHiggsSubmodule]
      refine iSup_le fun d => ?_
      rintro _ ⟨φ, rfl⟩
      have := derivSubmodule_le_ker_barH (n := m) d φ hy
      simp only [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.mulLeft_apply,
        LinearMap.mulRight_apply, sub_eq_zero] at this ⊢
      exact this
  have hxy := step hx
  simp only [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.mulRight_apply,
    LinearMap.mulLeft_apply, sub_eq_zero] at hxy
  exact hxy

/-- Derivative submodules commute with one another at the level of submodule
  products. -/
lemma derivSubmodule_mul_comm (n m : ℕ) :
    derivSubmodule n * derivSubmodule m = derivSubmodule m * derivSubmodule n := by
  refine le_antisymm (Submodule.mul_le.mpr fun x hx y hy => ?_)
    (Submodule.mul_le.mpr fun y hy x hx => ?_)
  · rw [(commute_of_mem_derivSubmodule hx hy).eq]
    exact Submodule.mul_mem_mul hy hx
  · rw [← (commute_of_mem_derivSubmodule hx hy).eq]
    exact Submodule.mul_mem_mul hx hy

/-- The derivative submodules are closed under the gauge action, each symbol being carried
  to a symbol with the same number of derivatives. -/
lemma derivSubmodule_map_rep_le (n : ℕ) (g : GaugeGroupI) :
    (derivSubmodule n).map (repGaugeGroupI g) ≤ derivSubmodule n := by
  rw [derivSubmodule, Submodule.map_sup]
  refine sup_le_sup ?_ ?_
  · rw [higgsSubmodule, Submodule.map_iSup]
    refine iSup_le fun d => ?_
    rintro _ ⟨_, ⟨φ, rfl⟩, rfl⟩
    rw [H_equivariant]
    exact Submodule.mem_iSup_of_mem d ⟨_, rfl⟩
  · rw [barHiggsSubmodule, Submodule.map_iSup]
    refine iSup_le fun d => ?_
    rintro _ ⟨_, ⟨φ, rfl⟩, rfl⟩
    rw [barH_equivariant]
    exact Submodule.mem_iSup_of_mem d ⟨_, rfl⟩

/-- The derivative submodules are closed under the Lorentz action, since the Lorentz group
  only mixes the derivative indices within a fixed number of derivatives. -/
lemma derivSubmodule_map_repLorentz_le (n : ℕ) (Λ : SL(2,ℂ)) :
    (derivSubmodule n).map (repLorentzGroup Λ) ≤ derivSubmodule n := by
  rw [derivSubmodule, Submodule.map_sup]
  refine sup_le_sup ?_ ?_
  · rw [higgsSubmodule, Submodule.map_iSup]
    refine iSup_le fun d => ?_
    rintro _ ⟨_, ⟨φ, rfl⟩, rfl⟩
    rw [repLorentz_H_apply]
    exact Submodule.sum_mem _ fun a _ =>
      Submodule.smul_mem _ _ (Submodule.mem_iSup_of_mem a ⟨φ, rfl⟩)
  · rw [barHiggsSubmodule, Submodule.map_iSup]
    refine iSup_le fun d => ?_
    rintro _ ⟨_, ⟨φ, rfl⟩, rfl⟩
    rw [repLorentz_barH_apply]
    exact Submodule.sum_mem _ fun a _ =>
      Submodule.smul_mem _ _ (Submodule.mem_iSup_of_mem a ⟨φ, rfl⟩)

end ScalarSector

end StandardModel

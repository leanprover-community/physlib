module

public import PhyslibAlpha.Mathematics.HomogeneousGenerators
public import PhyslibAlpha.Particles.StandardModel.LocalFieldAlgebra.FermionSector.Basic
/-!
# The mass-weight grading of the fermion sector

The mass-weight submodules of the fermion algebra, and their description up to weight eight.

## i. Overview

The elements of the fermion algebra of a given mass weight form a submodule. Mass weight is
twice the mass dimension, so that it is a natural number. A fermion tower `∇ⁿψ` with `n`
covariant derivatives has mass dimension `3/2 + n` and mass weight `3 + 2 * n`, and a term
of mass dimension four, as in the Lagrangian, has mass weight eight.

The fermion towers generate the fermion algebra, and `massWeightPoly` is a monomial on
each of them. The results of `PhyslibAlpha.Mathematics.HomogeneousGenerators` then describe
every mass-weight submodule. The submodules of weight at most eight are found by removing
the leftmost tower of each product, and weight eight collapses, by the commutation of the
derivative submodules, to the kinetic sector `derivSubmodule 0 * derivSubmodule 1`.

## ii. Key results

- `massWeightSubmodule_eq_iSup_mul` : removing the leftmost fermion tower.
- `massWeightSubmodule_eq` : the binary weight recursion.
- `massWeightSubmodule_eq_bot` : the weights `1`, `2` and `4` are empty.
- `massWeightSubmodule_three_eq` to `massWeightSubmodule_eight_eq` : the mass weights up to eight.

## iii. Table of contents

- A. The mass-weight submodules
- B. The fermion towers generate and have weight `3 + 2 * n`
- C. The weight decompositions
- D. Mass weights up to eight

## iv. References

* None.

-/

@[expose] public section

namespace StandardModel

open TensorProduct Matrix MatrixGroups Lorentz

namespace FermionSector

/-!

## A. The mass-weight submodules

-/

/-- All elements of the fermion algebra of mass weight exactly `w`, the intersection
  of the algebra generated by the fermion towers with the part on which
  `massWeightPoly` is the monomial `X ^ w`. -/
noncomputable def massWeightSubmodule (w : ℕ) :
    Submodule ℂ fieldData.LocalCovFieldAlgebra :=
  (fermionAlgebra).toSubmodule
    ⊓ LinearMap.ker (massWeightPoly.toLinearMap
      - (Polynomial.monomial w :
          fieldData.LocalCovFieldAlgebra →ₗ[fieldData.LocalCovFieldAlgebra]
            Polynomial fieldData.LocalCovFieldAlgebra).restrictScalars ℂ)

/-- An element of the weight-`w` submodule is a mass-weight eigenvector of weight `w`. -/
lemma massWeightPoly_of_mem_massWeightSubmodule {w : ℕ} {x : fieldData.LocalCovFieldAlgebra}
    (hx : x ∈ massWeightSubmodule w) :
    massWeightPoly x = Polynomial.monomial w x :=
  (Subalgebra.mem_homogeneousSubmodule_iff.mp hx).2

/-- The weight-`w` submodule lies in the fermion algebra. -/
lemma mem_fermionAlgebra_of_mem_massWeightSubmodule {w : ℕ} {x : fieldData.LocalCovFieldAlgebra}
    (hx : x ∈ massWeightSubmodule w) : x ∈ fermionAlgebra :=
  (Subalgebra.mem_homogeneousSubmodule_iff.mp hx).1

/-- The scalars have mass weight zero. -/
lemma one_le_massWeightSubmodule_zero : (1 : Submodule ℂ fieldData.LocalCovFieldAlgebra) ≤
    massWeightSubmodule 0 :=
  Subalgebra.one_le_homogeneousSubmodule_zero

/-- Mass weights add under multiplication. -/
lemma massWeightSubmodule_mul_le (m n : ℕ) :
    massWeightSubmodule m * massWeightSubmodule n ≤ massWeightSubmodule (m + n) :=
  Subalgebra.homogeneousSubmodule_mul_le m n

/-!

## B. The fermion towers generate and have weight `3 + 2 * n`

-/

/-- The fermion algebra is generated by the fermion towers of every derivative order. -/
lemma fermionAlgebra_eq_adjoin_derivSubmodule :
    fermionAlgebra = Algebra.adjoin ℂ
      (⋃ n, (derivSubmodule n : Set fieldData.LocalCovFieldAlgebra)) := by
  simp only [derivSubmodule_eq_span, Algebra.adjoin_iUnion, Algebra.adjoin_span,
    fermionAlgebra]
  exact iSup_comm

/-- `massWeightPoly` is the monomial `X ^ (3 + 2 * n)` on the fermion towers with `n`
  covariant derivatives. -/
lemma massWeightPoly_of_mem_derivSubmodule (n : ℕ) :
    ∀ x ∈ derivSubmodule n, massWeightPoly x = Polynomial.monomial (3 + 2 * n) x := by
  intro x hx
  rw [derivSubmodule_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    simp only [Set.mem_iUnion, Set.mem_union, Set.mem_range] at hy
    obtain ⟨i, l, (((((((((⟨φ, rfl⟩ | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) |
      ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩)⟩ := hy <;>
    simp only [massWeight_d, massWeight_bard, massWeight_u, massWeight_baru,
      massWeight_Q, massWeight_barQ, massWeight_L, massWeight_barL, massWeight_e,
      massWeight_bare]
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, hx, hy, map_add]
  | smul c x _ hx => rw [map_smul, hx, Polynomial.smul_monomial]

/-- A fermion tower with `n` covariant derivatives has mass weight `3 + 2 * n`. -/
lemma derivSubmodule_le_massWeightSubmodule (n : ℕ) :
    derivSubmodule n ≤ massWeightSubmodule (3 + 2 * n) :=
  Subalgebra.le_homogeneousSubmodule fermionAlgebra_eq_adjoin_derivSubmodule
    massWeightPoly_of_mem_derivSubmodule n

/-!

## C. The weight decompositions

Every result here is a spanning statement. A submodule is a join of products of fermion
towers, in the order written. It says nothing about the products being nonzero or
independent.

-/

/-- Weight zero is the scalars, as every fermion tower has positive weight. -/
lemma massWeightSubmodule_zero_eq : massWeightSubmodule 0 = 1 :=
  Subalgebra.homogeneousSubmodule_zero_eq_one fermionAlgebra_eq_adjoin_derivSubmodule
    massWeightPoly_of_mem_derivSubmodule (fun n => by omega)

/-- The weight recursion. An element of positive mass weight `i` is a sum of single
  fermion towers of weight `i` and of products of two elements of lower positive weights
  summing to `i`. -/
lemma massWeightSubmodule_eq (i : ℕ) (hi : 0 < i) :
    massWeightSubmodule i
      = (⨆ k ∈ Finset.univ.filter (fun k : Fin i => 3 + 2 * (k : ℕ) = i),
          derivSubmodule (k : ℕ))
        ⊔ (⨆ p ∈ Finset.univ.filter (fun p : Fin i × Fin i => (p.1 : ℕ) + (p.2 : ℕ) = i),
            massWeightSubmodule (p.1 : ℕ) * massWeightSubmodule (p.2 : ℕ)) :=
  Subalgebra.homogeneousSubmodule_eq_sup_iSup_mul (deg := fun n => 3 + 2 * n)
    fermionAlgebra_eq_adjoin_derivSubmodule massWeightPoly_of_mem_derivSubmodule
    (fun n => by omega) i hi

/-- Removing the leftmost fermion tower. An element of positive weight `w` is a sum of
  products of a tower `∇ⁿψ` of weight `3 + 2 * n ≤ w` with an element of the remaining
  weight. -/
lemma massWeightSubmodule_eq_iSup_mul (w : ℕ) (hw : 0 < w) :
    massWeightSubmodule w
      = ⨆ n ∈ (Finset.range (w + 1)).filter (fun n => 3 + 2 * n ≤ w),
          derivSubmodule n * massWeightSubmodule (w - (3 + 2 * n)) :=
  Subalgebra.homogeneousSubmodule_eq_iSup_mul (deg := fun n => 3 + 2 * n)
    fermionAlgebra_eq_adjoin_derivSubmodule massWeightPoly_of_mem_derivSubmodule
    (fun n => by omega) hw

/-- The weights `1`, `2` and `4` are empty, since the tower weights `3, 5, 7, …` and their sums
  only reach `0`, `3` and every weight from `5` on. -/
lemma massWeightSubmodule_eq_bot {w : ℕ} (hw : ¬ (w = 0 ∨ w = 3 ∨ 5 ≤ w)) :
    massWeightSubmodule w = ⊥ :=
  Subalgebra.homogeneousSubmodule_eq_bot fermionAlgebra_eq_adjoin_derivSubmodule
    massWeightPoly_of_mem_derivSubmodule (fun w => w = 0 ∨ w = 3 ∨ 5 ≤ w)
    (by omega) (fun n => by omega) (fun a b ha hb => by omega) hw

/-!

## D. Mass weights up to eight

Each case removes the leftmost tower. The towers `ψ`, `∇ψ` and `∇∇ψ` have weights `3`, `5`
and `7`; the remaining weight is then read off from a smaller weight.

-/

/-- There is nothing of weight one. -/
lemma massWeightSubmodule_one_eq : massWeightSubmodule 1 = ⊥ :=
  massWeightSubmodule_eq_bot (by omega)

/-- There is nothing of weight two. -/
lemma massWeightSubmodule_two_eq : massWeightSubmodule 2 = ⊥ :=
  massWeightSubmodule_eq_bot (by omega)

/-- Weight three is the underived fermion towers, as `ψ` leaves weight zero. -/
lemma massWeightSubmodule_three_eq :
    massWeightSubmodule 3 = derivSubmodule 0 := by
  rw [massWeightSubmodule_eq_iSup_mul 3 (by norm_num),
    show (Finset.range 4).filter (fun n => 3 + 2 * n ≤ 3) = {0} from by decide,
    Finset.iSup_singleton]
  simp [massWeightSubmodule_zero_eq]

/-- There is nothing of weight four. -/
lemma massWeightSubmodule_four_eq : massWeightSubmodule 4 = ⊥ :=
  massWeightSubmodule_eq_bot (by omega)

/-- Weight five is the once-derived fermion towers. `ψ` would leave weight two, which is
  empty, and `∇ψ` leaves weight zero. -/
lemma massWeightSubmodule_five_eq :
    massWeightSubmodule 5 = derivSubmodule 1 := by
  rw [massWeightSubmodule_eq_iSup_mul 5 (by norm_num),
    show (Finset.range 6).filter (fun n => 3 + 2 * n ≤ 5) = {0, 1} from by decide,
    Finset.iSup_insert, Finset.iSup_singleton]
  simp [massWeightSubmodule_zero_eq, massWeightSubmodule_two_eq]

/-- Weight six is the products of two underived fermion towers. `ψ` leaves weight three,
  which is `ψ`, and `∇ψ` would leave weight one, which is empty. -/
lemma massWeightSubmodule_six_eq :
    massWeightSubmodule 6 = derivSubmodule 0 * derivSubmodule 0 := by
  rw [massWeightSubmodule_eq_iSup_mul 6 (by norm_num),
    show (Finset.range 7).filter (fun n => 3 + 2 * n ≤ 6) = {0, 1} from by decide,
    Finset.iSup_insert, Finset.iSup_singleton]
  simp [massWeightSubmodule_three_eq, massWeightSubmodule_one_eq]

/-- Weight seven is the twice-derived fermion towers. `ψ` and `∇ψ` would leave weights
  four and two, which are empty, and `∇∇ψ` leaves weight zero. -/
lemma massWeightSubmodule_seven_eq :
    massWeightSubmodule 7 = derivSubmodule 2 := by
  rw [massWeightSubmodule_eq_iSup_mul 7 (by norm_num),
    show (Finset.range 8).filter (fun n => 3 + 2 * n ≤ 7) = {0, 1, 2} from by decide,
    Finset.iSup_insert, Finset.iSup_insert, Finset.iSup_singleton]
  simp [massWeightSubmodule_four_eq, massWeightSubmodule_two_eq,
    massWeightSubmodule_zero_eq]

/-- Weight eight is the products of an underived and a once-derived fermion tower, the
  kinetic-term sector. `ψ` leaves `∇ψ`, `∇ψ` leaves `ψ`, and `∇∇ψ` would leave weight one,
  which is empty. The two orders agree by `derivSubmodule_mul_comm`. -/
lemma massWeightSubmodule_eight_eq :
    massWeightSubmodule 8 = derivSubmodule 0 * derivSubmodule 1 := by
  rw [massWeightSubmodule_eq_iSup_mul 8 (by norm_num),
    show (Finset.range 9).filter (fun n => 3 + 2 * n ≤ 8) = {0, 1, 2} from by decide,
    Finset.iSup_insert, Finset.iSup_insert, Finset.iSup_singleton]
  simp [massWeightSubmodule_five_eq, massWeightSubmodule_three_eq,
    massWeightSubmodule_one_eq, derivSubmodule_mul_comm 1 0]

end FermionSector

end StandardModel

/-- The algebra generated by the ten fermion families and all their covariant
  derivatives. -/
noncomputable def fermionAlgebra : Subalgebra ℂ fieldData.LocalCovFieldAlgebra :=
  Algebra.adjoin ℂ
    (⋃ (i : Fin 3) (n : ℕ) (l : Fin n → Fin 1 ⊕ Fin 3),
      Set.range (d i l) ∪ Set.range (bard i l) ∪
      Set.range (u i l) ∪ Set.range (baru i l) ∪
      Set.range (Q i l) ∪ Set.range (barQ i l) ∪
      Set.range (L i l) ∪ Set.range (barL i l) ∪
      Set.range (e i l) ∪ Set.range (bare i l))


/-!

## C. The fermion-derivative submodules

-/

/-- The submodule of `fieldData.LocalCovFieldAlgebra` generated by the fermion symbols carrying
  exactly `n` covariant derivatives, the join, over the families and derivative slots, of the
  ranges of the ten species' symbol maps. -/
noncomputable def derivSubmodule (n : ℕ) : Submodule ℂ fieldData.LocalCovFieldAlgebra :=
  ⨆ (i : Fin 3) (l : Fin n → Fin 1 ⊕ Fin 3),
    LinearMap.range (d i l) ⊔ LinearMap.range (bard i l) ⊔
    LinearMap.range (u i l) ⊔ LinearMap.range (baru i l) ⊔
    LinearMap.range (Q i l) ⊔ LinearMap.range (barQ i l) ⊔
    LinearMap.range (L i l) ⊔ LinearMap.range (barL i l) ⊔
    LinearMap.range (e i l) ⊔ LinearMap.range (bare i l)

/-- The derivative submodule as the span of the fermion symbol values. -/
lemma derivSubmodule_eq_span (n : ℕ) :
    derivSubmodule n = Submodule.span ℂ
      (⋃ (i : Fin 3) (l : Fin n → Fin 1 ⊕ Fin 3),
        Set.range (d i l) ∪ Set.range (bard i l) ∪
        Set.range (u i l) ∪ Set.range (baru i l) ∪
        Set.range (Q i l) ∪ Set.range (barQ i l) ∪
        Set.range (L i l) ∪ Set.range (barL i l) ∪
        Set.range (e i l) ∪ Set.range (bare i l)) := by
  simp only [derivSubmodule, Submodule.span_iUnion, Submodule.span_union, ← LinearMap.coe_range,
    Submodule.span_eq]

/-- Every fermion derivative submodule lies in the span of the fermionic covariant generators,
  each of its symbols being one. -/
lemma derivSubmodule_le_span_kindGenerators (n : ℕ) :
    derivSubmodule n ≤ Submodule.span ℂ (fieldData.kindGenerators .fermion) := by
  rw [derivSubmodule_eq_span]
  refine Submodule.span_mono fun a ha => ?_
  simp only [Set.mem_iUnion, Set.mem_union, Set.mem_range] at ha
  obtain ⟨i, l, (((((((((⟨φ, rfl⟩ | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) |
      ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩) | ⟨φ, rfl⟩)⟩ := ha
  exacts [GaugeFieldData.covFermion_mem_kindGenerators fieldData (.downSinglet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.downSinglet i) l φ,
    GaugeFieldData.covFermion_mem_kindGenerators fieldData (.upSinglet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.upSinglet i) l φ,
    GaugeFieldData.covFermion_mem_kindGenerators fieldData (.quarkDoublet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.quarkDoublet i) l φ,
    GaugeFieldData.covFermion_mem_kindGenerators fieldData (.leptonDoublet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.leptonDoublet i) l φ,
    GaugeFieldData.covFermion_mem_kindGenerators fieldData (.leptonSinglet i) l φ,
    GaugeFieldData.covConjFermion_mem_kindGenerators fieldData (.leptonSinglet i) l φ]

/-- Any two elements of the fermion derivative submodules anticommute. They are combinations of
  fermionic covariant generators, which anticommute by
  `GaugeFieldData.anticomm_of_mem_span_kindGenerators_fermion`. -/
lemma anticomm_of_mem_derivSubmodule {n m : ℕ} {x y : fieldData.LocalCovFieldAlgebra}
    (hx : x ∈ derivSubmodule n) (hy : y ∈ derivSubmodule m) :
    x * y = -(y * x) :=
  GaugeFieldData.anticomm_of_mem_span_kindGenerators_fermion
    (derivSubmodule_le_span_kindGenerators n hx) (derivSubmodule_le_span_kindGenerators m hy)

/-- The fermion derivative submodules commute with one another as submodules, the
  sign from anticommutation is absorbed by the span. -/
lemma derivSubmodule_mul_comm (n m : ℕ) :
    derivSubmodule n * derivSubmodule m = derivSubmodule m * derivSubmodule n := by
  refine le_antisymm ?_ ?_ <;>
  · rw [Submodule.mul_le]
    intro x hx y hy
    rw [anticomm_of_mem_derivSubmodule hx hy]
    exact Submodule.neg_mem _ (Submodule.mul_mem_mul hy hx)


end FermionSector

end StandardModel

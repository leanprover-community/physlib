/-!
# The fermion sector

The ten fermion towers of the Standard Model, their laws, and the submodules they span.

## i. Overview

The fermion sector of the Standard Model's covariant field algebra `fieldData.LocalCovFieldAlgebra`
consists of the three families of each of the ten fermion species, the five species and their
conjugates, indexed by ordered tuples of covariant-derivative directions. This file names the ten
towers (`d`, `bard`, `u`, `baru`, `Q`, `barQ`, `L`, `barL`, `e`, `bare`) and the gauge, Lorentz and
mass-weight actions on `fieldData.LocalCovFieldAlgebra` (`repGauge`, `repLorentz`,
`massWeightPoly`), and records the laws they obey. Each family transforms under the global gauge
group through the dual of the species' gauge representation (the conjugate representation for the
barred fields), under the Lorentz group as the covariant derivatives of the species' Lorentz
representation, and each tower is a `massWeightPoly`-eigenvector of weight `3 + 2 * n` (mass
dimension `3/2 + n`). Any two fermionic towers anticommute, by
`GaugeFieldData.LocalCovFieldAlgebra.covFermion_anticomm_covFermion` and its companions.

Each law is the corresponding law of the covariant towers of `fieldData.LocalCovFieldAlgebra`, so
nothing new is proved here beyond the assembly.

## ii. Key results

- `repGauge_d`, ..., `repGauge_bare` : gauge transformation of the towers through the dual of the
  species representations (conjugate for the barred fields).
- `repLorentz_d`, ..., `repLorentz_bare` : the Lorentz transformation of the towers.
- `massWeight_d`, ..., `massWeight_bare` : the mass weights `3 + 2 * n`.
- `fermionAlgebra` : the algebra generated by the ten fermion families and all their covariant
  derivatives.
- `derivSubmodule` : the submodule of `fieldData.LocalCovFieldAlgebra` generated by the fermion
  symbols carrying exactly `n` covariant derivatives.
- `anticomm_of_mem_derivSubmodule` : any two elements of the derivative submodules anticommute.

## iii. Table of contents

- A. The towers and actions on the covariant field algebra
- B. The laws of the towers
- C. The fermion-derivative submodules

## iv. References

* None.

-/

@[expose] public section

namespace StandardModel

open TensorProduct Matrix MatrixGroups Lorentz

namespace FermionSector

/-!

## A. The towers and actions on the covariant field algebra

-/

/-- The action of the global gauge group on the covariant field algebra. -/
noncomputable abbrev repGauge : Representation ℂ GaugeGroupI fieldData.LocalCovFieldAlgebra :=
  LocalCovFieldAlgebra.repGaugeGroupI

/-- The action of the Lorentz group on the covariant field algebra. -/
noncomputable abbrev repLorentz : Representation ℂ SL(2,ℂ) fieldData.LocalCovFieldAlgebra :=
  LocalCovFieldAlgebra.repLorentzGroup

/-- The mass-weight polynomial of the covariant field algebra. -/
noncomputable abbrev massWeightPoly :
    fieldData.LocalCovFieldAlgebra →ₐ[ℂ] Polynomial fieldData.LocalCovFieldAlgebra :=
  LocalCovFieldAlgebra.massWeightPoly

/-- The global gauge action on the covariant field algebra is multiplicative. -/
lemma repGauge_mul (g : GaugeGroupI) (b₁ b₂ : fieldData.LocalCovFieldAlgebra) :
    repGauge g (b₁ * b₂) = repGauge g b₁ * repGauge g b₂ :=
  LocalCovFieldAlgebra.repGaugeGroupI_mul g b₁ b₂

/-- The Lorentz action on the covariant field algebra is multiplicative. -/
lemma repLorentz_mul (Λ : SL(2,ℂ)) (b₁ b₂ : fieldData.LocalCovFieldAlgebra) :
    repLorentz Λ (b₁ * b₂) = repLorentz Λ b₁ * repLorentz Λ b₂ :=
  LocalCovFieldAlgebra.repLorentzGroup_mul Λ b₁ b₂

/-- The tower of the species `d`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev d : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ DownSinglet →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.downSingletField i l

/-- The tower of the species `bard`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev bard : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ (ConjModule DownSinglet) →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.conjDownSingletField i l

/-- The tower of the species `u`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev u : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ UpSinglet →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.upSingletField i l

/-- The tower of the species `baru`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev baru : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ (ConjModule UpSinglet) →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.conjUpSingletField i l

/-- The tower of the species `Q`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev Q : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ QuarkDoublet →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.quarkDoubletField i l

/-- The tower of the species `barQ`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev barQ : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ (ConjModule QuarkDoublet) →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.conjQuarkDoubletField i l

/-- The tower of the species `L`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev L : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ LeptonDoubletV →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.leptonDoubletField i l

/-- The tower of the species `barL`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev barL : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ (ConjModule LeptonDoubletV) →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.conjLeptonDoubletField i l

/-- The tower of the species `e`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev e : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ LeptonSinglet →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.leptonSingletField i l

/-- The tower of the species `bare`, with its covariant derivatives, in the covariant field
  algebra. -/
noncomputable abbrev bare : {n : ℕ} → Fin 3 → (Fin n → Fin 1 ⊕ Fin 3) →
    Module.Dual ℂ (ConjModule LeptonSinglet) →ₗ[ℂ] fieldData.LocalCovFieldAlgebra :=
  fun {_n} i l => LocalCovFieldAlgebra.conjLeptonSingletField i l

/-!

## B. The laws of the towers

-/

/-- Gauge transformation of the `d` tower, through the dual of the species representation. -/
lemma repGauge_d (g : GaugeGroupI) (i : Fin 3) {n : ℕ}
    (l : Fin n → Fin 1 ⊕ Fin 3) (φ : Module.Dual ℂ DownSinglet) :
    repGauge g (d i l φ) = d i l (DownSinglet.repGaugeGroupI.dual g φ) :=
  LocalCovFieldAlgebra.repGaugeGroupI_downSingletField g i l φ

/-- Gauge transformation of the `bard` tower, through the dual of the species representation. -/
lemma repGauge_bard (g : GaugeGroupI) (i : Fin 3) {n : ℕ}
    (l : Fin n → Fin 1 ⊕ Fin 3) (φ : Module.Dual ℂ (ConjModule DownSinglet)) :
    repGauge g (bard i l φ) = bard i l (DownSinglet.repGaugeGroupI.conj.dual g φ) :=
  LocalCovFieldAlgebra.repGaugeGroupI_conjDownSingletField g i l φ

/-- Gauge transformation of the `u` tower, through the dual of the species representation. -/

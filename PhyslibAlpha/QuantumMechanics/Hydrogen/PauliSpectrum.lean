/-!
# Pauli's algebraic derivation of the hydrogen spectrum

## i. Overview

Pauli (1926) obtained the bound-state energies of the hydrogen atom from the commutation
relations of the angular momentum `L`, the Laplace-Runge-Lenz vector `A` and the Hamiltonian
`H` alone. On an eigenspace of `H` with eigenvalue `E < 0` the rescaled vector
`K = A / √(-2mE)` makes `J = (L + K) / 2` a copy of `su(2)` (and likewise `(L - K) / 2`).
By `L · A = 0` and the relation for `A²`, its Casimir is the scalar
`J² = -(ℏ² + m k² / (2E)) / 4`. Comparing with the Casimir `ℏ² j(j+1)` of `su(2)` gives
`E = -m k² / (2 ℏ² n²)` with `n = 2j + 1`.

This file formulates the argument abstractly, independently of any functional analysis: the
operators live on an arbitrary complex vector space and are only required to satisfy the
relations of `Physlib/QuantumMechanics/Hydrogen/LaplaceRungeLenzVector.lean` at `ε → 0`,
in dimension `d = 3` (with `Lᵢ = ½ εᵢⱼₖ Lⱼₖ`).

## ii. Key results

- `PauliSystem` : operators `L`, `A`, `H` with the hydrogen commutation relations.
- `PauliSystem.exists_energyLevel` : every nonzero finite-dimensional eigenspace of `H` with
  eigenvalue `E < 0` has `E` equal to a Bohr level.

## iii. Table of contents

- A. The abstract Pauli system
- B. The `su(2)` generated by `L` and `K`
- C. The Bohr levels

## iv. References

- W. Pauli, *Über das Wasserstoffspektrum vom Standpunkt der neuen Quantenmechanik*,
  Z. Phys. 36 (1926), 336–363, doi:10.1007/BF01450175.
-/

@[expose] public section

noncomputable section

namespace PhyslibAlpha.Hydrogen

open QuantumMechanics Constants PhyslibAlpha

attribute [local instance 100] LieRing.ofAssociativeRing

/-!

## A. The abstract Pauli system

Components are indexed by `Fin 3`, and the cross-product relations are stated cyclically for
the triples `(i, i + 1, i + 2)`.

-/

variable (V : Type*) [AddCommGroup V] [Module ℂ V]

/-- Pauli's abstract hydrogen system for a hydrogen atom `Hy` in three dimensions: angular
momentum `L`, Laplace-Runge-Lenz vector `A` and Hamiltonian `H` on a complex vector space `V`,
satisfying the commutation relations of the hydrogen operators (with `ε → 0`). -/
structure PauliSystem (Hy : HydrogenAtom 3) where
  /-- The angular momentum components `Lᵢ`. -/
  L : Fin 3 → Module.End ℂ V
  /-- The Laplace-Runge-Lenz components `Aᵢ`. -/
  A : Fin 3 → Module.End ℂ V
  /-- The Hamiltonian. -/
  H : Module.End ℂ V
  /-- `[Lᵢ, Lᵢ₊₁] = iℏ Lᵢ₊₂`. -/
  comm_L_L : ∀ i, ⁅L i, L (i + 1)⁆ = (Complex.I * (ℏ : ℝ)) • L (i + 2)
  /-- `[Lᵢ, Aᵢ] = 0`. -/
  comm_L_A_self : ∀ i, ⁅L i, A i⁆ = 0
  /-- `[Lᵢ, Aᵢ₊₁] = iℏ Aᵢ₊₂`. -/
  comm_L_A_succ : ∀ i, ⁅L i, A (i + 1)⁆ = (Complex.I * (ℏ : ℝ)) • A (i + 2)
  /-- `[Lᵢ₊₁, Aᵢ] = -iℏ Aᵢ₊₂`. -/
  comm_L_A_pred : ∀ i, ⁅L (i + 1), A i⁆ = -((Complex.I * (ℏ : ℝ)) • A (i + 2))
  /-- `[Aᵢ, Aᵢ₊₁] = -2iℏm H Lᵢ₊₂`. -/
  comm_A_A : ∀ i, ⁅A i, A (i + 1)⁆ = (-2 * Complex.I * (ℏ : ℝ) * Hy.m) • (H * L (i + 2))
  /-- `[H, Lᵢ] = 0`. -/
  comm_H_L : ∀ i, ⁅H, L i⁆ = 0
  /-- `[H, Aᵢ] = 0`. -/
  comm_H_A : ∀ i, ⁅H, A i⁆ = 0
  /-- `A² = 2mH(L² + ℏ²) + m²k²`. -/
  A_sq : ∑ i, A i * A i =
    (2 * Hy.m : ℂ) • (H * (∑ i, L i * L i + ((ℏ : ℝ) ^ 2 : ℂ) • 1)) +
      ((Hy.m : ℂ) ^ 2 * (Hy.k : ℂ) ^ 2) • 1
  /-- `L · A = 0`. -/
  L_dot_A : ∑ i, L i * A i = 0

namespace PauliSystem

variable {V} {Hy : HydrogenAtom 3}

/-!

## B. The `su(2)` generated by `L` and `K`

On a space where `H = E` with `E < 0`, let `κ² = -2mE`, `Kᵢ = Aᵢ / κ` and
`Jᵢ = (Lᵢ + Kᵢ) / (2ℏ)`. The `Jᵢ` satisfy the angular momentum relations (without `ℏ`), and
`J² = (-ℏ² - m k² / (2E)) / (4ℏ²)` is a scalar by `L · A = 0` and the relation for `A²`.
The two square roots `±√(-2mE)` give `J₊ = (L + K) / (2ℏ)` and `J₋ = (L - K) / (2ℏ)`.

-/

/-- The rescaling `κ = √(-2mE)` of the Laplace-Runge-Lenz vector at energy `E`. -/
def kappa (Hy : HydrogenAtom 3) (E : ℝ) : ℂ := (Real.sqrt (-2 * Hy.m * E) : ℝ)

/-- `κ² = -2mE` for `E < 0`. -/
lemma kappa_sq {E : ℝ} (hE : E < 0) : kappa Hy E ^ 2 = -2 * Hy.m * E := by
  have hx : 0 ≤ -2 * Hy.m * E := by nlinarith [Hy.m_pos]
  rw [kappa, ← Complex.ofReal_pow, Real.sq_sqrt hx]
  push_cast
  ring

/-- `κ ≠ 0` for `E < 0`. -/
lemma kappa_ne_zero {E : ℝ} (hE : E < 0) : kappa Hy E ≠ 0 := by
  rw [kappa, ne_eq, Complex.ofReal_eq_zero, Real.sqrt_eq_zero', not_le]
  nlinarith [Hy.m_pos]

/-- A square root `κ` of `-2mE` is nonzero for `E < 0`. -/
lemma ne_zero_of_sq_eq {E : ℝ} (hE : E < 0) {κ : ℂ} (hκ2 : κ ^ 2 = -2 * Hy.m * E) : κ ≠ 0 := by
  rintro rfl
  have hm : (Hy.m : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Hy.m_pos.ne'
  have hE0 : (E : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hE.ne
  have : (-2 * Hy.m * E : ℂ) ≠ 0 := by simp [hm, hE0]
  exact this (by rw [← hκ2]; ring)

/-- The components `Jᵢ = (Lᵢ + Aᵢ / κ) / (2ℏ)`. -/
def J (P : PauliSystem V Hy) (κ : ℂ) (i : Fin 3) : Module.End ℂ V :=
  (2 * ((ℏ : ℝ) : ℂ))⁻¹ • (P.L i + κ⁻¹ • P.A i)

/-- `[Jᵢ, Jᵢ₊₁] = i Jᵢ₊₂` on a space where `H = E < 0`, for `κ² = -2mE`. -/
lemma comm_J (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0) {κ : ℂ}
    (hκ2 : κ ^ 2 = -2 * Hy.m * E) (hH : P.H = (E : ℂ) • 1) (i : Fin 3) :
    ⁅P.J κ i, P.J κ (i + 1)⁆ = Complex.I • P.J κ (i + 2) := by
  have hκ := ne_zero_of_sq_eq hE hκ2
  have hℏ : ((ℏ : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ℏ_pos.ne'
  have hAL : ⁅P.A i, P.L (i + 1)⁆ = (Complex.I * (ℏ : ℝ)) • P.A (i + 2) := by
    rw [← lie_skew, P.comm_L_A_pred, neg_neg]
  have hAA : ⁅P.A i, P.A (i + 1)⁆ = (-2 * Complex.I * (ℏ : ℝ) * Hy.m * E) • P.L (i + 2) := by
    rw [P.comm_A_A, hH, smul_mul_assoc, one_mul, smul_smul]
  simp only [J, lie_smul, smul_lie, add_lie, lie_add, P.comm_L_L, P.comm_L_A_succ, hAL, hAA]
  match_scalars
  · rw [show (-2 * Complex.I * ((ℏ : ℝ) : ℂ) * Hy.m * E) =
      Complex.I * ((ℏ : ℝ) : ℂ) * κ ^ 2 by rw [hκ2]; ring]
    field_simp
    ring
  · field_simp
    ring

/-- The angular momentum representation `J = (L + A / κ) / (2ℏ)` for `κ² = -2mE`. -/
def rep (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0) {κ : ℂ} (hκ2 : κ ^ 2 = -2 * Hy.m * E)
    (hH : P.H = (E : ℂ) • 1) : Sl2.AngularMomentumRepresentation V where
  Jx := P.J κ 0
  Jy := P.J κ 1
  Jz := P.J κ 2
  comm_xy := P.comm_J hE hκ2 hH 0
  comm_yz := P.comm_J hE hκ2 hH 1
  comm_zx := P.comm_J hE hκ2 hH 2

/-- `J² = (-ℏ² - m k² / (2E)) / (4ℏ²)` on a space where `H = E < 0`, for `κ² = -2mE`. -/
lemma rep_Jsq (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0) {κ : ℂ}
    (hκ2 : κ ^ 2 = -2 * Hy.m * E) (hH : P.H = (E : ℂ) • 1) :
    (P.rep hE hκ2 hH).Jsq = ((2 * ((ℏ : ℝ) : ℂ))⁻¹ ^ 2 *
      (-((ℏ : ℝ) : ℂ) ^ 2 - Hy.m * Hy.k ^ 2 / (2 * E))) • 1 := by
  have hκ := ne_zero_of_sq_eq hE hκ2
  have hℏ : ((ℏ : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ℏ_pos.ne'
  have hm : (Hy.m : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Hy.m_pos.ne'
  have hJJ : ∀ i, P.J κ i * P.J κ i = (2 * ((ℏ : ℝ) : ℂ))⁻¹ ^ 2 •
      (P.L i * P.L i + (2 * κ⁻¹) • (P.L i * P.A i) + κ⁻¹ ^ 2 • (P.A i * P.A i)) := by
    intro i
    have hAL : P.A i * P.L i = P.L i * P.A i := by
      simpa using (Sl2.AngularMomentumRepresentation.mul_eq_of_lie_eq (P.comm_L_A_self i)).symm
    simp only [J, add_mul, mul_add, smul_mul_assoc, mul_smul_comm, hAL]
    module
  have hA := P.A_sq
  have hLA := P.L_dot_A
  rw [hH, smul_mul_assoc, one_mul] at hA
  simp only [Fin.sum_univ_three] at hA hLA
  simp only [Sl2.AngularMomentumRepresentation.Jsq, rep, hJJ]
  linear_combination (norm := skip)
    ((2 * ((ℏ : ℝ) : ℂ))⁻¹ ^ 2 * κ⁻¹ ^ 2) • hA +
      ((2 * ((ℏ : ℝ) : ℂ))⁻¹ ^ 2 * (2 * κ⁻¹)) • hLA
  have hEκ : (E : ℂ) = -κ ^ 2 / (2 * Hy.m) := by
    field_simp
    linear_combination hκ2
  match_scalars <;>
  · try simp only [hEκ]
    field_simp
    ring

/-- The angular momentum representation `J₊ = (L + K) / (2ℏ)`, with `K = A / κ`. -/
def plusRep (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0) (hH : P.H = (E : ℂ) • 1) :
    Sl2.AngularMomentumRepresentation V :=
  P.rep hE (kappa_sq hE) hH

/-- The angular momentum representation `J₋ = (L - K) / (2ℏ)`, with `K = A / κ`. -/
def minusRep (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0) (hH : P.H = (E : ℂ) • 1) :
    Sl2.AngularMomentumRepresentation V :=
  P.rep hE (κ := -kappa Hy E) (by rw [neg_sq, kappa_sq hE]) hH

/-- `J₊² = (-ℏ² - m k² / (2E)) / (4ℏ²)` on a space where `H = E < 0`. -/
lemma plusRep_Jsq (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0) (hH : P.H = (E : ℂ) • 1) :
    (P.plusRep hE hH).Jsq = ((2 * ((ℏ : ℝ) : ℂ))⁻¹ ^ 2 *
      (-((ℏ : ℝ) : ℂ) ^ 2 - Hy.m * Hy.k ^ 2 / (2 * E))) • 1 :=
  P.rep_Jsq hE _ hH

/-- `J₋² = J₊²`: both are `(-ℏ² - m k² / (2E)) / (4ℏ²)` on a space where `H = E < 0`. -/
lemma minusRep_Jsq (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0) (hH : P.H = (E : ℂ) • 1) :
    (P.minusRep hE hH).Jsq = ((2 * ((ℏ : ℝ) : ℂ))⁻¹ ^ 2 *
      (-((ℏ : ℝ) : ℂ) ^ 2 - Hy.m * Hy.k ^ 2 / (2 * E))) • 1 :=
  P.rep_Jsq hE _ hH

/-!

## C. The Bohr levels

-/

/-- On a nonzero finite-dimensional space `J²` has an eigenvalue `j(j+1)` with `2j ∈ ℕ`. -/
lemma _root_.PhyslibAlpha.Sl2.AngularMomentumRepresentation.exists_Jsq_eigenvector
    [FiniteDimensional ℂ V] [Nontrivial V] (ρ : Sl2.AngularMomentumRepresentation V) :
    ∃ (n : ℕ) (v : V), v ≠ 0 ∧ ρ.Jsq v = ((n : ℂ) / 2 * ((n : ℂ) / 2 + 1)) • v := by
  by_cases hz : ρ.Jz = 0
  · obtain ⟨v, hv⟩ := exists_ne (0 : V)
    exact ⟨0, v, hv, by simp [ρ.Jsq_eq_zero_of_Jz_eq_zero hz]⟩
  · obtain ⟨μ, v, hv, Pv⟩ := (ρ.isSl2Triple hz).exists_hasPrimitiveVectorWith (R := ℂ) (M := V)
    obtain ⟨n, rfl⟩ := Pv.exists_nat
    exact ⟨n, v, hv, ρ.Jsq_on_primitive hz Pv⟩

/-- Pauli's theorem on a nonzero finite-dimensional space on which `H = E < 0`. -/
lemma exists_energyLevel_of_H_eq [FiniteDimensional ℂ V] [Nontrivial V]
    (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0) (hH : P.H = (E : ℂ) • 1) :
    ∃ n : ℕ, E = Hy.energyLevel n := by
  obtain ⟨n, v, hv, hJv⟩ := (P.plusRep hE hH).exists_Jsq_eigenvector
  rw [P.plusRep_Jsq hE hH, LinearMap.smul_apply, Module.End.one_apply] at hJv
  have hc := smul_left_injective ℂ hv hJv
  refine ⟨n, Complex.ofReal_injective ?_⟩
  have hℏ : ((ℏ : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ℏ_pos.ne'
  have hE0 : (E : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hE.ne
  simp only [HydrogenAtom.energyLevel_eq, HydrogenAtom.levelIndex_eq,
    HydrogenAtom.rydbergEnergy_eq]
  push_cast
  have hn : (n : ℂ) + 1 ≠ 0 := by exact_mod_cast n.succ_ne_zero
  rw [show (n : ℂ) + (3 - 1) / 2 = n + 1 by ring]
  field_simp at hc ⊢
  linear_combination -hc

/-- Operators commuting with `H` preserve its eigenspaces. -/
lemma mapsTo_eigenspace (P : PauliSystem V Hy) {T : Module.End ℂ V} (hT : ⁅P.H, T⁆ = 0)
    (μ : ℂ) : Set.MapsTo T (P.H.eigenspace μ) (P.H.eigenspace μ) := by
  intro x hx
  simp only [SetLike.mem_coe, Module.End.mem_eigenspace_iff] at hx ⊢
  have h := congr($(Sl2.AngularMomentumRepresentation.mul_eq_of_lie_eq hT) x)
  simp only [Module.End.mul_apply, add_zero] at h
  rw [h, hx, map_smul]

/-- The restriction of a Pauli system to an eigenspace of `H`. -/
def restrictEigenspace (P : PauliSystem V Hy) (μ : ℂ) :
    PauliSystem (P.H.eigenspace μ) Hy where
  L i := (P.L i).restrict (P.mapsTo_eigenspace (P.comm_H_L i) μ)
  A i := (P.A i).restrict (P.mapsTo_eigenspace (P.comm_H_A i) μ)
  H := P.H.restrict (P.mapsTo_eigenspace (lie_self P.H) μ)
  comm_L_L i := by
    ext x
    exact congr($(P.comm_L_L i) (x : V))
  comm_L_A_self i := by
    ext x
    exact congr($(P.comm_L_A_self i) (x : V))
  comm_L_A_succ i := by
    ext x
    exact congr($(P.comm_L_A_succ i) (x : V))
  comm_L_A_pred i := by
    ext x
    exact congr($(P.comm_L_A_pred i) (x : V))
  comm_A_A i := by
    ext x
    exact congr($(P.comm_A_A i) (x : V))
  comm_H_L i := by
    ext x
    exact congr($(P.comm_H_L i) (x : V))
  comm_H_A i := by
    ext x
    exact congr($(P.comm_H_A i) (x : V))
  A_sq := by
    ext x
    exact congr($(P.A_sq) (x : V))
  L_dot_A := by
    ext x
    exact congr($(P.L_dot_A) (x : V))

/-- **Pauli's theorem.** Every nonzero finite-dimensional eigenspace of the Hamiltonian with
negative eigenvalue `E` has `E` equal to a Bohr level `-m k² / (2 ℏ² n²)`. -/
theorem exists_energyLevel (P : PauliSystem V Hy) {E : ℝ} (hE : E < 0)
    [FiniteDimensional ℂ (P.H.eigenspace (E : ℂ))] (hne : P.H.eigenspace (E : ℂ) ≠ ⊥) :
    ∃ n : ℕ, E = Hy.energyLevel n := by
  have : Nontrivial (P.H.eigenspace (E : ℂ)) := Submodule.nontrivial_iff_ne_bot.mpr hne
  refine (P.restrictEigenspace E).exists_energyLevel_of_H_eq hE ?_
  ext x
  exact Module.End.mem_eigenspace_iff.mp x.2

end PauliSystem

end PhyslibAlpha.Hydrogen

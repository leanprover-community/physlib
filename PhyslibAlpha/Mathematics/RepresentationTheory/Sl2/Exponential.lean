/-!
# Generation of SL(2, ℂ) by exponentials

Every `2 × 2` complex matrix of determinant one is a product of exponentials of traceless
matrices.

## i. Overview

A continuous representation of `SL(2, ℂ)` is determined by its derivative once the group is
known to be generated by exponentials. Every matrix of determinant one is a product of
transvections and a diagonal matrix of determinant one (`Matrix.diagonal_transvection_induction`),
and each of these is the exponential of a traceless matrix. A transvection `1 + c E_{ij}` is
`exp (c E_{ij})`, since `E_{ij}` squares to zero, and a diagonal matrix `diag(z, z⁻¹)` is
`exp (diag(log z, -log z))`. Alongside, the exponential of an operator fixes every vector the
operator kills, and so does any one-parameter group of operators whose derivative at the identity
kills the vector.

## ii. Key results

- `NormedSpace.exp_eq_one_add_of_mul_self_eq_zero` : the exponential of a square-zero element.
- `ContinuousLinearMap.exp_apply_of_apply_eq_zero` : the exponential of an operator fixes the
  vectors it kills.
- `Module.Basis.apply_eq_self_of_hasDerivAt_repr` : a one-parameter group of operators fixes the
  vectors its derivative kills.
- `Matrix.mem_closure_exp_of_det_eq_one` : every `2 × 2` matrix of determinant one is a product
  of exponentials of traceless matrices.

## iii. Table of contents

- A. Exponentials fixing vectors
- B. Generation of SL(2, ℂ) by exponentials

## iv. References

- B. C. Hall, *Lie Groups, Lie Algebras, and Representations*, 2nd ed., Springer (2015).

-/

@[expose] public section

open Matrix NormedSpace

/-!

## A. Exponentials fixing vectors

-/

namespace NormedSpace

/-- The exponential of a square-zero element of a topological algebra is `1 + N`. -/
lemma exp_eq_one_add_of_mul_self_eq_zero {𝔸 : Type*} [Ring 𝔸] [Algebra ℂ 𝔸] [TopologicalSpace 𝔸]
    [IsTopologicalRing 𝔸] {N : 𝔸} (hN : N * N = 0) : exp N = 1 + N := by
  rw [congrFun (exp_eq_tsum ℂ) N, tsum_eq_sum (s := Finset.range 2)]
  · simp [Finset.sum_range_succ]
  · intro n hn
    simp only [Finset.mem_range, not_lt] at hn
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hn
    rw [pow_add, sq, hN, zero_mul, smul_zero]

end NormedSpace

namespace ContinuousLinearMap

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E] [CompleteSpace E]

/-- The exponential of an operator fixes every vector killed by the operator. -/
lemma exp_apply_of_apply_eq_zero {A : E →L[ℂ] E} {w : E} (hw : A w = 0) : exp A w = w := by
  rw [congrFun (exp_eq_tsum ℂ) A]
  change apply ℂ E w (∑' n : ℕ, ((n.factorial : ℂ)⁻¹) • A ^ n) = w
  rw [ContinuousLinearMap.map_tsum _ (expSeries_summable' A), tsum_eq_single 0]
  · simp
  · intro n hn
    obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
    simp [pow_succ, hw]

end ContinuousLinearMap

namespace Module.Basis

variable {V ι : Type*} [AddCommGroup V] [Module ℂ V] [Fintype ι] [DecidableEq ι]

/-- A one-parameter group of operators `F s` fixes every vector whose coordinates along the group
  have derivative zero at the identity. By the group law the coordinates then have derivative zero
  everywhere, so they are constant. -/
lemma apply_eq_self_of_hasDerivAt_repr (b : Module.Basis ι ℂ V) {F : ℝ → V →ₗ[ℂ] V}
    (hF : ∀ s h, F (s + h) = F s ∘ₗ F h) (hF0 : F 0 = LinearMap.id) {v : V}
    (hv : ∀ i, HasDerivAt (fun h => b.repr (F h v) i) 0 0) (s : ℝ) : F s v = v := by
  refine b.ext_elem fun i => ?_
  have hd (x : ℝ) : HasDerivAt (fun s => b.repr (F s v) i) 0 x := by
    have h := HasDerivAt.fun_sum (u := Finset.univ) fun j _ =>
      (HasDerivAt.comp_sub_const x x (by rw [sub_self]; exact hv j)).const_mul
        (LinearMap.toMatrix b b (F x) i j)
    simp only [mul_zero, Finset.sum_const_zero] at h
    refine h.congr_of_eventuallyEq (Filter.Eventually.of_forall fun s => ?_)
    have hs : F s v = F x (F (s - x) v) := by
      rw [← LinearMap.comp_apply, ← hF, add_sub_cancel]
    simp only [hs, ← LinearMap.toMatrix_mulVec_repr b b (F x), Matrix.mulVec, dotProduct]
  have h := is_const_of_deriv_eq_zero (fun x => (hd x).differentiableAt) (fun x => (hd x).deriv) s 0
  rw [h, hF0, LinearMap.id_apply]

end Module.Basis

/-!

## B. Generation of SL(2, ℂ) by exponentials

-/

namespace Matrix

/-- A transvection is the exponential of a traceless matrix. -/
lemma exists_trace_eq_zero_exp_eq_transvection {n : Type*} [Fintype n] [DecidableEq n]
    (t : TransvectionStruct n ℂ) : ∃ X : Matrix n n ℂ, X.trace = 0 ∧ exp X = t.toMatrix := by
  refine ⟨single t.i t.j t.c, trace_single_eq_of_ne _ _ _ t.hij, ?_⟩
  rw [NormedSpace.exp_eq_one_add_of_mul_self_eq_zero (single_mul_single_of_ne (h := t.hij.symm) ..)]
  rfl

/-- A diagonal `2 × 2` matrix of determinant one is the exponential of a traceless diagonal
matrix. -/
lemma exists_trace_eq_zero_exp_eq_diagonal {D : Fin 2 → ℂ} (hD : (diagonal D).det = 1) :
    ∃ X : Matrix (Fin 2) (Fin 2) ℂ, X.trace = 0 ∧ exp X = diagonal D := by
  rw [det_diagonal, Fin.prod_univ_two] at hD
  have h0 : D 0 ≠ 0 := left_ne_zero_of_mul_eq_one hD
  refine ⟨diagonal ![Complex.log (D 0), -Complex.log (D 0)], by simp, ?_⟩
  rw [exp_diagonal]
  congr 1
  ext i
  fin_cases i
  · simp [← Complex.exp_eq_exp_ℂ, Complex.exp_log h0]
  · simp [← Complex.exp_eq_exp_ℂ, Complex.exp_neg, Complex.exp_log h0]
    exact (eq_inv_of_mul_eq_one_right hD).symm

/-- Every `2 × 2` complex matrix of determinant one is a product of exponentials of traceless
matrices. -/
lemma mem_closure_exp_of_det_eq_one {M : Matrix (Fin 2) (Fin 2) ℂ} (hM : M.det = 1) :
    M ∈ Submonoid.closure {A | ∃ X : Matrix (Fin 2) (Fin 2) ℂ, X.trace = 0 ∧ exp X = A} := by
  refine diagonal_transvection_induction (· ∈ Submonoid.closure _) M (fun D hD => ?_)
    (fun t => Submonoid.subset_closure (exists_trace_eq_zero_exp_eq_transvection t))
    (fun _ _ => mul_mem)
  exact Submonoid.subset_closure (exists_trace_eq_zero_exp_eq_diagonal (hD.trans hM))

end Matrix

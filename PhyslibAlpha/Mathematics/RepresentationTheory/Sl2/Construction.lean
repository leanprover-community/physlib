/-!
# Explicit standard sl₂ modules

Builds the finite-dimensional standard module `V(n)` and the actions of an `sl₂` triple.

## i. Overview

The standard highest-weight module of weight `n` has underlying space `Fin (n + 1) → K`.
Explicit endomorphisms act on its coordinate vectors by the usual `sl₂` raising, lowering,
and weight formulas. The bracket relations extend this action from the three generators to
the Lie subalgebra generated by any `IsSl2Triple`.

## ii. Key results

- `StandardSl2Module` and its coordinate vectors give the underlying vector space.
- `ρE`, `ρF`, and `ρH` are the standard raising, lowering, and weight operators.
- `Φ` maps a generated `sl₂` subalgebra to the endomorphisms of the standard module.

## iii. Table of contents

- A. The standard module

## iv. References

- Mathlib, `Mathlib.Algebra.Lie.Sl2`.

## A. The standard module
-/

@[expose] public section

noncomputable section

namespace PhyslibAlpha.Sl2

open Module (Basis)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- Standard module `V(n)`, underlying carrier.
An `(n+1)`-dimensional `K`-vector space with standard basis `v_0, …, v_n`. -/
@[reducible] def StandardSl2Module (K : Type*) (n : ℕ) : Type _ := Fin (n + 1) → K

variable {K : Type*} [Field K] {n : ℕ}

instance : AddCommGroup (StandardSl2Module K n) :=
  inferInstanceAs (AddCommGroup (Fin (n + 1) → K))

instance : Module K (StandardSl2Module K n) :=
  inferInstanceAs (Module K (Fin (n + 1) → K))

/-- The standard basis vector `v_k` of `StandardSl2Module K n`. -/
def StandardSl2Module.v (k : Fin (n + 1)) : StandardSl2Module K n :=
  Pi.single k 1

variable {L : Type*} [LieRing L] [LieAlgebra K L] {h e f : L}
variable [CharZero K] {t : IsSl2Triple h e f}

omit [CharZero K] in
/-- The three generators are eigenvectors of the adjoint action of `h`. -/
lemma generators_eigenvectors (t : IsSl2Triple h e f) (i : Fin 3) :
    (LieModule.toEnd K L L h).HasEigenvector (![(2 : K), -2, 0] i) (![e, f, h] i) := by
  have he : (LieModule.toEnd K L L h).HasEigenvector (2 : K) e := by
    refine ⟨?_, t.e_ne_zero⟩
    simpa [Module.End.mem_eigenspace_iff, LieModule.toEnd_apply_apply] using t.lie_h_e_smul K
  have hf : (LieModule.toEnd K L L h).HasEigenvector (-2 : K) f := by
    refine ⟨?_, t.f_ne_zero⟩
    rw [Module.End.mem_eigenspace_iff, LieModule.toEnd_apply_apply, t.lie_lie_smul_f K]
    module
  have hh : (LieModule.toEnd K L L h).HasEigenvector (0 : K) h := by
    refine ⟨?_, t.h_ne_zero⟩
    simp [LieModule.toEnd_apply_apply, lie_self]
  fin_cases i <;> first | simpa using he | simpa using hf | simpa using hh

/-- The generators of an `sl₂` triple are linearly independent. -/
lemma linearIndependent_efh (t : IsSl2Triple h e f) :
    LinearIndependent K ![e, f, h] := by
  have hinj : Function.Injective (![(2 : K), -2, 0]) := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp at hij <;>
      first
      | rfl
      | (exfalso; norm_num at hij)
  exact (LieModule.toEnd K L L h).eigenvectors_linearIndependent'
    ![(2 : K), -2, 0] hinj ![e, f, h] (generators_eigenvectors t)

omit [CharZero K] in
lemma span_efh_eq (t : IsSl2Triple h e f) :
    Submodule.span K (Set.range ![e, f, h]) = (t.toLieSubalgebra (R := K)).toSubmodule := by
  rw [IsSl2Triple.toLieSubalgebra]
  congr 1
  ext x
  simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩; fin_cases i <;> simp
  · rintro (rfl | rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩
    · exact ⟨2, rfl⟩

/-- The generators `(e,f,h)`, as elements of the subalgebra subtype. -/
def efhSub (t : IsSl2Triple h e f) : Fin 3 → ↥(t.toLieSubalgebra (R := K)) := fun i =>
  ⟨![e, f, h] i, by
    rw [← LieSubalgebra.mem_toSubmodule, ← span_efh_eq t]
    exact Submodule.subset_span (Set.mem_range_self i)⟩

/-- The generators `(e,f,h)` are linearly independent in the subalgebra. -/
lemma linearIndependent_efhSub (t : IsSl2Triple h e f) :
    LinearIndependent K (efhSub (K := K) t) :=
  LinearIndependent.of_comp (t.toLieSubalgebra (R := K)).toSubmodule.subtype
    (show LinearIndependent K
        (⇑(t.toLieSubalgebra (R := K)).toSubmodule.subtype ∘ efhSub t) from
      linearIndependent_efh t)

omit [CharZero K] in
/-- The generators `(e,f,h)` span the subalgebra. -/
lemma efhSub_span_top (t : IsSl2Triple h e f) :
    ⊤ ≤ Submodule.span K (Set.range (efhSub (K := K) t)) := by
  intro x _
  have hx : (x : L) ∈ Submodule.span K (Set.range ![e, f, h]) := by
    rw [span_efh_eq t, LieSubalgebra.mem_toSubmodule]
    exact x.2
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hx
  rw [Submodule.mem_span_range_iff_exists_fun]
  refine ⟨c, ?_⟩
  ext
  push_cast
  simpa [efhSub] using hc

/-- A basis of the `sl₂`-subalgebra generated by `t`, given by `(e,f,h)`. -/
def subalgebraBasis (t : IsSl2Triple h e f) :
    Basis (Fin 3) K ↥(t.toLieSubalgebra (R := K)) :=
  Basis.mk (v := efhSub t) (linearIndependent_efhSub t) (efhSub_span_top t)

lemma subalgebraBasis_apply (t : IsSl2Triple h e f) (i : Fin 3) :
    (subalgebraBasis (K := K) t i : L) = ![e, f, h] i := by
  simp [subalgebraBasis, Basis.mk_apply, efhSub]

/-- `e` acting on `StandardSl2Module K n`: `ρE (v k) = (k(n-k+1)) • v (k-1)`, `ρE (v 0) = 0`.
As a per-component formula (component `k` of the output reads from input component `k+1`,
scaled by the coefficient attached to *that* input index): zero at `k = n` (nothing shifts
down into the top component), else `((k+1)(n-k)) • w (k+1)`. -/
def ρE : Module.End K (StandardSl2Module K n) where
  toFun w k := if hk : (k : ℕ) = n then 0
    else (((k : ℕ) + 1) * (n - (k : ℕ)) : K) * w ⟨(k : ℕ) + 1, by omega⟩
  map_add' x y := by funext k; simp; split_ifs <;> ring
  map_smul' c x := by funext k; simp; split_ifs <;> ring

/-- `f` acting on `StandardSl2Module K n`: `ρF (v k) = v (k+1)`, `ρF (v n) = 0`. -/
def ρF : Module.End K (StandardSl2Module K n) where
  toFun w k := if hk : (k : ℕ) = 0 then 0 else w ⟨(k : ℕ) - 1, by omega⟩
  map_add' x y := by funext k; simp only [Pi.add_apply]; split_ifs <;> ring
  map_smul' c x := by
    funext k; simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; split_ifs <;> ring

/-- `h` acting on `StandardSl2Module K n`: `ρH (v k) = (n - 2k) • v k`. -/
def ρH : Module.End K (StandardSl2Module K n) where
  toFun w k := ((n : K) - 2 * (k : ℕ)) * w k
  map_add' x y := by funext k; simp only [Pi.add_apply]; ring
  map_smul' c x := by funext k; simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]; ring

omit [CharZero K] in
lemma ρH_v (k : Fin (n + 1)) :
    (ρH : Module.End K (StandardSl2Module K n)) (StandardSl2Module.v k)
      = ((n : K) - 2 * (k : ℕ)) • StandardSl2Module.v k := by
  funext j
  simp only [ρH, LinearMap.coe_mk, AddHom.coe_mk, StandardSl2Module.v, Pi.single_apply,
    Pi.smul_apply, smul_eq_mul]
  split_ifs with hjk <;> simp_all

omit [CharZero K] in
lemma ρF_v_lt (k : Fin (n + 1)) (hk : (k : ℕ) < n) :
    (ρF : Module.End K (StandardSl2Module K n)) (StandardSl2Module.v k)
      = StandardSl2Module.v ⟨(k : ℕ) + 1, by omega⟩ := by
  funext j
  simp only [ρF, LinearMap.coe_mk, AddHom.coe_mk, StandardSl2Module.v, Pi.single_apply,
    Fin.ext_iff]
  split_ifs with hj hjk hjk <;> first | rfl | omega

omit [CharZero K] in
lemma ρF_v_last :
    (ρF : Module.End K (StandardSl2Module K n)) (StandardSl2Module.v (Fin.last n)) = 0 := by
  funext j
  simp only [ρF, LinearMap.coe_mk, AddHom.coe_mk, Pi.zero_apply]
  split_ifs with hj
  · rfl
  · simp only [StandardSl2Module.v, Pi.single_apply, Fin.ext_iff, Fin.val_last]
    rw [ite_eq_right]
    omega

lemma ρE_v_pos (k : Fin (n + 1)) (hk : 0 < (k : ℕ)) :
    (ρE : Module.End K (StandardSl2Module K n)) (StandardSl2Module.v k)
      = ((k : ℕ) * (n - (k : ℕ) + 1) : K) • StandardSl2Module.v ⟨(k : ℕ) - 1, by omega⟩ := by
  have hkn : (k : ℕ) ≤ n := Nat.lt_succ_iff.mp k.isLt
  funext j
  simp only [ρE, LinearMap.coe_mk, AddHom.coe_mk, StandardSl2Module.v, Pi.single_apply,
    Pi.smul_apply, smul_eq_mul, Fin.ext_iff]
  split_ifs with hj hjk hjk <;>
    first
    | (exfalso; omega)
    | (have hjk' : ((k : ℕ) : K) = ((j : ℕ) : K) + 1 := by exact_mod_cast hjk.symm
       rw [hjk']; ring)
    | ring

omit [CharZero K] in
lemma ρE_v_zero :
    (ρE : Module.End K (StandardSl2Module K n)) (StandardSl2Module.v ⟨0, Nat.succ_pos n⟩) = 0 := by
  funext j
  simp only [ρE, LinearMap.coe_mk, AddHom.coe_mk, Pi.zero_apply, StandardSl2Module.v,
    Pi.single_apply, Fin.ext_iff]
  split_ifs with hj hjk <;> first | rfl | (exfalso; omega) | ring

omit [CharZero K] in
/-- Casting a predecessor index into `K` subtracts one. -/
lemma cast_pred (j : Fin (n + 1)) (hj0 : (j : ℕ) ≠ 0) :
    (((j : ℕ) - 1 : ℕ) : K) = (j : K) - 1 := by
  rw [Nat.cast_sub (by omega : 1 ≤ (j : ℕ))]
  norm_num

/-- The successor of the predecessor index is the index itself. -/
lemma pred_succ_index (j : Fin (n + 1)) (hj0 : (j : ℕ) ≠ 0) :
    (⟨(j : ℕ) - 1 + 1, by omega⟩ : Fin (n + 1)) = j :=
  Fin.ext (by simp only; omega)

/-- The `sl₂` relations hold for `(ρH,ρE,ρF)` on `StandardSl2Module K n`: `[ρE,ρF]=ρH`,
`[ρH,ρE]=2ρE`, `[ρH,ρF]=-2ρF`. Checked componentwise on an arbitrary vector `w`: each
composite operator, evaluated at output index `j`, only ever reads `w j` itself (the
`E`/`F` shifts cancel), so the identity reduces to the coefficient computation already
recorded in the `ρ_v` lemmas' docstrings. -/
lemma rel_ef_last_zero (w : StandardSl2Module K n) (j : Fin (n + 1))
    (hjn : (j : ℕ) = n) (hj0 : (j : ℕ) = 0) :
    (((ρE * ρF - ρF * ρE : Module.End K (StandardSl2Module K n)) w) j) =
      (ρH : Module.End K (StandardSl2Module K n)) w j := by
  simp only [LinearMap.sub_apply, Module.End.mul_apply, ρE, ρF, ρH, LinearMap.coe_mk,
    AddHom.coe_mk, Pi.sub_apply]
  simp only [dite_eq_right (Nat.succ_ne_zero _), Nat.add_sub_cancel]
  rw [dite_eq_left hjn, dite_eq_left hj0]
  have hj0K : (j : K) = 0 := by exact_mod_cast hj0
  have hn0K : (n : K) = 0 := by exact_mod_cast (show n = 0 by omega)
  rw [hj0K, hn0K]
  ring

lemma rel_ef_last_pos (w : StandardSl2Module K n) (j : Fin (n + 1))
    (hjn : (j : ℕ) = n) (hj0 : (j : ℕ) ≠ 0) :
    (((ρE * ρF - ρF * ρE : Module.End K (StandardSl2Module K n)) w) j) =
      (ρH : Module.End K (StandardSl2Module K n)) w j := by
  simp only [LinearMap.sub_apply, Module.End.mul_apply, ρE, ρF, ρH, LinearMap.coe_mk,
    AddHom.coe_mk, Pi.sub_apply]
  simp only [dite_eq_right (Nat.succ_ne_zero _), Nat.add_sub_cancel]
  rw [dite_eq_left hjn]
  have h0 : ¬ ((j : ℕ) - 1 = n) := by omega
  rw [dite_eq_right hj0, dite_eq_right h0, pred_succ_index j hj0, cast_pred j hj0]
  have hjnK : (j : K) = (n : K) := by exact_mod_cast hjn
  rw [hjnK]
  ring

lemma rel_ef_first (w : StandardSl2Module K n) (j : Fin (n + 1))
    (hjn : (j : ℕ) ≠ n) (hj0 : (j : ℕ) = 0) :
    (((ρE * ρF - ρF * ρE : Module.End K (StandardSl2Module K n)) w) j) =
      (ρH : Module.End K (StandardSl2Module K n)) w j := by
  simp only [LinearMap.sub_apply, Module.End.mul_apply, ρE, ρF, ρH, LinearMap.coe_mk,
    AddHom.coe_mk, Pi.sub_apply]
  simp only [dite_eq_right (Nat.succ_ne_zero _), Nat.add_sub_cancel]
  rw [dite_eq_right hjn, dite_eq_left hj0]
  have hj0K : (j : K) = 0 := by exact_mod_cast hj0
  have hidx : w j = w (⟨0, Nat.succ_pos n⟩ : Fin (n + 1)) := by
    congr 1
    exact Fin.ext hj0
  rw [hj0K, hidx]
  ring

omit [CharZero K] in
lemma rel_ef_middle (w : StandardSl2Module K n) (j : Fin (n + 1))
    (hjn : (j : ℕ) ≠ n) (hj0 : (j : ℕ) ≠ 0) :
    (((ρE * ρF - ρF * ρE : Module.End K (StandardSl2Module K n)) w) j) =
      (ρH : Module.End K (StandardSl2Module K n)) w j := by
  simp only [LinearMap.sub_apply, Module.End.mul_apply, ρE, ρF, ρH, LinearMap.coe_mk,
    AddHom.coe_mk, Pi.sub_apply]
  simp only [dite_eq_right (Nat.succ_ne_zero _), Nat.add_sub_cancel]
  rw [dite_eq_right hjn]
  have hjn1 : ¬ ((j : ℕ) - 1 = n) := by omega
  rw [dite_eq_right hj0, dite_eq_right hjn1, pred_succ_index j hj0, cast_pred j hj0]
  ring

/-- The standard raising and lowering operators have commutator `ρH`. -/
lemma rel_ef :
    ⁅(ρE : Module.End K (StandardSl2Module K n)), (ρF : Module.End K (StandardSl2Module K n))⁆
      = ρH := by
  rw [LieRing.of_associative_ring_bracket]
  apply LinearMap.ext; intro w
  funext j
  by_cases hjn : (j : ℕ) = n
  · by_cases hj0 : (j : ℕ) = 0
    · exact rel_ef_last_zero w j hjn hj0
    · exact rel_ef_last_pos w j hjn hj0
  · by_cases hj0 : (j : ℕ) = 0
    · exact rel_ef_first w j hjn hj0
    · exact rel_ef_middle w j hjn hj0

omit [CharZero K] in
lemma rel_he :
    ⁅(ρH : Module.End K (StandardSl2Module K n)), (ρE : Module.End K (StandardSl2Module K n))⁆
      = (2 : K) • ρE := by
  rw [LieRing.of_associative_ring_bracket]
  apply LinearMap.ext; intro w
  funext j
  simp only [LinearMap.sub_apply, Module.End.mul_apply, LinearMap.smul_apply, Pi.smul_apply,
    smul_eq_mul, ρE, ρH, LinearMap.coe_mk, AddHom.coe_mk, Pi.sub_apply]
  by_cases hjn : (j : ℕ) = n
  · rw [dite_eq_left hjn, dite_eq_left hjn]; ring
  · rw [dite_eq_right hjn, dite_eq_right hjn]
    have hj1 : (((j : ℕ) + 1 : ℕ) : K) = (j : K) + 1 := by push_cast; ring
    rw [hj1]
    ring

omit [CharZero K] in
lemma rel_hf :
    ⁅(ρH : Module.End K (StandardSl2Module K n)), (ρF : Module.End K (StandardSl2Module K n))⁆
      = (-2 : K) • ρF := by
  rw [LieRing.of_associative_ring_bracket]
  apply LinearMap.ext; intro w
  funext j
  simp only [LinearMap.sub_apply, Module.End.mul_apply, LinearMap.smul_apply, Pi.smul_apply,
    smul_eq_mul, ρF, ρH, LinearMap.coe_mk, AddHom.coe_mk, Pi.sub_apply]
  by_cases hj0 : (j : ℕ) = 0
  · rw [dite_eq_left hj0, dite_eq_left hj0]; ring
  · rw [dite_eq_right hj0, dite_eq_right hj0, cast_pred j hj0]
    ring

omit [CharZero K] in
/-- Antisymmetry of the bracket on `Module.End K (StandardSl2Module K n)`, proved directly via
the associative-ring commutator rather than via the generic `lie_skew` (which does not
syntactically match brackets here, since Mathlib derives a `LieRing`/`Bracket` structure on an
endomorphism ring through more than one route). -/
lemma endLieSkew (a b : Module.End K (StandardSl2Module K n)) : ⁅a, b⁆ = -⁅b, a⁆ := by
  rw [LieRing.of_associative_ring_bracket, LieRing.of_associative_ring_bracket]
  noncomm_ring

omit [CharZero K] in
/-- Bilinearity of the bracket on `Module.End K (StandardSl2Module K n)`, proved directly via
the associative-ring commutator for the same reason as `endLieSkew`. -/
lemma endAddLie (a b c : Module.End K (StandardSl2Module K n)) :
    ⁅a + b, c⁆ = ⁅a, c⁆ + ⁅b, c⁆ := by
  simp only [LieRing.of_associative_ring_bracket, add_mul, mul_add]; abel

omit [CharZero K] in
lemma endLieAdd (a b c : Module.End K (StandardSl2Module K n)) :
    ⁅a, b + c⁆ = ⁅a, b⁆ + ⁅a, c⁆ := by
  simp only [LieRing.of_associative_ring_bracket, add_mul, mul_add]; abel

omit [CharZero K] in
lemma endSmulLie (r : K) (a b : Module.End K (StandardSl2Module K n)) :
    ⁅r • a, b⁆ = r • ⁅a, b⁆ := by
  simp only [LieRing.of_associative_ring_bracket, smul_sub, smul_mul_assoc, mul_smul_comm]

omit [CharZero K] in
lemma endLieSmul (r : K) (a b : Module.End K (StandardSl2Module K n)) :
    ⁅a, r • b⁆ = r • ⁅a, b⁆ := by
  simp only [LieRing.of_associative_ring_bracket, smul_sub, smul_mul_assoc, mul_smul_comm]

/-- The Lie-algebra homomorphism from the `sl₂`-subalgebra generated by `t` into
`Module.End K (StandardSl2Module K n)`, sending `e ↦ ρE`, `f ↦ ρF`, `h ↦ ρH`. Built by
transporting `![ρE,ρF,ρH]` along the basis `subalgebraBasis t`; the fact that it respects
brackets (`Φ_lie`, below) is checked on the generators via `rel_ef`/`rel_he`/`rel_hf` and
then extended to the whole subalgebra by bilinearity. -/
def Φ (t : IsSl2Triple h e f) :
    ↥(t.toLieSubalgebra (R := K)) →ₗ[K] Module.End K (StandardSl2Module K n) :=
  (subalgebraBasis t).constr K ![ρE, ρF, ρH]

lemma Φ_apply (t : IsSl2Triple h e f) (i : Fin 3) :
    Φ t (subalgebraBasis t i) = ![(ρE : Module.End K (StandardSl2Module K n)), ρF, ρH] i :=
  Basis.constr_basis _ _ _ _

/-- Transports a bracket identity among the generators `(e,f,h)` down to the corresponding
identity among the basis elements `subalgebraBasis t 0,1,2` of the subalgebra. -/
lemma lie_subalgebraBasis (t : IsSl2Triple h e f) (i j k : Fin 3) (c : K)
    (hc : ⁅![e, f, h] i, ![e, f, h] j⁆ = c • ![e, f, h] k) :
    ⁅subalgebraBasis (K := K) t i, subalgebraBasis (K := K) t j⁆
      = c • subalgebraBasis (K := K) t k := by
  apply Subtype.ext
  simp only [LieSubalgebra.coe_bracket, subalgebraBasis_apply, SetLike.val_smul]
  exact hc

lemma Φ_bracket_refl (t : IsSl2Triple h e f)
    (x : ↥(t.toLieSubalgebra (R := K))) :
    Φ (K := K) (n := n) t ⁅x, x⁆ = ⁅Φ (K := K) (n := n) t x, Φ (K := K) (n := n) t x⁆ := by
  simp [lie_self]

lemma Φ_bracket_swap (t : IsSl2Triple h e f)
    (x y : ↥(t.toLieSubalgebra (R := K)))
    (hxy : Φ (K := K) (n := n) t ⁅x, y⁆ = ⁅Φ (K := K) (n := n) t x, Φ (K := K) (n := n) t y⁆) :
    Φ (K := K) (n := n) t ⁅y, x⁆ = ⁅Φ (K := K) (n := n) t y, Φ (K := K) (n := n) t x⁆ := by
  rw [show ⁅y, x⁆ = -⁅x, y⁆ from (lie_skew y x).symm, map_neg, hxy]
  exact lie_skew (Φ (K := K) (n := n) t y) (Φ (K := K) (n := n) t x)

lemma Φ_bracket_ef (t : IsSl2Triple h e f) :
    Φ (K := K) (n := n) t
      ⁅subalgebraBasis (K := K) t 0, subalgebraBasis (K := K) t 1⁆ =
        ⁅Φ (K := K) (n := n) t (subalgebraBasis (K := K) t 0),
          Φ (K := K) (n := n) t (subalgebraBasis (K := K) t 1)⁆ := by
  rw [lie_subalgebraBasis (K := K) t _ _ 2 1 (by simpa using t.lie_e_f), one_smul, Φ_apply, Φ_apply,
    Φ_apply]
  simpa using rel_ef.symm

lemma Φ_bracket_he (t : IsSl2Triple h e f) :
    Φ (K := K) (n := n) t
      ⁅subalgebraBasis (K := K) t 2, subalgebraBasis (K := K) t 0⁆ =
        ⁅Φ (K := K) (n := n) t (subalgebraBasis (K := K) t 2),
          Φ (K := K) (n := n) t (subalgebraBasis (K := K) t 0)⁆ := by
  rw [lie_subalgebraBasis (K := K) t _ _ 0 2 (by simpa using t.lie_h_e_smul K), map_smul,
    Φ_apply, Φ_apply]
  exact rel_he.symm

lemma Φ_bracket_hf (t : IsSl2Triple h e f) :
    Φ (K := K) (n := n) t
      ⁅subalgebraBasis (K := K) t 2, subalgebraBasis (K := K) t 1⁆ =
        ⁅Φ (K := K) (n := n) t (subalgebraBasis (K := K) t 2),
          Φ (K := K) (n := n) t (subalgebraBasis (K := K) t 1)⁆ := by
  rw [lie_subalgebraBasis (K := K) t _ _ 1 (-2)
    (by show ⁅h, f⁆ = (-2 : K) • f; rw [t.lie_lie_smul_f K]; module), map_smul,
    Φ_apply, Φ_apply]
  exact rel_hf.symm

/-- The action map preserves brackets on pairs of the three generators. -/
lemma Φ_bracket_basis (t : IsSl2Triple h e f) (i j : Fin 3) :
    Φ (K := K) (n := n) t
      ⁅subalgebraBasis (K := K) t i, subalgebraBasis (K := K) t j⁆ =
        ⁅Φ (K := K) (n := n) t (subalgebraBasis (K := K) t i),
          Φ (K := K) (n := n) t (subalgebraBasis (K := K) t j)⁆ := by
  fin_cases i <;> fin_cases j
  · exact Φ_bracket_refl (K := K) (n := n) t _
  · exact Φ_bracket_ef (K := K) (n := n) t
  · exact Φ_bracket_swap (K := K) (n := n) t _ _ (Φ_bracket_he (K := K) (n := n) t)
  · exact Φ_bracket_swap (K := K) (n := n) t _ _ (Φ_bracket_ef (K := K) (n := n) t)
  · exact Φ_bracket_refl (K := K) (n := n) t _
  · exact Φ_bracket_swap (K := K) (n := n) t _ _ (Φ_bracket_hf (K := K) (n := n) t)
  · exact Φ_bracket_he (K := K) (n := n) t
  · exact Φ_bracket_hf (K := K) (n := n) t
  · exact Φ_bracket_refl (K := K) (n := n) t _

/-- The action map preserves brackets because it does so on pairs of basis elements. -/
lemma Φ_lie (t : IsSl2Triple h e f)
    (x y : ↥(t.toLieSubalgebra (R := K))) :
    Φ (K := K) (n := n) t ⁅x, y⁆
      =
      ⁅(Φ (K := K) (n := n) t x : Module.End K (StandardSl2Module K n)),
        (Φ (K := K) (n := n) t y : Module.End K (StandardSl2Module K n))⁆ := by
  exact LinearMap.lie_apply_eq_of_lie_basis_eq (subalgebraBasis (K := K) t) (Φ t)
    (Φ_bracket_basis (K := K) (n := n) t) x y

end PhyslibAlpha.Sl2

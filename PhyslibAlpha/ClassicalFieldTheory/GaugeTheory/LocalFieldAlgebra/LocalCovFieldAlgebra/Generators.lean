module

public import PhyslibAlpha.ClassicalFieldTheory.GaugeTheory.LocalFieldAlgebra.LocalCovFieldAlgebra.Basic
/-!
# The covariant generators by kind and mass weight

The covariant generators of a gauge field theory sorted by kind and mass weight, and the
products of them, which span the covariant field algebra.

## i. Overview

The covariant field algebra `T.LocalCovFieldAlgebra` of a field datum `T` is generated by
three kinds of covariant expressions.

- Gauge. The field strength `F_μν` and its covariant derivatives `∇_l F_μν`.
- Scalar. The bosonic matter fields `φ`, their conjugates `φ†`, and their covariant
  derivatives.
- Fermion. The fermionic matter fields `ψ`, their conjugates `ψ̄`, and their covariant
  derivatives.

Each generator also carries a mass weight, twice its mass dimension. The tower `∇_l F_μν` has
weight `4 + 2 |l|`, and the tower of `n` covariant derivatives of a species of mass weight `c`,
or of its conjugate, has weight `c + 2 n`. The set `T.weightedGenerators k w` collects the
generators of kind `k` and weight `w`.

A product of generators is recorded as a list of generators, each with its kind and weight. The
set `T.weightedMonomials A w` holds the products whose set of kinds is `A` and whose weights add
up to `w`. Every element of the covariant field algebra is a combination of such products. The
algebra is not free on its generators, so this combination is not unique, and every argument
below works with the products as a spanning set only.

The gauge and Lorentz groups carry each generator into the span of the generators of the same
kind and weight, so they preserve the span of the products of any given kinds and weight. When
the mass weights of the fermionic species are odd and those of the bosonic species even, the
mass weight also records the statistics: two products of weights `v` and `w` exchange up to the
sign `(-1) ^ (v * w)`.

## ii. Key results

- `GaugeFieldData.FieldKind` : the three kinds of covariant generators.
- `GaugeFieldData.kindGenerators`, `GaugeFieldData.weightedGenerators` : the generators of a
  given kind, and of a given kind and mass weight.
- `GaugeFieldData.weightedMonomials` : the products of generators of given kinds and weight.
- `GaugeFieldData.mem_span_weightedMonomials` : the products span the covariant field algebra.
- `GaugeFieldData.map_mem_span_weightedMonomials` : a unital multiplicative map preserving the
  kinds and weights of the generators preserves the span of the products of given kinds and
  weight.
- `GaugeFieldData.anticomm_of_mem_span_kindGenerators_fermion` : the fermionic generators
  anticommute on their span.
- `GaugeFieldData.mul_eq_smul_mul_of_mem_span_weightedMonomials` : combinations of products of
  weights `v` and `w` exchange up to the sign `(-1) ^ (v * w)`.

## iii. Table of contents

- A. The kinds of covariant generators
- B. The generators of a given kind and mass weight
  - B.1. Case analysis
  - B.2. Bounds on the mass weights
- C. The actions on the generators
- D. Products of generators
  - D.1. The products span the covariant field algebra
  - D.2. Maps preserving the products
- E. The statistics of the generators
  - E.1. Commutation and anticommutation by kind
  - E.2. The sign of an exchange from the mass weights

## iv. References

* None.

-/

@[expose] public section

open MatrixGroups
open GaugeFieldData.LocalCovFieldAlgebra (covFieldStrength covFermion covConjFermion covBoson
  covConjBoson)

namespace GaugeFieldData

/-!

## A. The kinds of covariant generators

-/

/-- The kinds of covariant generators of a gauge field theory. -/
inductive FieldKind
  /-- The field strength `F_μν` and its covariant derivatives. -/
  | gauge
  /-- A bosonic matter field or its conjugate, and their covariant derivatives. -/
  | scalar
  /-- A fermionic matter field or its conjugate, and their covariant derivatives. -/
  | fermion
  deriving DecidableEq

/-- The three kinds exhaust `FieldKind`. The instance is written out rather than derived, as
  for the earlier Standard Model class of generators, where the deriving handler produced a
  membership that did not typecheck. -/
instance : Fintype FieldKind where
  elems := {FieldKind.gauge, FieldKind.scalar, FieldKind.fermion}
  complete := fun x => by cases x <;> decide

variable {κ : Type} [Fintype κ] [DecidableEq κ] {G : GlobalGaugeGroup κ} (T : GaugeFieldData G)

/-- The covariant generators of a given kind, as elements of the covariant field algebra. These
  are the field-strength tower for `gauge`, the bosonic towers and their conjugates for `scalar`,
  and the fermionic towers and their conjugates for `fermion`. -/
noncomputable def kindGenerators : FieldKind → Set T.LocalCovFieldAlgebra
  | .gauge => ⋃ l : List (Fin 1 ⊕ Fin 3), ⋃ μ, ⋃ ν, Set.range (covFieldStrength T l μ ν)
  | .scalar => ⋃ j, ⋃ n : ℕ, ⋃ l : Fin n → (Fin 1 ⊕ Fin 3),
      Set.range (covBoson T j l) ∪ Set.range (covConjBoson T j l)
  | .fermion => ⋃ i, ⋃ n : ℕ, ⋃ l : Fin n → (Fin 1 ⊕ Fin 3),
      Set.range (covFermion T i l) ∪ Set.range (covConjFermion T i l)

lemma covFieldStrength_mem_kindGenerators (l : List (Fin 1 ⊕ Fin 3)) (μ ν : Fin 1 ⊕ Fin 3)
    (φ : Module.Dual ℝ G.lieSubalgebra) :
    covFieldStrength T l μ ν φ ∈ T.kindGenerators .gauge :=
  Set.mem_iUnion.mpr ⟨l, Set.mem_iUnion.mpr ⟨μ, Set.mem_iUnion.mpr ⟨ν, φ, rfl⟩⟩⟩

lemma covBoson_mem_kindGenerators (j : T.BosonSpecies) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
    (φ : Module.Dual ℂ (T.BosonValue j)) : covBoson T j l φ ∈ T.kindGenerators .scalar :=
  Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨l, Or.inl ⟨φ, rfl⟩⟩⟩⟩

lemma covConjBoson_mem_kindGenerators (j : T.BosonSpecies) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (ConjModule (T.BosonValue j))) :
    covConjBoson T j l φ ∈ T.kindGenerators .scalar :=
  Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨l, Or.inr ⟨φ, rfl⟩⟩⟩⟩

lemma covFermion_mem_kindGenerators (i : T.FermionSpecies) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (T.FermionValue i)) :
    covFermion T i l φ ∈ T.kindGenerators .fermion :=
  Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨l, Or.inl ⟨φ, rfl⟩⟩⟩⟩

lemma covConjFermion_mem_kindGenerators (i : T.FermionSpecies) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (ConjModule (T.FermionValue i))) :
    covConjFermion T i l φ ∈ T.kindGenerators .fermion :=
  Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨l, Or.inr ⟨φ, rfl⟩⟩⟩⟩

/-!

## B. The generators of a given kind and mass weight

-/

/-- The covariant generators of kind `k` and mass weight `w`. The field-strength tower
  `∇_l F_μν` has weight `4 + 2 |l|`, and the tower of `n` covariant derivatives of a species of
  mass weight `c`, or of its conjugate, has weight `c + 2 n`. -/
noncomputable def weightedGenerators : FieldKind → ℕ → Set T.LocalCovFieldAlgebra
  | .gauge, w => ⋃ l : List (Fin 1 ⊕ Fin 3), ⋃ (_ : 4 + 2 * l.length = w), ⋃ μ, ⋃ ν,
      Set.range (covFieldStrength T l μ ν)
  | .scalar, w => ⋃ j, ⋃ n : ℕ, ⋃ (_ : (T.boson j).massWeight + 2 * n = w),
      ⋃ l : Fin n → (Fin 1 ⊕ Fin 3), Set.range (covBoson T j l) ∪ Set.range (covConjBoson T j l)
  | .fermion, w => ⋃ i, ⋃ n : ℕ, ⋃ (_ : (T.fermion i).massWeight + 2 * n = w),
      ⋃ l : Fin n → (Fin 1 ⊕ Fin 3),
        Set.range (covFermion T i l) ∪ Set.range (covConjFermion T i l)

lemma covFieldStrength_mem_weightedGenerators (l : List (Fin 1 ⊕ Fin 3)) (μ ν : Fin 1 ⊕ Fin 3)
    (φ : Module.Dual ℝ G.lieSubalgebra) :
    covFieldStrength T l μ ν φ ∈ T.weightedGenerators .gauge (4 + 2 * l.length) :=
  Set.mem_iUnion.mpr ⟨l, Set.mem_iUnion.mpr ⟨rfl, Set.mem_iUnion.mpr ⟨μ,
    Set.mem_iUnion.mpr ⟨ν, φ, rfl⟩⟩⟩⟩

lemma covBoson_mem_weightedGenerators (j : T.BosonSpecies) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (T.BosonValue j)) :
    covBoson T j l φ ∈ T.weightedGenerators .scalar ((T.boson j).massWeight + 2 * n) :=
  Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨rfl,
    Set.mem_iUnion.mpr ⟨l, Or.inl ⟨φ, rfl⟩⟩⟩⟩⟩

lemma covConjBoson_mem_weightedGenerators (j : T.BosonSpecies) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (ConjModule (T.BosonValue j))) :
    covConjBoson T j l φ ∈ T.weightedGenerators .scalar ((T.boson j).massWeight + 2 * n) :=
  Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨rfl,
    Set.mem_iUnion.mpr ⟨l, Or.inr ⟨φ, rfl⟩⟩⟩⟩⟩

lemma covFermion_mem_weightedGenerators (i : T.FermionSpecies) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (T.FermionValue i)) :
    covFermion T i l φ ∈ T.weightedGenerators .fermion ((T.fermion i).massWeight + 2 * n) :=
  Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨rfl,
    Set.mem_iUnion.mpr ⟨l, Or.inl ⟨φ, rfl⟩⟩⟩⟩⟩

lemma covConjFermion_mem_weightedGenerators (i : T.FermionSpecies) {n : ℕ}
    (l : Fin n → (Fin 1 ⊕ Fin 3)) (φ : Module.Dual ℂ (ConjModule (T.FermionValue i))) :
    covConjFermion T i l φ ∈ T.weightedGenerators .fermion ((T.fermion i).massWeight + 2 * n) :=
  Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨rfl,
    Set.mem_iUnion.mpr ⟨l, Or.inr ⟨φ, rfl⟩⟩⟩⟩⟩

/-!

### B.1. Case analysis

-/

variable {T}

/-- Case analysis on the covariant generators of a given kind and mass weight. -/
lemma weightedGenerators_cases {P : FieldKind → ℕ → T.LocalCovFieldAlgebra → Prop}
    {k : FieldKind} {w : ℕ} {b : T.LocalCovFieldAlgebra} (hb : b ∈ T.weightedGenerators k w)
    (hF : ∀ (l : List (Fin 1 ⊕ Fin 3)) (μ ν : Fin 1 ⊕ Fin 3) (φ : Module.Dual ℝ G.lieSubalgebra),
      P .gauge (4 + 2 * l.length) (covFieldStrength T l μ ν φ))
    (hψ : ∀ (i : T.FermionSpecies) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
      (φ : Module.Dual ℂ (T.FermionValue i)),
      P .fermion ((T.fermion i).massWeight + 2 * n) (covFermion T i l φ))
    (hψc : ∀ (i : T.FermionSpecies) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
      (φ : Module.Dual ℂ (ConjModule (T.FermionValue i))),
      P .fermion ((T.fermion i).massWeight + 2 * n) (covConjFermion T i l φ))
    (hφ : ∀ (j : T.BosonSpecies) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
      (φ : Module.Dual ℂ (T.BosonValue j)),
      P .scalar ((T.boson j).massWeight + 2 * n) (covBoson T j l φ))
    (hφc : ∀ (j : T.BosonSpecies) {n : ℕ} (l : Fin n → (Fin 1 ⊕ Fin 3))
      (φ : Module.Dual ℂ (ConjModule (T.BosonValue j))),
      P .scalar ((T.boson j).massWeight + 2 * n) (covConjBoson T j l φ)) :
    P k w b := by
  cases k with
  | gauge =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_range] at hb
    obtain ⟨l, rfl, μ, ν, φ, rfl⟩ := hb
    exact hF l μ ν φ
  | scalar =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨j, n, rfl, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · exact hφ j l φ
    · exact hφc j l φ
  | fermion =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨i, n, rfl, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · exact hψ i l φ
    · exact hψc i l φ

/-- A generator of kind `k` and some mass weight is a generator of kind `k`. -/
lemma mem_kindGenerators_of_mem_weightedGenerators {k : FieldKind} {w : ℕ}
    {b : T.LocalCovFieldAlgebra} (hb : b ∈ T.weightedGenerators k w) : b ∈ T.kindGenerators k :=
  weightedGenerators_cases (P := fun k _ b => b ∈ T.kindGenerators k) hb
    (fun l μ ν φ => covFieldStrength_mem_kindGenerators T l μ ν φ)
    (fun i {_n} l φ => covFermion_mem_kindGenerators T i l φ)
    (fun i {_n} l φ => covConjFermion_mem_kindGenerators T i l φ)
    (fun j {_n} l φ => covBoson_mem_kindGenerators T j l φ)
    (fun j {_n} l φ => covConjBoson_mem_kindGenerators T j l φ)

/-- Every generator of kind `k` has a mass weight. -/
lemma exists_mem_weightedGenerators {k : FieldKind} {b : T.LocalCovFieldAlgebra}
    (hb : b ∈ T.kindGenerators k) : ∃ w, b ∈ T.weightedGenerators k w := by
  cases k with
  | gauge =>
    simp only [kindGenerators, Set.mem_iUnion, Set.mem_range] at hb
    obtain ⟨l, μ, ν, φ, rfl⟩ := hb
    exact ⟨_, covFieldStrength_mem_weightedGenerators T l μ ν φ⟩
  | scalar =>
    simp only [kindGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨j, n, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · exact ⟨_, covBoson_mem_weightedGenerators T j l φ⟩
    · exact ⟨_, covConjBoson_mem_weightedGenerators T j l φ⟩
  | fermion =>
    simp only [kindGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨i, n, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · exact ⟨_, covFermion_mem_weightedGenerators T i l φ⟩
    · exact ⟨_, covConjFermion_mem_weightedGenerators T i l φ⟩

/-!

### B.2. Bounds on the mass weights

-/

/-- A gauge generator has mass weight at least four. -/
lemma four_le_of_mem_weightedGenerators_gauge {w : ℕ} {b : T.LocalCovFieldAlgebra}
    (hb : b ∈ T.weightedGenerators .gauge w) : 4 ≤ w :=
  weightedGenerators_cases (P := fun k w _ => k = .gauge → 4 ≤ w) hb
    (fun _ _ _ _ _ => by omega) (fun _ {_n} _ _ h => by cases h)
    (fun _ {_n} _ _ h => by cases h) (fun _ {_n} _ _ h => by cases h)
    (fun _ {_n} _ _ h => by cases h) rfl

/-- A scalar generator has mass weight at least any lower bound on the mass weights of the
  bosonic species. -/
lemma le_of_mem_weightedGenerators_scalar {m w : ℕ} {b : T.LocalCovFieldAlgebra}
    (hm : ∀ j, m ≤ (T.boson j).massWeight) (hb : b ∈ T.weightedGenerators .scalar w) : m ≤ w :=
  weightedGenerators_cases (P := fun k w _ => k = .scalar → m ≤ w) hb
    (fun _ _ _ _ h => by cases h) (fun _ {_n} _ _ h => by cases h)
    (fun _ {_n} _ _ h => by cases h) (fun j {_n} _ _ _ => by have := hm j; omega)
    (fun j {_n} _ _ _ => by have := hm j; omega) rfl

/-- A fermionic generator has mass weight at least any lower bound on the mass weights of the
  fermionic species. -/
lemma le_of_mem_weightedGenerators_fermion {m w : ℕ} {b : T.LocalCovFieldAlgebra}
    (hm : ∀ i, m ≤ (T.fermion i).massWeight) (hb : b ∈ T.weightedGenerators .fermion w) :
    m ≤ w :=
  weightedGenerators_cases (P := fun k w _ => k = .fermion → m ≤ w) hb
    (fun _ _ _ _ h => by cases h) (fun i {_n} _ _ _ => by have := hm i; omega)
    (fun i {_n} _ _ _ => by have := hm i; omega) (fun _ {_n} _ _ h => by cases h)
    (fun _ {_n} _ _ h => by cases h) rfl

variable (T) in
/-- Every species has positive mass weight. -/
def HasPositiveMassWeights : Prop :=
  (∀ i, 0 < (T.fermion i).massWeight) ∧ ∀ j, 0 < (T.boson j).massWeight

/-- When every species has positive mass weight, so does every generator. -/
lemma pos_of_mem_weightedGenerators (hpos : T.HasPositiveMassWeights) {k : FieldKind} {w : ℕ}
    {b : T.LocalCovFieldAlgebra} (hb : b ∈ T.weightedGenerators k w) : 0 < w :=
  weightedGenerators_cases (P := fun _ w _ => True → 0 < w) hb
    (fun _ _ _ _ _ => by omega) (fun i {_n} _ _ _ => by have := hpos.1 i; omega)
    (fun i {_n} _ _ _ => by have := hpos.1 i; omega)
    (fun j {_n} _ _ _ => by have := hpos.2 j; omega)
    (fun j {_n} _ _ _ => by have := hpos.2 j; omega) trivial

/-!

## C. The actions on the generators

-/

/-- A jet carries a covariant generator to a generator of the same kind and mass weight. -/
lemma repJet_mem_weightedGenerators (U : G.gaugeJetGroup) {k : FieldKind} {w : ℕ}
    {b : T.LocalCovFieldAlgebra} (hb : b ∈ T.weightedGenerators k w) :
    LocalCovFieldAlgebra.repJet T U b ∈ T.weightedGenerators k w := by
  cases k with
  | gauge =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_range] at hb
    obtain ⟨l, rfl, μ, ν, φ, rfl⟩ := hb
    rw [LocalCovFieldAlgebra.repJet_covFieldStrength]
    exact covFieldStrength_mem_weightedGenerators T l μ ν _
  | scalar =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨j, n, rfl, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · rw [LocalCovFieldAlgebra.repJet_covBoson]
      exact covBoson_mem_weightedGenerators T j l _
    · rw [LocalCovFieldAlgebra.repJet_covConjBoson]
      exact covConjBoson_mem_weightedGenerators T j l _
  | fermion =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨i, n, rfl, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · rw [LocalCovFieldAlgebra.repJet_covFermion]
      exact covFermion_mem_weightedGenerators T i l _
    · rw [LocalCovFieldAlgebra.repJet_covConjFermion]
      exact covConjFermion_mem_weightedGenerators T i l _

/-- A Lorentz transformation carries a covariant generator to a combination of generators of
  the same kind and mass weight. -/
lemma repLorentzGroup_mem_span_weightedGenerators (hGL : T.GaugeLorentzCompatible) (Λ : SL(2,ℂ))
    {k : FieldKind} {w : ℕ} {b : T.LocalCovFieldAlgebra} (hb : b ∈ T.weightedGenerators k w) :
    LocalCovFieldAlgebra.repLorentzGroup T hGL Λ b
      ∈ Submodule.span ℂ (T.weightedGenerators k w) := by
  cases k with
  | gauge =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_range] at hb
    obtain ⟨l, rfl, μ, ν, φ, rfl⟩ := hb
    have h := LocalCovFieldAlgebra.repLorentzGroup_covFieldStrength hGL Λ l.get μ ν φ
    rw [List.ofFn_get] at h
    rw [h]
    refine Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _ <| Submodule.sum_mem _
      fun a _ => Submodule.smul_mem _ _ <| Submodule.sum_mem _ fun c _ =>
        Submodule.smul_mem _ _ <| Submodule.subset_span ?_
    simpa only [List.length_ofFn] using
      covFieldStrength_mem_weightedGenerators T (List.ofFn p) a c φ
  | scalar =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨j, n, rfl, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · rw [LocalCovFieldAlgebra.repLorentzGroup_covBoson]
      exact Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _
        (Submodule.subset_span (covBoson_mem_weightedGenerators T j p _))
    · rw [LocalCovFieldAlgebra.repLorentzGroup_covConjBoson]
      exact Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _
        (Submodule.subset_span (covConjBoson_mem_weightedGenerators T j p _))
  | fermion =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨i, n, rfl, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · rw [LocalCovFieldAlgebra.repLorentzGroup_covFermion]
      exact Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _
        (Submodule.subset_span (covFermion_mem_weightedGenerators T i p _))
    · rw [LocalCovFieldAlgebra.repLorentzGroup_covConjFermion]
      exact Submodule.sum_mem _ fun p _ => Submodule.smul_mem _ _
        (Submodule.subset_span (covConjFermion_mem_weightedGenerators T i p _))

/-!

## D. Products of generators

-/

variable (T) in
/-- The products of covariant generators with set of kinds `A` and total mass weight `w`. A
  product `b₁ ⋯ bₘ` is recorded as the list of its factors, each with its kind `kᵢ` and mass
  weight `wᵢ`, with `{k₁, …, kₘ} = A` and `w₁ + ⋯ + wₘ = w`. The empty product `1` is the only
  one with `A = ∅`. -/
def weightedMonomials (A : Finset FieldKind) (w : ℕ) : Set T.LocalCovFieldAlgebra :=
  {x | ∃ L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra),
    (∀ p ∈ L, p.2.2 ∈ T.weightedGenerators p.1 p.2.1) ∧ (L.map Prod.fst).toFinset = A ∧
      (L.map fun p => p.2.1).sum = w ∧ (L.map fun p => p.2.2).prod = x}

variable (T) in
lemma one_mem_weightedMonomials : (1 : T.LocalCovFieldAlgebra) ∈ T.weightedMonomials ∅ 0 :=
  ⟨[], by simp, by simp, by simp, by simp⟩

/-- A generator of kind `k` and mass weight `w` is a product with kinds `{k}` and weight `w`. -/
lemma mem_weightedMonomials_singleton {k : FieldKind} {w : ℕ} {b : T.LocalCovFieldAlgebra}
    (hb : b ∈ T.weightedGenerators k w) : b ∈ T.weightedMonomials {k} w :=
  ⟨[(k, w, b)], fun p hp => by rw [List.mem_singleton.1 hp]; exact hb, by simp, by simp,
    by simp⟩

/-- The product of two products of generators has the union of their sets of kinds and the
  sum of their mass weights. -/
lemma mul_mem_weightedMonomials {A B : Finset FieldKind} {v w : ℕ}
    {x y : T.LocalCovFieldAlgebra} (hx : x ∈ T.weightedMonomials A v)
    (hy : y ∈ T.weightedMonomials B w) : x * y ∈ T.weightedMonomials (A ∪ B) (v + w) := by
  obtain ⟨L₁, h₁, rfl, rfl, rfl⟩ := hx
  obtain ⟨L₂, h₂, rfl, rfl, rfl⟩ := hy
  refine ⟨L₁ ++ L₂, fun p hp => (List.mem_append.1 hp).elim (h₁ p) (h₂ p), ?_, ?_, ?_⟩
  · rw [List.map_append, List.toFinset_append]
  · rw [List.map_append, List.sum_append]
  · rw [List.map_append, List.prod_append]

/-- The only product of generators with no kinds is the empty product, of weight zero. -/
lemma eq_one_of_mem_weightedMonomials_empty {w : ℕ} {x : T.LocalCovFieldAlgebra}
    (hx : x ∈ T.weightedMonomials ∅ w) : w = 0 ∧ x = 1 := by
  obtain ⟨L, -, hL, rfl, rfl⟩ := hx
  rw [List.toFinset_eq_empty_iff, List.map_eq_nil_iff] at hL
  subst hL
  simp

/-- A product of generators all of whose weights are positive has weight zero only when it is
  the empty product. -/
lemma eq_one_of_mem_weightedMonomials_zero (hpos : T.HasPositiveMassWeights)
    {A : Finset FieldKind} {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.weightedMonomials A 0) :
    x = 1 := by
  obtain ⟨L, hL, -, hw, rfl⟩ := hx
  cases L with
  | nil => rfl
  | cons q L =>
    have := pos_of_mem_weightedGenerators hpos (hL q (List.mem_cons.2 (Or.inl rfl)))
    rw [List.map_cons, List.sum_cons] at hw
    omega

/-!

### D.1. The products span the covariant field algebra

-/

/-- Every element of the covariant field algebra is a combination of products of generators.
  This is the generation principle in the form used for the mass weights and the sectors. -/
lemma mem_span_weightedMonomials (x : T.LocalCovFieldAlgebra) :
    x ∈ Submodule.span ℂ (⋃ A, ⋃ w, T.weightedMonomials A w) := by
  obtain ⟨x, hx⟩ := x
  change x ∈ Algebra.adjoin ℂ T.covGenerators at hx
  induction hx using Algebra.adjoin_induction with
  | mem b hb =>
    refine LocalCovFieldAlgebra.covGenerators_cases (P := fun b => ∀ hb : b ∈
      T.LocalCovFieldAlgebra, (⟨b, hb⟩ : T.LocalCovFieldAlgebra) ∈
        Submodule.span ℂ (⋃ A, ⋃ w, T.weightedMonomials A w)) hb ?_ ?_ ?_ ?_ ?_ _
    · intro l μ ν φ _
      exact Submodule.subset_span (Set.mem_iUnion.2 ⟨_, Set.mem_iUnion.2 ⟨_,
        mem_weightedMonomials_singleton (covFieldStrength_mem_weightedGenerators T l μ ν φ)⟩⟩)
    · intro i n l φ _
      exact Submodule.subset_span (Set.mem_iUnion.2 ⟨_, Set.mem_iUnion.2 ⟨_,
        mem_weightedMonomials_singleton (covFermion_mem_weightedGenerators T i l φ)⟩⟩)
    · intro i n l φ _
      exact Submodule.subset_span (Set.mem_iUnion.2 ⟨_, Set.mem_iUnion.2 ⟨_,
        mem_weightedMonomials_singleton (covConjFermion_mem_weightedGenerators T i l φ)⟩⟩)
    · intro j n l φ _
      exact Submodule.subset_span (Set.mem_iUnion.2 ⟨_, Set.mem_iUnion.2 ⟨_,
        mem_weightedMonomials_singleton (covBoson_mem_weightedGenerators T j l φ)⟩⟩)
    · intro j n l φ _
      exact Submodule.subset_span (Set.mem_iUnion.2 ⟨_, Set.mem_iUnion.2 ⟨_,
        mem_weightedMonomials_singleton (covConjBoson_mem_weightedGenerators T j l φ)⟩⟩)
  | algebraMap z =>
    rw [show (⟨algebraMap ℂ T.LocalFieldAlgebra z, Subalgebra.algebraMap_mem _ z⟩ :
      T.LocalCovFieldAlgebra) = z • 1 from Subtype.ext (Algebra.algebraMap_eq_smul_one z)]
    exact Submodule.smul_mem _ z (Submodule.subset_span
      (Set.mem_iUnion.2 ⟨∅, Set.mem_iUnion.2 ⟨0, one_mem_weightedMonomials T⟩⟩))
  | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
  | mul x y _ _ hx hy =>
    have hxy := Submodule.mul_mem_mul hx hy
    rw [Submodule.span_mul_span] at hxy
    refine Submodule.span_mono ?_ hxy
    rintro _ ⟨a, ha, b, hb, rfl⟩
    obtain ⟨A, ha⟩ := Set.mem_iUnion.1 ha
    obtain ⟨v, ha⟩ := Set.mem_iUnion.1 ha
    obtain ⟨B, hb⟩ := Set.mem_iUnion.1 hb
    obtain ⟨w, hb⟩ := Set.mem_iUnion.1 hb
    exact Set.mem_iUnion.2 ⟨A ∪ B, Set.mem_iUnion.2 ⟨v + w, mul_mem_weightedMonomials ha hb⟩⟩

/-!

### D.2. Maps preserving the products

-/

/-- A unital multiplicative linear map carrying every generator into the span of the generators
  of the same kind and mass weight carries a product of generators into the span of the products
  with the same kinds and weight. -/
lemma map_list_prod_mem_span_weightedMonomials
    {f : T.LocalCovFieldAlgebra →ₗ[ℂ] T.LocalCovFieldAlgebra} (h1 : f 1 = 1)
    (hmul : ∀ x y, f (x * y) = f x * f y)
    (hgen : ∀ k w, ∀ b ∈ T.weightedGenerators k w,
      f b ∈ Submodule.span ℂ (T.weightedGenerators k w))
    (L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra))
    (hL : ∀ p ∈ L, p.2.2 ∈ T.weightedGenerators p.1 p.2.1) :
    f (L.map fun p => p.2.2).prod ∈ Submodule.span ℂ
      (T.weightedMonomials (L.map Prod.fst).toFinset (L.map fun p => p.2.1).sum) := by
  induction L with
  | nil =>
    simp only [List.map_nil, List.prod_nil, List.toFinset_nil, List.sum_nil, h1]
    exact Submodule.subset_span (one_mem_weightedMonomials T)
  | cons p L ih =>
    simp only [List.map_cons, List.prod_cons, List.toFinset_cons, List.sum_cons]
    rw [hmul]
    have hp := hgen p.1 p.2.1 p.2.2 (hL p (List.mem_cons.2 (Or.inl rfl)))
    have hrest := ih fun q hq => hL q (List.mem_cons.2 (Or.inr hq))
    have hxy := Submodule.mul_mem_mul hp hrest
    rw [Submodule.span_mul_span] at hxy
    refine Submodule.span_mono ?_ hxy
    rintro _ ⟨a, ha, b, hb, rfl⟩
    have h := mul_mem_weightedMonomials (mem_weightedMonomials_singleton ha) hb
    rwa [Finset.singleton_union] at h

/-- A unital multiplicative linear map carrying every generator into the span of the generators
  of the same kind and mass weight preserves the span of the products of any given kinds and
  weight. -/
lemma map_mem_span_weightedMonomials {f : T.LocalCovFieldAlgebra →ₗ[ℂ] T.LocalCovFieldAlgebra}
    (h1 : f 1 = 1) (hmul : ∀ x y, f (x * y) = f x * f y)
    (hgen : ∀ k w, ∀ b ∈ T.weightedGenerators k w,
      f b ∈ Submodule.span ℂ (T.weightedGenerators k w))
    {A : Finset FieldKind} {w : ℕ} {x : T.LocalCovFieldAlgebra}
    (hx : x ∈ Submodule.span ℂ (T.weightedMonomials A w)) :
    f x ∈ Submodule.span ℂ (T.weightedMonomials A w) := by
  refine (Submodule.span_le (p := (Submodule.span ℂ (T.weightedMonomials A w)).comap f)).2 ?_ hx
  rintro _ ⟨L, hL, rfl, rfl, rfl⟩
  exact map_list_prod_mem_span_weightedMonomials h1 hmul hgen L hL

/-- The jet gauge group preserves the span of the products of any given kinds and weight. -/
lemma repJet_mem_span_weightedMonomials (U : G.gaugeJetGroup) {A : Finset FieldKind} {w : ℕ}
    {x : T.LocalCovFieldAlgebra} (hx : x ∈ Submodule.span ℂ (T.weightedMonomials A w)) :
    LocalCovFieldAlgebra.repJet T U x ∈ Submodule.span ℂ (T.weightedMonomials A w) :=
  map_mem_span_weightedMonomials (f := LocalCovFieldAlgebra.repJet T U)
    (Subtype.ext (GaugeFieldData.repJet_apply_one U))
    (LocalCovFieldAlgebra.repJet_apply_mul U)
    (fun _ _ _ hb => Submodule.subset_span (repJet_mem_weightedGenerators U hb)) hx

/-- The ordinary gauge group preserves the span of the products of any given kinds and
  weight. -/
lemma repValue_mem_span_weightedMonomials (g : G.group) {A : Finset FieldKind} {w : ℕ}
    {x : T.LocalCovFieldAlgebra} (hx : x ∈ Submodule.span ℂ (T.weightedMonomials A w)) :
    LocalCovFieldAlgebra.repValue T g x ∈ Submodule.span ℂ (T.weightedMonomials A w) :=
  repJet_mem_span_weightedMonomials (G.gaugeJetOfConstant g) hx

/-- The Lorentz group preserves the span of the products of any given kinds and weight. -/
lemma repLorentzGroup_mem_span_weightedMonomials (hGL : T.GaugeLorentzCompatible)
    (Λ : SL(2,ℂ)) {A : Finset FieldKind} {w : ℕ} {x : T.LocalCovFieldAlgebra}
    (hx : x ∈ Submodule.span ℂ (T.weightedMonomials A w)) :
    LocalCovFieldAlgebra.repLorentzGroup T hGL Λ x ∈ Submodule.span ℂ (T.weightedMonomials A w) :=
  map_mem_span_weightedMonomials (f := LocalCovFieldAlgebra.repLorentzGroup T hGL Λ)
    (Subtype.ext (GaugeFieldData.repLorentzGroup_apply_one Λ))
    (LocalCovFieldAlgebra.repLorentzGroup_apply_mul hGL Λ)
    (fun _ _ _ hb => repLorentzGroup_mem_span_weightedGenerators hGL Λ hb) hx

/-!

## E. The statistics of the generators

### E.1. Commutation and anticommutation by kind

-/

/-- A gauge or scalar generator is central in the covariant field algebra. -/
lemma commute_of_mem_kindGenerators {k : FieldKind} (hk : k ≠ .fermion)
    {b : T.LocalCovFieldAlgebra} (hb : b ∈ T.kindGenerators k) (x : T.LocalCovFieldAlgebra) :
    Commute b x := by
  cases k with
  | gauge =>
    simp only [kindGenerators, Set.mem_iUnion, Set.mem_range] at hb
    obtain ⟨l, μ, ν, φ, rfl⟩ := hb
    exact LocalCovFieldAlgebra.commute_covFieldStrength l μ ν φ x
  | scalar =>
    simp only [kindGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨j, n, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := hb
    · exact LocalCovFieldAlgebra.commute_covBoson j l φ x
    · exact LocalCovFieldAlgebra.commute_covConjBoson j l φ x
  | fermion => exact absurd rfl hk

/-- Two fermionic generators anticommute. -/
lemma anticomm_of_mem_kindGenerators_fermion {a b : T.LocalCovFieldAlgebra}
    (ha : a ∈ T.kindGenerators .fermion) (hb : b ∈ T.kindGenerators .fermion) :
    a * b = -(b * a) := by
  simp only [kindGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at ha hb
  obtain ⟨i, n, l, ⟨φ, rfl⟩ | ⟨φ, rfl⟩⟩ := ha <;>
    obtain ⟨j, m, l', ⟨φ', rfl⟩ | ⟨φ', rfl⟩⟩ := hb
  · exact LocalCovFieldAlgebra.covFermion_anticomm_covFermion i j l φ l' φ'
  · exact LocalCovFieldAlgebra.covFermion_anticomm_covConjFermion i j l φ l' φ'
  · exact LocalCovFieldAlgebra.covConjFermion_anticomm_covFermion i j l φ l' φ'
  · exact LocalCovFieldAlgebra.covConjFermion_anticomm_covConjFermion i j l φ l' φ'

/-- Any two combinations of fermionic generators anticommute. -/
lemma anticomm_of_mem_span_kindGenerators_fermion {x y : T.LocalCovFieldAlgebra}
    (hx : x ∈ Submodule.span ℂ (T.kindGenerators .fermion))
    (hy : y ∈ Submodule.span ℂ (T.kindGenerators .fermion)) : x * y = -(y * x) := by
  induction hx using Submodule.span_induction with
  | mem a ha =>
    induction hy using Submodule.span_induction with
    | mem b hb => exact anticomm_of_mem_kindGenerators_fermion ha hb
    | zero => simp
    | add b₁ b₂ _ _ ih₁ ih₂ => rw [mul_add, ih₁, ih₂, add_mul, neg_add]
    | smul c b _ ih => rw [mul_smul_comm, ih, smul_mul_assoc, smul_neg]
  | zero => simp
  | add a₁ a₂ _ _ ih₁ ih₂ => rw [add_mul, ih₁, ih₂, mul_add, neg_add]
  | smul c a _ ih => rw [smul_mul_assoc, ih, mul_smul_comm, smul_neg]

/-!

### E.2. The sign of an exchange from the mass weights

-/

variable (T) in
/-- The mass weights of the species have the parity of their statistics, odd for the fermionic
  species and even for the bosonic ones. -/
def HasMassWeightParity : Prop :=
  (∀ i, Odd (T.fermion i).massWeight) ∧ ∀ j, Even (T.boson j).massWeight

/-- Under `HasMassWeightParity`, a gauge or scalar generator has even mass weight. -/
lemma even_of_mem_weightedGenerators (hpar : T.HasMassWeightParity) {k : FieldKind}
    (hk : k ≠ .fermion) {w : ℕ} {b : T.LocalCovFieldAlgebra}
    (hb : b ∈ T.weightedGenerators k w) : Even w := by
  cases k with
  | gauge =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_range] at hb
    obtain ⟨l, rfl, -⟩ := hb
    exact ⟨2 + l.length, by omega⟩
  | scalar =>
    simp only [weightedGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
    obtain ⟨j, n, rfl, -⟩ := hb
    exact (hpar.2 j).add (even_two_mul n)
  | fermion => exact absurd rfl hk

/-- Under `HasMassWeightParity`, a fermionic generator has odd mass weight. -/
lemma odd_of_mem_weightedGenerators_fermion (hpar : T.HasMassWeightParity) {w : ℕ}
    {b : T.LocalCovFieldAlgebra} (hb : b ∈ T.weightedGenerators .fermion w) : Odd w := by
  simp only [weightedGenerators, Set.mem_iUnion, Set.mem_union, Set.mem_range] at hb
  obtain ⟨i, n, rfl, -⟩ := hb
  exact (hpar.1 i).add_even (even_two_mul n)

/-- Under `HasMassWeightParity`, two generators of mass weights `v` and `w` exchange up to the
  sign `(-1) ^ (v * w)`, which is `-1` exactly when both are fermionic. -/
lemma mul_eq_smul_mul_of_mem_weightedGenerators (hpar : T.HasMassWeightParity)
    {k k' : FieldKind} {v w : ℕ} {b b' : T.LocalCovFieldAlgebra}
    (hb : b ∈ T.weightedGenerators k v) (hb' : b' ∈ T.weightedGenerators k' w) :
    b * b' = ((-1 : ℂ) ^ (v * w)) • (b' * b) := by
  by_cases hk : k = .fermion
  · subst hk
    by_cases hk' : k' = .fermion
    · subst hk'
      rw [Odd.neg_one_pow ((odd_of_mem_weightedGenerators_fermion hpar hb).mul
        (odd_of_mem_weightedGenerators_fermion hpar hb')), neg_one_smul]
      exact anticomm_of_mem_kindGenerators_fermion (mem_kindGenerators_of_mem_weightedGenerators hb)
        (mem_kindGenerators_of_mem_weightedGenerators hb')
    · rw [Even.neg_one_pow ((even_of_mem_weightedGenerators hpar hk' hb').mul_left v), one_smul]
      exact (commute_of_mem_kindGenerators hk'
        (mem_kindGenerators_of_mem_weightedGenerators hb') b).symm.eq
  · rw [Even.neg_one_pow ((even_of_mem_weightedGenerators hpar hk hb).mul_right w), one_smul]
    exact (commute_of_mem_kindGenerators hk (mem_kindGenerators_of_mem_weightedGenerators hb) b').eq

/-- Under `HasMassWeightParity`, a generator of mass weight `v` moves past a product of
  generators of weight `w` up to the sign `(-1) ^ (v * w)`. -/
lemma mul_list_prod_eq_smul (hpar : T.HasMassWeightParity) {k : FieldKind} {v : ℕ}
    {b : T.LocalCovFieldAlgebra} (hb : b ∈ T.weightedGenerators k v)
    (L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra))
    (hL : ∀ p ∈ L, p.2.2 ∈ T.weightedGenerators p.1 p.2.1) :
    b * (L.map fun p => p.2.2).prod
      = ((-1 : ℂ) ^ (v * (L.map fun p => p.2.1).sum)) • ((L.map fun p => p.2.2).prod * b) := by
  induction L with
  | nil => simp
  | cons q L ih =>
    have hq := hL q (List.mem_cons.2 (Or.inl rfl))
    have ih := ih fun p hp => hL p (List.mem_cons.2 (Or.inr hp))
    simp only [List.map_cons, List.prod_cons, List.sum_cons]
    calc b * (q.2.2 * (L.map fun p => p.2.2).prod)
        = (b * q.2.2) * (L.map fun p => p.2.2).prod := (mul_assoc _ _ _).symm
      _ = ((-1 : ℂ) ^ (v * q.2.1)) • (q.2.2 * (b * (L.map fun p => p.2.2).prod)) := by
          rw [mul_eq_smul_mul_of_mem_weightedGenerators hpar hb hq, smul_mul_assoc, mul_assoc]
      _ = ((-1 : ℂ) ^ (v * q.2.1)) • (q.2.2 * (((-1 : ℂ) ^ (v * (L.map fun p => p.2.1).sum)) •
            ((L.map fun p => p.2.2).prod * b))) := by rw [ih]
      _ = ((-1 : ℂ) ^ (v * (q.2.1 + (L.map fun p => p.2.1).sum))) •
            ((q.2.2 * (L.map fun p => p.2.2).prod) * b) := by
          rw [mul_smul_comm, smul_smul, ← pow_add, ← mul_add, ← mul_assoc]

/-- Under `HasMassWeightParity`, two products of generators of mass weights `v` and `w`
  exchange up to the sign `(-1) ^ (v * w)`. -/
lemma mul_eq_smul_mul_of_mem_weightedMonomials (hpar : T.HasMassWeightParity)
    {A B : Finset FieldKind} {v w : ℕ} {x y : T.LocalCovFieldAlgebra}
    (hx : x ∈ T.weightedMonomials A v) (hy : y ∈ T.weightedMonomials B w) :
    x * y = ((-1 : ℂ) ^ (v * w)) • (y * x) := by
  obtain ⟨L, hL, -, rfl, rfl⟩ := hx
  obtain ⟨L', hL', -, rfl, rfl⟩ := hy
  induction L with
  | nil => simp
  | cons q L ih =>
    have hq := hL q (List.mem_cons.2 (Or.inl rfl))
    have ih := ih fun p hp => hL p (List.mem_cons.2 (Or.inr hp))
    simp only [List.map_cons, List.prod_cons, List.sum_cons]
    calc (q.2.2 * (L.map fun p => p.2.2).prod) * (L'.map fun p => p.2.2).prod
        = q.2.2 * ((L.map fun p => p.2.2).prod * (L'.map fun p => p.2.2).prod) := mul_assoc _ _ _
      _ = ((-1 : ℂ) ^ ((L.map fun p => p.2.1).sum * (L'.map fun p => p.2.1).sum)) •
            ((q.2.2 * (L'.map fun p => p.2.2).prod) * (L.map fun p => p.2.2).prod) := by
          rw [ih, mul_smul_comm, ← mul_assoc]
      _ = ((-1 : ℂ) ^ ((L.map fun p => p.2.1).sum * (L'.map fun p => p.2.1).sum)) •
            ((((-1 : ℂ) ^ (q.2.1 * (L'.map fun p => p.2.1).sum)) •
              ((L'.map fun p => p.2.2).prod * q.2.2)) * (L.map fun p => p.2.2).prod) := by
          rw [mul_list_prod_eq_smul hpar hq L' hL']
      _ = ((-1 : ℂ) ^ ((q.2.1 + (L.map fun p => p.2.1).sum) * (L'.map fun p => p.2.1).sum)) •
            ((L'.map fun p => p.2.2).prod * (q.2.2 * (L.map fun p => p.2.2).prod)) := by
          rw [smul_mul_assoc, smul_smul, ← pow_add, mul_assoc]
          congr 2
          ring

/-- Under `HasMassWeightParity`, combinations of products of generators of mass weights `v`
  and `w` exchange up to the sign `(-1) ^ (v * w)`. The fermion parity is the parity of the
  mass weight. -/
lemma mul_eq_smul_mul_of_mem_span_weightedMonomials (hpar : T.HasMassWeightParity) {v w : ℕ}
    {x y : T.LocalCovFieldAlgebra}
    (hx : x ∈ Submodule.span ℂ (⋃ A, T.weightedMonomials A v))
    (hy : y ∈ Submodule.span ℂ (⋃ A, T.weightedMonomials A w)) :
    x * y = ((-1 : ℂ) ^ (v * w)) • (y * x) := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, hx⟩ := Set.mem_iUnion.1 hx
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨B, hy⟩ := Set.mem_iUnion.1 hy
      exact mul_eq_smul_mul_of_mem_weightedMonomials hpar hx hy
    | zero => simp
    | add a b _ _ iha ihb => rw [mul_add, iha, ihb, add_mul, smul_add]
    | smul c a _ iha => rw [mul_smul_comm, iha, smul_comm, smul_mul_assoc]
  | zero => simp
  | add a b _ _ iha ihb => rw [add_mul, iha, ihb, mul_add, smul_add]
  | smul c a _ iha => rw [smul_mul_assoc, iha, smul_comm, mul_smul_comm]

end GaugeFieldData

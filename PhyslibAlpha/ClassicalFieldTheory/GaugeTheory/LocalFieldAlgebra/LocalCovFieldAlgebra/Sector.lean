open MatrixGroups
open GaugeFieldData.LocalCovFieldAlgebra (covFieldStrength covFermion covConjFermion covBoson
  covConjBoson repValue repGaugeLorentz)

namespace GaugeFieldData

variable {κ : Type} [Fintype κ] [DecidableEq κ] {G : GlobalGaugeGroup κ} (T : GaugeFieldData G)

/-!

## A. The sectors

### A.1. Products of generators with a given set of kinds

-/

/-- The products of covariant generators whose set of kinds is exactly `A`, of any mass
  weight. The empty product `1` is the only one for `A = ∅`. -/
abbrev sectorMonomials (A : Finset FieldKind) : Set T.LocalCovFieldAlgebra :=
  ⋃ w, T.weightedMonomials A w

lemma one_mem_sectorMonomials_empty : (1 : T.LocalCovFieldAlgebra) ∈ T.sectorMonomials ∅ :=
  Set.mem_iUnion.2 ⟨0, one_mem_weightedMonomials T⟩

variable {T}

/-- A generator of kind `k` is a product of generators with set of kinds `{k}`. -/
lemma mem_sectorMonomials_singleton {k : FieldKind} {b : T.LocalCovFieldAlgebra}
    (hb : b ∈ T.kindGenerators k) : b ∈ T.sectorMonomials {k} :=
  (exists_mem_weightedGenerators hb).elim fun w hw =>
    Set.mem_iUnion.2 ⟨w, mem_weightedMonomials_singleton hw⟩

/-- The product of two products of generators has the union of their sets of kinds. -/
lemma mul_mem_sectorMonomials {A B : Finset FieldKind} {x y : T.LocalCovFieldAlgebra}
    (hx : x ∈ T.sectorMonomials A) (hy : y ∈ T.sectorMonomials B) :
    x * y ∈ T.sectorMonomials (A ∪ B) := by
  obtain ⟨v, hx⟩ := Set.mem_iUnion.1 hx
  obtain ⟨w, hy⟩ := Set.mem_iUnion.1 hy
  exact Set.mem_iUnion.2 ⟨v + w, mul_mem_weightedMonomials hx hy⟩

/-- The only product of generators with no kinds is the empty product. -/
lemma sectorMonomials_empty : T.sectorMonomials ∅ = {1} := by
  ext x
  constructor
  · intro hx
    obtain ⟨w, hx⟩ := Set.mem_iUnion.1 hx
    exact (eq_one_of_mem_weightedMonomials_empty hx).2
  · intro hx
    rw [Set.mem_singleton_iff.1 hx]
    exact one_mem_sectorMonomials_empty T

/-- Multiplication carries the spans of the products with sets of kinds `A` and `B` into the
  span of the products with set of kinds `A ∪ B`. -/
lemma mul_mem_span_sectorMonomials {A B : Finset FieldKind} {x y : T.LocalCovFieldAlgebra}
    (hx : x ∈ Submodule.span ℂ (T.sectorMonomials A))
    (hy : y ∈ Submodule.span ℂ (T.sectorMonomials B)) :
    x * y ∈ Submodule.span ℂ (T.sectorMonomials (A ∪ B)) := by
  have hxy := Submodule.mul_mem_mul hx hy
  rw [Submodule.span_mul_span] at hxy
  refine Submodule.span_mono ?_ hxy
  rintro _ ⟨a, ha, b, hb, rfl⟩
  exact mul_mem_sectorMonomials ha hb

/-!

### A.2. The sector of a set of kinds

-/

variable (T) in
/-- The sector of a set `A` of kinds, the span of the products of covariant generators whose set
  of kinds is exactly `A`. It is a non-unital subalgebra since `A ∪ A = A`. For nonempty `A` it
  is spanned by nonempty products, and `T.sector ∅` is the constants `ℂ • 1`. -/
noncomputable def sector (A : Finset FieldKind) : NonUnitalSubalgebra ℂ T.LocalCovFieldAlgebra :=
  (Submodule.span ℂ (T.sectorMonomials A)).toNonUnitalSubalgebra fun _ _ hx hy => by
    have h := mul_mem_span_sectorMonomials hx hy
    rwa [Finset.union_self] at h

lemma mem_sector_iff {A : Finset FieldKind} {x : T.LocalCovFieldAlgebra} :
    x ∈ T.sector A ↔ x ∈ Submodule.span ℂ (T.sectorMonomials A) := Iff.rfl

/-- A generator of kind `k` lies in the sector of `{k}`. -/
lemma mem_sector_of_mem_kindGenerators {k : FieldKind} {b : T.LocalCovFieldAlgebra}
    (hb : b ∈ T.kindGenerators k) : b ∈ T.sector {k} :=
  Submodule.subset_span (mem_sectorMonomials_singleton hb)

/-- Multiplication carries the sectors of `A` and `B` into the sector of `A ∪ B`. -/
lemma mul_mem_sector {A B : Finset FieldKind} {x y : T.LocalCovFieldAlgebra}
    (hx : x ∈ T.sector A) (hy : y ∈ T.sector B) : x * y ∈ T.sector (A ∪ B) :=
  mul_mem_span_sectorMonomials hx hy

/-- The sector of the empty set of kinds is the constants. -/
lemma mem_sector_empty_iff {x : T.LocalCovFieldAlgebra} :
    x ∈ T.sector ∅ ↔ ∃ c : ℂ, c • 1 = x := by
  rw [mem_sector_iff, sectorMonomials_empty, Submodule.mem_span_singleton]

/-!

### A.3. The seven named sectors

-/

variable (T)

/-- The pure gauge sector, of the polynomials in the field strength `F_μν` and its covariant
  derivatives alone. It contains the Yang-Mills term `tr F_μν F^μν`, the theta term
  `tr F_μν F̃^μν` and higher-derivative terms such as `tr ∇_ρ F_μν ∇^ρ F^μν`. -/
noncomputable abbrev gaugeSector : NonUnitalSubalgebra ℂ T.LocalCovFieldAlgebra :=
  T.sector {FieldKind.gauge}

/-- The pure scalar sector, of the polynomials in the bosonic matter fields, their conjugates
  and their covariant derivatives alone. It contains the kinetic term `(∇_μ φ)† ∇^μ φ` and the
  potential terms `φ† φ` and `(φ† φ)²`. -/
noncomputable abbrev scalarSector : NonUnitalSubalgebra ℂ T.LocalCovFieldAlgebra :=
  T.sector {FieldKind.scalar}

/-- The pure fermion sector, of the polynomials in the fermionic matter fields, their
  conjugates and their covariant derivatives alone. It contains the kinetic term
  `ψ̄ γ^μ ∇_μ ψ`, the Majorana mass terms `ψ ψ` and the four-fermion terms `(ψ̄ γ^μ ψ)²`. -/
noncomputable abbrev fermionSector : NonUnitalSubalgebra ℂ T.LocalCovFieldAlgebra :=
  T.sector {FieldKind.fermion}

/-- The Yukawa sector, of the products containing fermions and scalars but no field strength.
  It contains the Yukawa couplings `ψ̄ φ ψ`, the Weinberg operator `L L φ φ` and the current
  terms `(φ† ∇_μ φ) (ψ̄ γ^μ ψ)`. -/
noncomputable abbrev yukawaSector : NonUnitalSubalgebra ℂ T.LocalCovFieldAlgebra :=
  T.sector {FieldKind.fermion, FieldKind.scalar}

/-- The gauge-Higgs sector, of the products containing field strengths and scalars but no
  fermions. It contains the terms `(φ† φ) tr F_μν F^μν` and `φ† F_μν F̃^μν φ`. -/
noncomputable abbrev gaugeHiggsSector : NonUnitalSubalgebra ℂ T.LocalCovFieldAlgebra :=
  T.sector {FieldKind.gauge, FieldKind.scalar}

/-- The fermion-gauge sector, of the products containing fermions and field strengths but no
  scalars. It contains the dipole terms `ψ̄ σ^μν F_μν ψ` and the terms `ψ̄ γ^μ ∇^ν F_μν ψ`. -/
noncomputable abbrev fermionGaugeSector : NonUnitalSubalgebra ℂ T.LocalCovFieldAlgebra :=
  T.sector {FieldKind.fermion, FieldKind.gauge}

/-- The mixed sector, of the products containing fermions, field strengths and scalars. It
  contains the dipole terms `ψ̄ σ^μν φ F_μν ψ`. -/
noncomputable abbrev mixedSector : NonUnitalSubalgebra ℂ T.LocalCovFieldAlgebra :=
  T.sector {FieldKind.fermion, FieldKind.gauge, FieldKind.scalar}

variable {T}

/-!

## B. Stability under the gauge and Lorentz groups

-/

/-- A unital multiplicative linear map carrying every generator into the span of the generators
  of the same kind and mass weight preserves every sector. -/
lemma map_mem_sector {f : T.LocalCovFieldAlgebra →ₗ[ℂ] T.LocalCovFieldAlgebra} (h1 : f 1 = 1)
    (hmul : ∀ x y, f (x * y) = f x * f y)
    (hgen : ∀ k w, ∀ b ∈ T.weightedGenerators k w,
      f b ∈ Submodule.span ℂ (T.weightedGenerators k w))
    {A : Finset FieldKind} {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sector A) :
    f x ∈ T.sector A := by
  rw [mem_sector_iff] at hx ⊢
  refine (Submodule.span_le (p := (Submodule.span ℂ (T.sectorMonomials A)).comap f)).2 ?_ hx
  intro y hy
  obtain ⟨w, hy⟩ := Set.mem_iUnion.1 hy
  exact Submodule.span_mono (Set.subset_iUnion (fun w => T.weightedMonomials A w) w)
    (map_mem_span_weightedMonomials h1 hmul hgen (Submodule.subset_span hy))

/-- The jet gauge group preserves every sector. -/
lemma repJet_mem_sector (U : G.gaugeJetGroup) {A : Finset FieldKind}
    {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sector A) :
    LocalCovFieldAlgebra.repJet T U x ∈ T.sector A :=
  map_mem_sector (f := LocalCovFieldAlgebra.repJet T U)
    (Subtype.ext (GaugeFieldData.repJet_apply_one U))
    (LocalCovFieldAlgebra.repJet_apply_mul U)
    (fun _ _ _ hb => Submodule.subset_span (repJet_mem_weightedGenerators U hb)) hx

/-- The ordinary gauge group preserves every sector. -/
lemma repValue_mem_sector (g : G.group) {A : Finset FieldKind} {x : T.LocalCovFieldAlgebra}
    (hx : x ∈ T.sector A) : repValue T g x ∈ T.sector A :=
  repJet_mem_sector (G.gaugeJetOfConstant g) hx

/-- The Lorentz group preserves every sector. -/
lemma repLorentzGroup_mem_sector (hGL : T.GaugeLorentzCompatible) (Λ : SL(2,ℂ))
    {A : Finset FieldKind} {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sector A) :
    LocalCovFieldAlgebra.repLorentzGroup T hGL Λ x ∈ T.sector A :=
  map_mem_sector (f := LocalCovFieldAlgebra.repLorentzGroup T hGL Λ)
    (LocalCovFieldAlgebra.repLorentzGroup_apply_one hGL Λ)
    (LocalCovFieldAlgebra.repLorentzGroup_apply_mul hGL Λ)
    (fun _ _ _ hb => repLorentzGroup_mem_span_weightedGenerators hGL Λ hb) hx

/-- The joint action of the gauge and Lorentz groups preserves every sector. -/
lemma repGaugeLorentz_mem_sector (hC : T.GaugeLorentzCommute) (q : G.group × SL(2,ℂ))
    {A : Finset FieldKind}
    {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sector A) :
    repGaugeLorentz T hC q x ∈ T.sector A := by
  rw [repGaugeLorentz, Representation.prodOfCommute_apply, mul_apply_eq_comp]
  exact repValue_mem_sector q.1 (repLorentzGroup_mem_sector hC.gaugeLorentzCompatible q.2 hx)

/-- Every element of the monoid algebra of `G × SL(2,ℂ)` preserves every sector. -/
lemma asAlgebraHom_repGaugeLorentz_mem_sector (hC : T.GaugeLorentzCommute)
    (r : MonoidAlgebra ℂ (G.group × SL(2,ℂ)))
    {A : Finset FieldKind} {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sector A) :
    (repGaugeLorentz T hC).asAlgebraHom r x ∈ T.sector A := by
  induction r using MonoidAlgebra.induction_linear with
  | zero =>
    rw [map_zero, LinearMap.zero_apply]
    exact zero_mem _
  | add r₁ r₂ h₁ h₂ =>
    rw [map_add, LinearMap.add_apply]
    exact add_mem h₁ h₂
  | single q c =>
    rw [Representation.asAlgebraHom_single, LinearMap.smul_apply]
    exact SMulMemClass.smul_mem c (repGaugeLorentz_mem_sector hC q hx)

/-!

## C. The sectors span the covariant field algebra

-/

/-- Every element of the covariant field algebra is a combination of products of generators. -/
lemma mem_span_iUnion_sectorMonomials (x : T.LocalCovFieldAlgebra) :
    x ∈ Submodule.span ℂ (⋃ A, T.sectorMonomials A) :=
  mem_span_weightedMonomials x

/-- Every element of the covariant field algebra is a sum of one element from the sector of
  each set of kinds, the sector of `∅` supplying the constants. The decomposition is not
  unique, since the covariant field algebra is not free on its generators. -/
lemma exists_eq_sum_sector (x : T.LocalCovFieldAlgebra) :
    ∃ y : Finset FieldKind → T.LocalCovFieldAlgebra, (∀ A, y A ∈ T.sector A) ∧ x = ∑ A, y A := by
  have hx := mem_span_iUnion_sectorMonomials x
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨A, hA⟩ := Set.mem_iUnion.1 hx
    refine ⟨Pi.single A x, fun B => ?_, by simp⟩
    by_cases hB : B = A
    · subst hB
      rw [Pi.single_eq_same]
      exact Submodule.subset_span hA
    · rw [Pi.single_eq_of_ne hB]
      exact zero_mem _
  | zero => exact ⟨0, fun _ => zero_mem _, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨y₁, h₁, rfl⟩ := hx
    obtain ⟨y₂, h₂, rfl⟩ := hy
    exact ⟨y₁ + y₂, fun A => add_mem (h₁ A) (h₂ A), by simp [Finset.sum_add_distrib]⟩
  | smul c x _ hx =>
    obtain ⟨y, h, rfl⟩ := hx
    exact ⟨c • y, fun A => SMulMemClass.smul_mem c (h A), by simp [Finset.smul_sum]⟩

/-- Every element of the covariant field algebra is a constant plus a sum of one element from
  each of the seven nonempty sectors, `x = c • 1 + ∑_{A ≠ ∅} x_A`.

  The decomposition is not unique. The covariant field algebra is not free on its generators.
  The Ricci identity `[∇_μ, ∇_ν] ψ = F_μν ψ` and the Bianchi identity relate products of
  different kinds, so the sectors span the covariant field algebra but their sum is not
  direct. -/
lemma exists_eq_smul_one_add_sum_sector (x : T.LocalCovFieldAlgebra) :
    ∃ (c : ℂ) (y : Finset FieldKind → T.LocalCovFieldAlgebra), (∀ A, y A ∈ T.sector A) ∧
      x = c • 1 + ∑ A ∈ Finset.univ.erase ∅, y A :=
  (exists_eq_sum_sector x).elim fun y hy => (mem_sector_empty_iff.1 (hy.1 ∅)).elim fun c hc =>
    ⟨c, y, hy.1, by rw [hc, Finset.add_sum_erase _ _ (Finset.mem_univ _), hy.2]⟩

/-!

## D. The sectors at a fixed mass weight

-/

variable (T) in
/-- The weight-`w` piece of the sector of `A`, the span of the products of covariant generators
  with set of kinds `A` and total mass weight `w`. -/
noncomputable def sectorMassWeight (A : Finset FieldKind) (w : ℕ) :
    Submodule ℂ T.LocalCovFieldAlgebra :=
  Submodule.span ℂ (T.weightedMonomials A w)

/-- A product of generators lies in the weight piece of its sector given by its weight. -/
lemma mem_sectorMassWeight_of_mem_weightedMonomials {A : Finset FieldKind} {w : ℕ}
    {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.weightedMonomials A w) : x ∈ T.sectorMassWeight A w :=
  Submodule.subset_span hx

/-- The weight pieces of a sector lie in the sector. -/
lemma mem_sector_of_mem_sectorMassWeight {A : Finset FieldKind} {w : ℕ}
    {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sectorMassWeight A w) : x ∈ T.sector A :=
  Submodule.span_mono (Set.subset_iUnion (fun w => T.weightedMonomials A w) w) hx

/-- Multiplication carries the weight-`v` piece of the sector of `A` and the weight-`w` piece of
  the sector of `B` into the weight-`v + w` piece of the sector of `A ∪ B`. -/
lemma mul_mem_sectorMassWeight {A B : Finset FieldKind} {v w : ℕ} {x y : T.LocalCovFieldAlgebra}
    (hx : x ∈ T.sectorMassWeight A v) (hy : y ∈ T.sectorMassWeight B w) :
    x * y ∈ T.sectorMassWeight (A ∪ B) (v + w) := by
  rw [sectorMassWeight] at hx hy ⊢
  have hxy := Submodule.mul_mem_mul hx hy
  rw [Submodule.span_mul_span] at hxy
  refine Submodule.span_mono ?_ hxy
  rintro _ ⟨a, ha, b, hb, rfl⟩
  exact mul_mem_weightedMonomials ha hb

/-- The gauge group preserves the weight pieces of every sector. -/
lemma repValue_mem_sectorMassWeight (g : G.group) {A : Finset FieldKind} {w : ℕ}
    {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sectorMassWeight A w) :
    repValue T g x ∈ T.sectorMassWeight A w :=
  repValue_mem_span_weightedMonomials g hx

/-- The Lorentz group preserves the weight pieces of every sector. -/
lemma repLorentzGroup_mem_sectorMassWeight (hGL : T.GaugeLorentzCompatible) (Λ : SL(2,ℂ))
    {A : Finset FieldKind} {w : ℕ} {x : T.LocalCovFieldAlgebra}
    (hx : x ∈ T.sectorMassWeight A w) :
    LocalCovFieldAlgebra.repLorentzGroup T hGL Λ x ∈ T.sectorMassWeight A w :=
  repLorentzGroup_mem_span_weightedMonomials hGL Λ hx

/-!

### D.1. The weight components of the sectors

-/

variable {P : T.LocalCovFieldAlgebra →ₐ[ℂ] Polynomial T.LocalCovFieldAlgebra}

/-- Under `IsMassWeightPoly P`, the weight pieces of a sector lie in the weight pieces of the
  covariant field algebra. -/
lemma sectorMassWeight_le_massWeightSubmodule (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    (A : Finset FieldKind) (w : ℕ) :
    T.sectorMassWeight A w ≤ LocalCovFieldAlgebra.massWeightSubmodule P w :=
  Submodule.span_le.2 fun _ hx =>
    LocalCovFieldAlgebra.mem_massWeightSubmodule_of_mem_weightedMonomials hP hx

/-- Under `IsMassWeightPoly P`, the weight-`k` component of an element of the sector of `A`
  lies in the weight-`k` piece of that sector. On a product of generators the component is the
  product or zero, and both sides are linear. -/
lemma massWeightComponent_mem_sectorMassWeight (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    {A : Finset FieldKind} {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sector A) (k : ℕ) :
    LocalCovFieldAlgebra.massWeightComponent P k x ∈ T.sectorMassWeight A k := by
  rw [mem_sector_iff] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, hy⟩ := Set.mem_iUnion.1 hy
    rw [LocalCovFieldAlgebra.massWeightComponent_of_mem
      (LocalCovFieldAlgebra.mem_massWeightSubmodule_of_mem_weightedMonomials hP hy)]
    split_ifs with h
    · subst h
      exact mem_sectorMassWeight_of_mem_weightedMonomials hy
    · exact Submodule.zero_mem _
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add y z _ _ hy hz => rw [map_add]; exact Submodule.add_mem _ hy hz
  | smul c y _ hy => rw [map_smul]; exact Submodule.smul_mem _ c hy

/-- Under `IsMassWeightPoly P`, taking a weight component preserves every sector. -/
lemma massWeightComponent_mem_sector (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    {A : Finset FieldKind} {x : T.LocalCovFieldAlgebra} (hx : x ∈ T.sector A) (k : ℕ) :
    LocalCovFieldAlgebra.massWeightComponent P k x ∈ T.sector A :=
  mem_sector_of_mem_sectorMassWeight (massWeightComponent_mem_sectorMassWeight hP hx k)

/-- Under `IsMassWeightPoly P`, the weight-`w` piece of the sector of `A` is the intersection of
  the sector with the weight-`w` piece of the covariant field algebra. -/
lemma sectorMassWeight_eq_inf (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    (A : Finset FieldKind) (w : ℕ) :
    T.sectorMassWeight A w
      = (T.sector A).toSubmodule ⊓ LocalCovFieldAlgebra.massWeightSubmodule P w := by
  refine le_antisymm (le_inf (fun _ hx => mem_sector_of_mem_sectorMassWeight hx)
    (sectorMassWeight_le_massWeightSubmodule hP A w)) fun x hx => ?_
  obtain ⟨hxA, hxw⟩ := Submodule.mem_inf.1 hx
  rw [← LocalCovFieldAlgebra.massWeightComponent_self hxw]
  exact massWeightComponent_mem_sectorMassWeight hP hxA w

/-- Under `IsMassWeightPoly P`, the weight-`w` piece of the covariant field algebra is the join
  over the sets of kinds of the weight-`w` pieces of the sectors, every product of generators
  having exactly one set of kinds. The join is not direct. -/
lemma massWeightSubmodule_eq_iSup_sectorMassWeight (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    (w : ℕ) :
    LocalCovFieldAlgebra.massWeightSubmodule P w = ⨆ A, T.sectorMassWeight A w := by
  refine le_antisymm ?_ (iSup_le fun A => sectorMassWeight_le_massWeightSubmodule hP A w)
  rw [LocalCovFieldAlgebra.massWeightSubmodule_eq_span hP, Submodule.span_le]
  intro x hx
  obtain ⟨A, hx⟩ := Set.mem_iUnion.1 hx
  exact Submodule.mem_iSup_of_mem A (mem_sectorMassWeight_of_mem_weightedMonomials hx)

/-!

### D.2. Vanishing at low weight

-/

/-- At a non-zero weight the sector of `∅` has no weight piece, since its only product is the empty
  one, of weight zero. -/
lemma sectorMassWeight_empty_of_ne_zero {w : ℕ} (hw : w ≠ 0) :
    T.sectorMassWeight ∅ w = ⊥ := by
  rw [sectorMassWeight, Submodule.span_eq_bot]
  intro x hx
  exact absurd (eq_one_of_mem_weightedMonomials_empty hx).1 hw

/-- If every factor of a product of generators of kind `k` has weight at least `m k`, the
  product has weight at least the sum of `m` over its set of kinds. -/
lemma sum_le_sum_of_forall_le (m : FieldKind → ℕ)
    (L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra)) (h : ∀ p ∈ L, m p.1 ≤ p.2.1) :
    ∑ k ∈ (L.map Prod.fst).toFinset, m k ≤ (L.map fun p => p.2.1).sum := by
  induction L with
  | nil => simp
  | cons q L ih =>
    have ih := ih fun p hp => h p (List.mem_cons.2 (Or.inr hp))
    have hq := h q (List.mem_cons.2 (Or.inl rfl))
    simp only [List.map_cons, List.toFinset_cons, List.sum_cons]
    by_cases hmem : q.1 ∈ (L.map Prod.fst).toFinset
    · rw [Finset.insert_eq_of_mem hmem]
      omega
    · rw [Finset.sum_insert hmem]
      omega

/-- If the generators of each kind `k ∈ A` have mass weight at least `m k`, the sector of `A`
  vanishes at every weight below `∑ k ∈ A, m k`. -/
lemma sectorMassWeight_eq_bot_of_lt {A : Finset FieldKind} {w : ℕ} {m : FieldKind → ℕ}
    (hm : ∀ k ∈ A, ∀ v (b : T.LocalCovFieldAlgebra), b ∈ T.weightedGenerators k v → m k ≤ v)
    (hw : w < ∑ k ∈ A, m k) : T.sectorMassWeight A w = ⊥ := by
  rw [sectorMassWeight, Submodule.span_eq_bot]
  rintro x ⟨L, hL, hA, rfl, -⟩
  have hmem : ∀ p ∈ L, p.1 ∈ A := fun p hp => by
    rw [← hA]
    exact List.mem_toFinset.2 (List.mem_map_of_mem hp)
  have h := sum_le_sum_of_forall_le m L fun p hp => hm p.1 (hmem p hp) p.2.1 p.2.2 (hL p hp)
  rw [hA] at h
  exact absurd h (not_le.2 hw)

/-!

### D.3. Sectors of two kinds

-/

/-- The total mass weight of the factors of kind `c` in a product of generators. -/
def kindWeight (c : FieldKind) (L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra)) : ℕ :=
  ((L.filter fun p => decide (p.1 = c)).map fun p => p.2.1).sum

@[simp] lemma kindWeight_nil (c : FieldKind) :
    kindWeight c ([] : List (FieldKind × ℕ × T.LocalCovFieldAlgebra)) = 0 := rfl

lemma kindWeight_cons_of_eq {c : FieldKind} {q : FieldKind × ℕ × T.LocalCovFieldAlgebra}
    (hq : q.1 = c) (L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra)) :
    kindWeight c (q :: L) = q.2.1 + kindWeight c L := by
  simp [kindWeight, hq]

lemma kindWeight_cons_of_ne {c : FieldKind} {q : FieldKind × ℕ × T.LocalCovFieldAlgebra}
    (hq : q.1 ≠ c) (L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra)) :
    kindWeight c (q :: L) = kindWeight c L := by
  simp [kindWeight, hq]

/-- When every species has positive mass weight, a kind present in a product carries a
  non-zero part of its weight. -/
lemma kindWeight_ne_zero (hpos : T.HasPositiveMassWeights) {c : FieldKind}
    {L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra)}
    (hL : ∀ p ∈ L, p.2.2 ∈ T.weightedGenerators p.1 p.2.1)
    (hc : c ∈ (L.map Prod.fst).toFinset) : kindWeight c L ≠ 0 := by
  induction L with
  | nil => simp at hc
  | cons q L ih =>
    rw [List.map_cons, List.toFinset_cons, Finset.mem_insert] at hc
    by_cases hq : q.1 = c
    · rw [kindWeight_cons_of_eq hq]
      have := pos_of_mem_weightedGenerators hpos (hL q (List.mem_cons.2 (Or.inl rfl)))
      omega
    · rw [kindWeight_cons_of_ne hq]
      exact ih (fun p hp => hL p (List.mem_cons.2 (Or.inr hp)))
        (hc.resolve_left fun hh => hq hh.symm)

/-- Over a product realising only two kinds, the two kind weights add up to the total
  weight. -/
lemma kindWeight_add {c₁ c₂ : FieldKind} (hne : c₁ ≠ c₂)
    {L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra)}
    (hL : ∀ p ∈ L, p.1 = c₁ ∨ p.1 = c₂) :
    kindWeight c₁ L + kindWeight c₂ L = (L.map fun p => p.2.1).sum := by
  induction L with
  | nil => simp
  | cons q L ih =>
    have ht : ∀ p ∈ L, p.1 = c₁ ∨ p.1 = c₂ := fun p hp => hL p (List.mem_cons.2 (Or.inr hp))
    rcases hL q (List.mem_cons.2 (Or.inl rfl)) with hq | hq
    · rw [kindWeight_cons_of_eq hq, kindWeight_cons_of_ne (by rw [hq]; exact hne),
        List.map_cons, List.sum_cons, ← ih ht]
      omega
    · rw [kindWeight_cons_of_eq hq, kindWeight_cons_of_ne (by rw [hq]; exact hne.symm),
        List.map_cons, List.sum_cons, ← ih ht]
      omega

/-- A product of generators of two kinds is a product of an element of weight `kindWeight c₁`
  from a family of submodules dominating the first kind's sector and an element of weight
  `kindWeight c₂` from one dominating the second. The second family is assumed to commute
  past the first. -/
lemma list_prod_mem_mul_of_forall_kind {c₁ c₂ : FieldKind} (hne : c₁ ≠ c₂)
    {M₁ M₂ : ℕ → Submodule ℂ T.LocalCovFieldAlgebra}
    (hM₁ : ∀ w, T.sectorMassWeight {c₁} w ≤ M₁ w) (hM₂ : ∀ w, T.sectorMassWeight {c₂} w ≤ M₂ w)
    (hone₁ : (1 : Submodule ℂ T.LocalCovFieldAlgebra) ≤ M₁ 0)
    (hone₂ : (1 : Submodule ℂ T.LocalCovFieldAlgebra) ≤ M₂ 0)
    (hmul₁ : ∀ a b, M₁ a * M₁ b ≤ M₁ (a + b)) (hmul₂ : ∀ a b, M₂ a * M₂ b ≤ M₂ (a + b))
    (hcomm : ∀ a b, M₂ a * M₁ b ≤ M₁ b * M₂ a)
    (L : List (FieldKind × ℕ × T.LocalCovFieldAlgebra))
    (hL : ∀ p ∈ L, p.2.2 ∈ T.weightedGenerators p.1 p.2.1)
    (hgl : ∀ p ∈ L, p.1 = c₁ ∨ p.1 = c₂) :
    (L.map fun p => p.2.2).prod ∈ M₁ (kindWeight c₁ L) * M₂ (kindWeight c₂ L) := by
  induction L with
  | nil =>
    simp only [List.map_nil, List.prod_nil, kindWeight_nil]
    have h1 : (1 : T.LocalCovFieldAlgebra) ∈ M₁ 0 := hone₁ (Submodule.mem_one.mpr ⟨1, by simp⟩)
    have h2 : (1 : T.LocalCovFieldAlgebra) ∈ M₂ 0 := hone₂ (Submodule.mem_one.mpr ⟨1, by simp⟩)
    simpa using Submodule.mul_mem_mul h1 h2
  | cons q L ih =>
    have hq := hL q (List.mem_cons.2 (Or.inl rfl))
    have hIH := ih (fun p hp => hL p (List.mem_cons.2 (Or.inr hp)))
      (fun p hp => hgl p (List.mem_cons.2 (Or.inr hp)))
    simp only [List.map_cons, List.prod_cons]
    rcases hgl q (List.mem_cons.2 (Or.inl rfl)) with hg | hg
    · have hgm : q.2.2 ∈ M₁ q.2.1 := hM₁ _ (mem_sectorMassWeight_of_mem_weightedMonomials
        (mem_weightedMonomials_singleton (k := c₁) (by rw [← hg]; exact hq)))
      rw [kindWeight_cons_of_eq hg, kindWeight_cons_of_ne (by rw [hg]; exact hne)]
      refine (?_ : M₁ q.2.1 * (M₁ (kindWeight c₁ L) * M₂ (kindWeight c₂ L))
        ≤ M₁ (q.2.1 + kindWeight c₁ L) * M₂ (kindWeight c₂ L)) (Submodule.mul_mem_mul hgm hIH)
      rw [← mul_assoc]
      exact mul_le_mul' (hmul₁ _ _) le_rfl
    · have hgm : q.2.2 ∈ M₂ q.2.1 := hM₂ _ (mem_sectorMassWeight_of_mem_weightedMonomials
        (mem_weightedMonomials_singleton (k := c₂) (by rw [← hg]; exact hq)))
      rw [kindWeight_cons_of_eq hg, kindWeight_cons_of_ne (by rw [hg]; exact hne.symm)]
      refine (?_ : M₂ q.2.1 * (M₁ (kindWeight c₁ L) * M₂ (kindWeight c₂ L))
        ≤ M₁ (kindWeight c₁ L) * M₂ (q.2.1 + kindWeight c₂ L)) (Submodule.mul_mem_mul hgm hIH)
      calc M₂ q.2.1 * (M₁ (kindWeight c₁ L) * M₂ (kindWeight c₂ L))
          = M₂ q.2.1 * M₁ (kindWeight c₁ L) * M₂ (kindWeight c₂ L) := (mul_assoc _ _ _).symm
        _ ≤ M₁ (kindWeight c₁ L) * M₂ q.2.1 * M₂ (kindWeight c₂ L) :=
            mul_le_mul' (hcomm _ _) le_rfl
        _ = M₁ (kindWeight c₁ L) * (M₂ q.2.1 * M₂ (kindWeight c₂ L)) := mul_assoc _ _ _
        _ ≤ M₁ (kindWeight c₁ L) * M₂ (q.2.1 + kindWeight c₂ L) :=
            mul_le_mul' le_rfl (hmul₂ _ _)

/-- The weight-`w` piece of the sector of two kinds is contained in the join, over the
  splittings of `w` into two non-zero parts, of the products of submodule families dominating
  the two one-kind sectors, the second family commuting past the first. This needs every
  species to have positive mass weight, so that each kind present carries non-zero weight. -/
lemma sectorMassWeight_pair_le (hpos : T.HasPositiveMassWeights) {c₁ c₂ : FieldKind}
    (hne : c₁ ≠ c₂) {M₁ M₂ : ℕ → Submodule ℂ T.LocalCovFieldAlgebra}
    (hM₁ : ∀ w, T.sectorMassWeight {c₁} w ≤ M₁ w) (hM₂ : ∀ w, T.sectorMassWeight {c₂} w ≤ M₂ w)
    (hone₁ : (1 : Submodule ℂ T.LocalCovFieldAlgebra) ≤ M₁ 0)
    (hone₂ : (1 : Submodule ℂ T.LocalCovFieldAlgebra) ≤ M₂ 0)
    (hmul₁ : ∀ a b, M₁ a * M₁ b ≤ M₁ (a + b)) (hmul₂ : ∀ a b, M₂ a * M₂ b ≤ M₂ (a + b))
    (hcomm : ∀ a b, M₂ a * M₁ b ≤ M₁ b * M₂ a) (w : ℕ) :
    T.sectorMassWeight {c₁, c₂} w
      ≤ ⨆ (p : ℕ × ℕ) (_ : p.1 + p.2 = w) (_ : p.1 ≠ 0) (_ : p.2 ≠ 0), M₁ p.1 * M₂ p.2 := by
  rw [sectorMassWeight, Submodule.span_le]
  rintro x ⟨L, hL, hS, hsum, rfl⟩
  have hgl : ∀ p ∈ L, p.1 = c₁ ∨ p.1 = c₂ := by
    intro p hp
    have h : p.1 ∈ (L.map Prod.fst).toFinset := List.mem_toFinset.2 (List.mem_map_of_mem hp)
    rw [hS] at h
    simpa using h
  have h1 : c₁ ∈ (L.map Prod.fst).toFinset := by rw [hS]; simp
  have h2 : c₂ ∈ (L.map Prod.fst).toFinset := by rw [hS]; simp
  refine Submodule.mem_iSup_of_mem (kindWeight c₁ L, kindWeight c₂ L)
    (Submodule.mem_iSup_of_mem (by rw [kindWeight_add hne hgl, hsum])
      (Submodule.mem_iSup_of_mem (kindWeight_ne_zero hpos hL h1)
        (Submodule.mem_iSup_of_mem (kindWeight_ne_zero hpos hL h2) ?_)))
  exact list_prod_mem_mul_of_forall_kind hne hM₁ hM₂ hone₁ hone₂ hmul₁ hmul₂ hcomm L hL hgl

/-!

### D.4. Algebras generated by one kind

-/

/-- The algebra generated by generators of one kind `k` lies in the sector of `{k}` plus the
  constants. -/
lemma adjoin_le_sector_sup_sector_empty {k : FieldKind} {s : Set T.LocalCovFieldAlgebra}
    (hs : s ⊆ T.kindGenerators k) :
    Subalgebra.toSubmodule (Algebra.adjoin ℂ s)
      ≤ (T.sector {k}).toSubmodule ⊔ (T.sector ∅).toSubmodule := by
  intro x hx
  rw [Subalgebra.mem_toSubmodule] at hx
  induction hx using Algebra.adjoin_induction with
  | mem y hy => exact Submodule.mem_sup_left (mem_sector_of_mem_kindGenerators (hs hy))
  | algebraMap r =>
    apply Submodule.mem_sup_right
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (one_mem_sectorMonomials_empty T))
  | add a b _ _ iha ihb => exact Submodule.add_mem _ iha ihb
  | mul a b _ _ iha ihb =>
    obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := Submodule.mem_sup.mp iha
    obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := Submodule.mem_sup.mp ihb
    rw [add_mul, mul_add, mul_add]
    refine Submodule.add_mem _ (Submodule.add_mem _ ?_ ?_) (Submodule.add_mem _ ?_ ?_)
    · exact Submodule.mem_sup_left (by simpa using mul_mem_sector ha₁ hb₁)
    · exact Submodule.mem_sup_left (by simpa using mul_mem_sector ha₁ hb₂)
    · exact Submodule.mem_sup_left (by simpa using mul_mem_sector ha₂ hb₁)
    · exact Submodule.mem_sup_right (by simpa using mul_mem_sector ha₂ hb₂)

/-- Under `IsMassWeightPoly P`, the weight-`w` piece of the sector of `A` lies in every
  subalgebra containing the generators of the kinds in `A`, intersected with the weight-`w`
  piece. -/
lemma sectorMassWeight_le_inf (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    {A : Finset FieldKind} {S : Subalgebra ℂ T.LocalCovFieldAlgebra}
    (hS : ∀ k ∈ A, T.kindGenerators k ⊆ S) (w : ℕ) :
    T.sectorMassWeight A w
      ≤ Subalgebra.toSubmodule S ⊓ LocalCovFieldAlgebra.massWeightSubmodule P w := by
  refine le_inf ?_ (sectorMassWeight_le_massWeightSubmodule hP A w)
  rw [sectorMassWeight, Submodule.span_le]
  rintro _ ⟨L, hL, hA, -, rfl⟩
  refine Subalgebra.list_prod_mem _ fun y hy => ?_
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hy
  have hpA : p.1 ∈ A := by
    rw [← hA]
    exact List.mem_toFinset.2 (List.mem_map_of_mem hp)
  exact hS p.1 hpA (mem_kindGenerators_of_mem_weightedGenerators (hL p hp))

/-- Under `IsMassWeightPoly P`, at a non-zero weight `w` the weight-`w` piece of the algebra
  generated by generators of one kind `k` lies in the weight-`w` piece of the sector of `{k}`,
  since the constants have weight zero. -/
lemma inf_massWeightSubmodule_le_sectorMassWeight (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    {k : FieldKind} {s : Set T.LocalCovFieldAlgebra} (hs : s ⊆ T.kindGenerators k) {w : ℕ}
    (hw : w ≠ 0) :
    Subalgebra.toSubmodule (Algebra.adjoin ℂ s) ⊓ LocalCovFieldAlgebra.massWeightSubmodule P w
      ≤ T.sectorMassWeight {k} w := by
  intro x hx
  obtain ⟨hxa, hxw⟩ := Submodule.mem_inf.1 hx
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.1 (adjoin_le_sector_sup_sector_empty hs hxa)
  rw [← LocalCovFieldAlgebra.massWeightComponent_self hxw, map_add]
  have hz' := massWeightComponent_mem_sectorMassWeight hP hz w
  rw [sectorMassWeight_empty_of_ne_zero hw, Submodule.mem_bot] at hz'
  rw [hz', add_zero]
  exact massWeightComponent_mem_sectorMassWeight hP hy w

/-!

## E. The decomposition of invariants

### E.1. Stable subspaces containing a finite family

-/

/-- The elements `a i`, for `i ∈ s`, lie in the span of one finite family on which the gauge and
  Lorentz groups act with continuous coefficients. -/
lemma exists_isContinuousFamily_forall_mem_span (hGL : T.GaugeLorentzCompatible)
    (hL : T.LorentzContinuous) {ι : Type*} (a : ι → T.LocalCovFieldAlgebra) (s : Finset ι) :
    ∃ (ι' : Type) (_ : Fintype ι') (v : ι' → T.LocalCovFieldAlgebra),
      (∀ i ∈ s, a i ∈ Submodule.span ℂ (Set.range v)) ∧
      Representation.IsContinuousFamily (repValue T) v ∧
      Representation.IsContinuousFamily (LocalCovFieldAlgebra.repLorentzGroup T hGL) v := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    exact ⟨Unit, inferInstance, fun _ => 1, fun i hi => by simp at hi,
      Representation.isContinuousFamily_one LocalCovFieldAlgebra.repValue_apply_one,
      Representation.isContinuousFamily_one
        (LocalCovFieldAlgebra.repLorentzGroup_apply_one hGL)⟩
  | insert i s _ ih =>
    obtain ⟨ι', _, v, hv, hv₁, hv₂⟩ := ih
    have h := LocalCovFieldAlgebra.hasContinuousSpan hGL hL (a i)
    unfold Representation.HasContinuousSpan at h
    obtain ⟨κ', _, u, hu, hu₁, hu₂⟩ := h
    refine ⟨ι' ⊕ κ', inferInstance, Sum.elim v u, fun j hj => ?_, hv₁.sumElim hu₁,
      hv₂.sumElim hu₂⟩
    rcases Finset.mem_insert.1 hj with rfl | hj
    · exact Submodule.span_mono (Set.range_subset_iff.2 fun k => ⟨Sum.inr k, rfl⟩ :
        Set.range u ⊆ Set.range (Sum.elim v u)) hu
    · exact Submodule.span_mono (Set.range_subset_iff.2 fun k => ⟨Sum.inl k, rfl⟩ :
        Set.range v ⊆ Set.range (Sum.elim v u)) (hv j hj)

/-- A finite family of elements of the covariant field algebra lies in one finite-dimensional
  subrepresentation of the joint action of the gauge and Lorentz groups, on which both groups
  act with continuous matrix coefficients. This is the version of
  `LocalCovFieldAlgebra.exists_subrepresentation` for a finite family. -/
lemma exists_subrepresentation_forall_mem (hL : T.LorentzContinuous) (hC : T.GaugeLorentzCommute)
    {ι : Type*} [Fintype ι]
    (a : ι → T.LocalCovFieldAlgebra) :
    ∃ W : Subrepresentation (repGaugeLorentz T hC), (∀ i, a i ∈ W.toSubmodule) ∧
      FiniteDimensional ℂ W.toSubmodule ∧
      Representation.ContinuousMatrixCoeff (W.comp (MonoidHom.inl G.group SL(2,ℂ))) ∧
      Representation.ContinuousMatrixCoeff (W.comp (MonoidHom.inr G.group SL(2,ℂ))) := by
  obtain ⟨ι', _, v, hv, h₁, h₂⟩ :=
    exists_isContinuousFamily_forall_mem_span hC.gaugeLorentzCompatible hL a Finset.univ
  have h₁' : Representation.IsContinuousFamily
      ((repGaugeLorentz T hC).comp (MonoidHom.inl G.group SL(2,ℂ))) v := by
    rw [LocalCovFieldAlgebra.repGaugeLorentz_comp_inl]
    exact h₁
  have h₂' : Representation.IsContinuousFamily
      ((repGaugeLorentz T hC).comp (MonoidHom.inr G.group SL(2,ℂ))) v := by
    rw [LocalCovFieldAlgebra.repGaugeLorentz_comp_inr]
    exact h₂
  refine ⟨Representation.spanSubrepresentation
      (LocalCovFieldAlgebra.commute_repValue_repLorentzGroup hC) h₁ h₂,
    fun i => hv i (Finset.mem_univ i), FiniteDimensional.span_of_finite ℂ (Set.finite_range v),
    ?_, ?_⟩
  · exact Representation.continuousMatrixCoeff_of_isContinuousFamily _ rfl h₁'
  · exact Representation.continuousMatrixCoeff_of_isContinuousFamily _ rfl h₂'

/-- For a compact gauge group, the joint action of the gauge and Lorentz groups has a Reynolds
  element on every finite-dimensional subrepresentation with continuous matrix coefficients. -/
lemma exists_isReynolds_repGaugeLorentz [CompactSpace G.group]
    (hC : T.GaugeLorentzCommute)
    (W : Subrepresentation (repGaugeLorentz T hC)) [FiniteDimensional ℂ W.toSubmodule]
    (h₁ : Representation.ContinuousMatrixCoeff (W.comp (MonoidHom.inl G.group SL(2,ℂ))))
    (h₂ : Representation.ContinuousMatrixCoeff (W.comp (MonoidHom.inr G.group SL(2,ℂ)))) :
    ∃ r, (repGaugeLorentz T hC).IsReynolds W.toSubmodule r :=
  -- Term-mode eliminations: `obtain` is slow on these goals.
  (Representation.exists_isReynolds_of_compactSpace
    (W.comp (MonoidHom.inl G.group SL(2,ℂ))) h₁).elim fun _ hr₁ =>
  (Representation.exists_isReynolds_of_specialLinearGroup
    (W.comp (MonoidHom.inr G.group SL(2,ℂ))) h₂).elim fun _ hr₂ =>
  ⟨_, hr₁.mul_mapDomain hr₂⟩

/-!

### E.2. Invariant sector components

-/

/-- An element of the covariant field algebra invariant under the gauge and Lorentz groups is a
  sum of one element from the sector of each set of kinds, every one of them invariant under
  both groups. This needs a compact gauge group, continuous Lorentz representations, and
  commuting gauge and Lorentz representations of every species. The decomposition is not
  unique, since the covariant field algebra is not free on its generators. -/
lemma exists_eq_sum_sector_of_mem_invariants [CompactSpace G.group]
    (hL : T.LorentzContinuous) (hC : T.GaugeLorentzCommute)
    {x : T.LocalCovFieldAlgebra} (h₁ : x ∈ (repValue T).invariants)
    (h₂ : x ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) :
    ∃ y : Finset FieldKind → T.LocalCovFieldAlgebra, (∀ A, y A ∈ T.sector A ∧
      y A ∈ (repValue T).invariants ∧
      y A ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) ∧
      x = ∑ A, y A := by
  -- Term-mode eliminations: `obtain` is slow on these goals.
  refine (exists_eq_sum_sector x).elim fun y hy => ?_
  refine (exists_subrepresentation_forall_mem hL hC y).elim fun W hW => ?_
  have := hW.2.1
  refine (exists_isReynolds_repGaugeLorentz hC W hW.2.2.1 hW.2.2.2).elim fun r hr => ?_
  have hx : x ∈ (repGaugeLorentz T hC).invariants :=
    (Representation.mem_invariants_prodOfCommute_iff (repValue T)
      (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible)
      (LocalCovFieldAlgebra.commute_repValue_repLorentzGroup hC) x).2 ⟨h₁, h₂⟩
  refine ⟨fun A => (repGaugeLorentz T hC).asAlgebraHom r (y A), fun A => ?_, ?_⟩
  · have hinv := (Representation.mem_invariants_prodOfCommute_iff (repValue T)
      (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible)
      (LocalCovFieldAlgebra.commute_repValue_repLorentzGroup hC) _).1
      (hr.apply_mem_invariants (y A) (hW.1 A))
    exact ⟨asAlgebraHom_repGaugeLorentz_mem_sector hC r (hy.1 A), hinv.1, hinv.2⟩
  · calc x = (repGaugeLorentz T hC).asAlgebraHom r x := (hr.apply_of_mem_invariants hx).symm
      _ = _ := by rw [hy.2, map_sum]

/-- An element of the covariant field algebra invariant under the gauge and Lorentz groups is a
  constant plus a sum of one element from each of the seven nonempty sectors,
  `x = c • 1 + ∑_{A ≠ ∅} x_A`, every `x_A` invariant under both groups. This needs a compact
  gauge group, continuous Lorentz representations, and commuting gauge and Lorentz
  representations of every species.

  The decomposition is not unique. The covariant field algebra is not free on its generators.
  The Ricci identity `[∇_μ, ∇_ν] ψ = F_μν ψ` and the Bianchi identity relate products of
  different kinds, so the sectors span the covariant field algebra but their sum is not
  direct. -/
lemma exists_eq_smul_one_add_sum_sector_of_mem_invariants [CompactSpace G.group]
    (hL : T.LorentzContinuous) (hC : T.GaugeLorentzCommute)
    {x : T.LocalCovFieldAlgebra} (h₁ : x ∈ (repValue T).invariants)
    (h₂ : x ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) :
    ∃ (c : ℂ) (y : Finset FieldKind → T.LocalCovFieldAlgebra), (∀ A, y A ∈ T.sector A ∧
      y A ∈ (repValue T).invariants ∧
      y A ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) ∧
      x = c • 1 + ∑ A ∈ Finset.univ.erase ∅, y A :=
  (exists_eq_sum_sector_of_mem_invariants hL hC h₁ h₂).elim fun y hy =>
    (mem_sector_empty_iff.1 (hy.1 ∅).1).elim fun c hc =>
      ⟨c, y, hy.1, by rw [hc, Finset.add_sum_erase _ _ (Finset.mem_univ _), hy.2]⟩

/-!

### E.3. Invariant sector components of given mass weight

The components of the decomposition of section E.2 are projected onto weights. Taking a weight
component keeps an element in its sector and commutes with both groups, and an element of the
filtration at `w` is the sum of its components of weight at most `w`. The argument uses only
these projections, never an expansion of `x` in products of generators, which would not be
unique.

-/

/-- Under `IsMassWeightPoly P`, an invariant element of mass weight at most `w` is a sum of one
  element from the sector of each set of kinds, every one of them of mass weight at most `w` and
  invariant under the gauge and Lorentz groups. -/
lemma exists_eq_sum_sector_of_mem_invariants_massWeightLE [CompactSpace G.group]
    (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    (hL : T.LorentzContinuous) (hC : T.GaugeLorentzCommute)
    {w : ℕ} {x : T.LocalCovFieldAlgebra} (hx : x ∈ LocalCovFieldAlgebra.massWeightSubmoduleLE P w)
    (h₁ : x ∈ (repValue T).invariants)
    (h₂ : x ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) :
    ∃ y : Finset FieldKind → T.LocalCovFieldAlgebra, (∀ A, y A ∈ T.sector A ∧
      y A ∈ LocalCovFieldAlgebra.massWeightSubmoduleLE P w ∧ y A ∈ (repValue T).invariants ∧
      y A ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) ∧
      x = ∑ A, y A := by
  refine (exists_eq_sum_sector_of_mem_invariants hL hC h₁ h₂).elim fun y hy => ?_
  refine ⟨fun A => ∑ k ∈ Finset.range (w + 1), LocalCovFieldAlgebra.massWeightComponent P k (y A),
    fun A => ⟨?_, ?_, ?_, ?_⟩, ?_⟩
  · exact sum_mem fun k _ => massWeightComponent_mem_sector hP (hy.1 A).1 k
  · exact Submodule.sum_mem _ fun k hk =>
      LocalCovFieldAlgebra.massWeightComponent_mem_massWeightSubmoduleLE hP
        (Nat.lt_succ_iff.1 (Finset.mem_range.1 hk)) _
  · exact Submodule.sum_mem _ fun k _ =>
      LocalCovFieldAlgebra.massWeightComponent_mem_invariants_repValue hP k (hy.1 A).2.1
  · exact Submodule.sum_mem _ fun k _ =>
      LocalCovFieldAlgebra.massWeightComponent_mem_invariants_repLorentzGroup hP
        hC.gaugeLorentzCompatible k
        (hy.1 A).2.2
  · calc x = ∑ k ∈ Finset.range (w + 1), LocalCovFieldAlgebra.massWeightComponent P k x :=
          (LocalCovFieldAlgebra.sum_massWeightComponent_of_mem_massWeightSubmoduleLE hx).symm
      _ = _ := by
          rw [hy.2]
          simp only [map_sum]
          exact Finset.sum_comm

/-- Under `IsMassWeightPoly P`, an invariant element of mass weight at most `w` is a constant
  plus a sum of one element from each of the seven nonempty sectors,
  `x = c • 1 + ∑_{A ≠ ∅} x_A`, every `x_A` of mass weight at most `w` and invariant under the
  gauge and Lorentz groups. This needs a compact gauge group, continuous Lorentz
  representations, and commuting gauge and Lorentz representations of every species. The
  decomposition is not unique. -/
lemma exists_eq_smul_one_add_sum_sector_of_mem_invariants_massWeightLE
    [CompactSpace G.group] (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    (hL : T.LorentzContinuous) (hC : T.GaugeLorentzCommute)
    {w : ℕ} {x : T.LocalCovFieldAlgebra} (hx : x ∈ LocalCovFieldAlgebra.massWeightSubmoduleLE P w)
    (h₁ : x ∈ (repValue T).invariants)
    (h₂ : x ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) :
    ∃ (c : ℂ) (y : Finset FieldKind → T.LocalCovFieldAlgebra), (∀ A, y A ∈ T.sector A ∧
      y A ∈ LocalCovFieldAlgebra.massWeightSubmoduleLE P w ∧ y A ∈ (repValue T).invariants ∧
      y A ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) ∧
      x = c • 1 + ∑ A ∈ Finset.univ.erase ∅, y A :=
  (exists_eq_sum_sector_of_mem_invariants_massWeightLE hP hL hC hx h₁
    h₂).elim fun y hy => (mem_sector_empty_iff.1 (hy.1 ∅).1).elim fun c hc =>
      ⟨c, y, hy.1, by rw [hc, Finset.add_sum_erase _ _ (Finset.mem_univ _), hy.2]⟩

/-- Under `IsMassWeightPoly P`, an invariant element of mass weight `w` is a sum of one element
  from the sector of each set of kinds, every one of them of mass weight `w` and invariant under
  the gauge and Lorentz groups. -/
lemma exists_eq_sum_sector_of_mem_invariants_massWeight [CompactSpace G.group]
    (hP : LocalCovFieldAlgebra.IsMassWeightPoly P)
    (hL : T.LorentzContinuous) (hC : T.GaugeLorentzCommute)
    {w : ℕ} {x : T.LocalCovFieldAlgebra} (hx : x ∈ LocalCovFieldAlgebra.massWeightSubmodule P w)
    (h₁ : x ∈ (repValue T).invariants)
    (h₂ : x ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) :
    ∃ y : Finset FieldKind → T.LocalCovFieldAlgebra, (∀ A, y A ∈ T.sector A ∧
      y A ∈ LocalCovFieldAlgebra.massWeightSubmodule P w ∧ y A ∈ (repValue T).invariants ∧
      y A ∈ (LocalCovFieldAlgebra.repLorentzGroup T hC.gaugeLorentzCompatible).invariants) ∧
      x = ∑ A, y A := by
  refine (exists_eq_sum_sector_of_mem_invariants hL hC h₁ h₂).elim fun y hy => ?_
  refine ⟨fun A => LocalCovFieldAlgebra.massWeightComponent P w (y A), fun A =>
    ⟨massWeightComponent_mem_sector hP (hy.1 A).1 w,
      LocalCovFieldAlgebra.massWeightComponent_mem_massWeightSubmodule hP w _,
      LocalCovFieldAlgebra.massWeightComponent_mem_invariants_repValue hP w (hy.1 A).2.1,
      LocalCovFieldAlgebra.massWeightComponent_mem_invariants_repLorentzGroup hP
        hC.gaugeLorentzCompatible w
        (hy.1 A).2.2⟩, ?_⟩
  exact (LocalCovFieldAlgebra.massWeightComponent_self hx).symm.trans (by rw [hy.2, map_sum])

/-- Under `IsMassWeightPoly P`, an invariant element of mass weight `w` is a constant plus a sum
  of one element from each of the seven nonempty sectors, `x = c • 1 + ∑_{A ≠ ∅} x_A`, every
  `x_A` of mass weight `w` and invariant under the gauge and Lorentz groups. The decomposition is

module

public import PhyslibAlpha.ClassicalFieldTheory.GaugeTheory.GlobalGaugeGroup.LieAlgebra.Basic
/-!
# One-parameter subgroups of a global gauge group

The one-parameter subgroup `t ↦ exp (t X)` of a generator `X` of a global gauge group.

## i. Overview

By the definition of the Lie algebra `𝔤` of a global gauge group `G`, each generator
`X ∈ 𝔤` has `exp (t X) ∈ G` for every real `t`. This gives a one-parameter subgroup
`t ↦ exp (t X)` of `G`, a continuous homomorphism from the additive group `ℝ` to `G`. In
physics it is the finite gauge transformation built from the infinitesimal one `X`. A
representation of `G` is differentiated along these subgroups in
`PhyslibAlpha.ClassicalFieldTheory.GaugeTheory.MatterField.DerivRep`.

## ii. Key results

- `GlobalGaugeGroup.oneParameterSubgroup` : the one-parameter subgroup of a generator.
- `GlobalGaugeGroup.oneParameterSubgroup_add` : it is a homomorphism from `ℝ`.
- `GlobalGaugeGroup.continuous_oneParameterSubgroup` : it is continuous.

## iii. Table of contents

- A. The one-parameter subgroup of a generator
- B. Group and topological properties

## iv. References

* B. C. Hall, *Lie Groups, Lie Algebras, and Representations*, 2nd ed., Springer (2015).

-/

@[expose] public section

open Matrix NormedSpace

namespace GlobalGaugeGroup

variable {κ : Type} [Fintype κ] [DecidableEq κ] (G : GlobalGaugeGroup κ)

/-!

## A. The one-parameter subgroup of a generator

-/

/-- The one-parameter subgroup `t ↦ exp (t X)` of the group generated by an element `X` of
  its Lie algebra. -/
noncomputable def oneParameterSubgroup (X : G.lieAlgebra) (t : ℝ) : G.group :=
  ((G.mem_lieAlgebra_iff X.1).1 X.2 t).choose

variable {G}

@[simp]
lemma oneParameterSubgroup_val (X : G.lieAlgebra) (t : ℝ) :
    ((G.oneParameterSubgroup X t : GeneralLinearGroup κ ℂ) : Matrix κ κ ℂ) =
      exp (t • (X : Matrix κ κ ℂ)) :=
  ((G.mem_lieAlgebra_iff X.1).1 X.2 t).choose_spec

lemma oneParameterSubgroup_inv_val (X : G.lieAlgebra) (t : ℝ) :
    (↑(G.oneParameterSubgroup X t : GeneralLinearGroup κ ℂ)⁻¹ : Matrix κ κ ℂ) =
      exp (t • -(X : Matrix κ κ ℂ)) := by
  rw [Matrix.coe_units_inv, oneParameterSubgroup_val, smul_neg, Matrix.exp_neg]

/-- An element of the group with value `exp (t X)` is the one-parameter subgroup of `X` at
  time `t`. -/
lemma eq_oneParameterSubgroup {X : G.lieAlgebra} {t : ℝ} {g : G.group}
    (hg : ((g : GeneralLinearGroup κ ℂ) : Matrix κ κ ℂ) = exp (t • (X : Matrix κ κ ℂ))) :
    g = G.oneParameterSubgroup X t :=
  Subtype.ext (Units.ext (hg.trans (oneParameterSubgroup_val X t).symm))

/-!

## B. Group and topological properties

-/

@[simp]
lemma oneParameterSubgroup_zero (X : G.lieAlgebra) : G.oneParameterSubgroup X 0 = 1 :=
  (eq_oneParameterSubgroup (by simp)).symm

lemma oneParameterSubgroup_add (X : G.lieAlgebra) (s t : ℝ) :
    G.oneParameterSubgroup X (s + t) = G.oneParameterSubgroup X s * G.oneParameterSubgroup X t :=
  (eq_oneParameterSubgroup (by rw [Subgroup.coe_mul, Units.val_mul, oneParameterSubgroup_val,
    oneParameterSubgroup_val, add_smul,
    Matrix.exp_add_of_commute _ _ (((Commute.refl _).smul_left s).smul_right t)])).symm

lemma continuous_oneParameterSubgroup (X : G.lieAlgebra) :
    Continuous (G.oneParameterSubgroup X) := by
  let _ : NormedRing (Matrix κ κ ℂ) := Matrix.linftyOpNormedRing
  let _ : NormedAlgebra ℝ (Matrix κ κ ℂ) := Matrix.linftyOpNormedAlgebra
  refine continuous_induced_rng.2 (Units.continuous_iff.2 ⟨?_, ?_⟩)
  · simp only [Function.comp_def, oneParameterSubgroup_val]
    exact continuous_iff_continuousAt.2 fun t =>
      (hasDerivAt_exp_smul_const (𝕂 := ℝ) (X : Matrix κ κ ℂ) t).continuousAt
  · simp only [Function.comp_def, oneParameterSubgroup_inv_val]
    exact continuous_iff_continuousAt.2 fun t =>
      (hasDerivAt_exp_smul_const (𝕂 := ℝ) (-(X : Matrix κ κ ℂ)) t).continuousAt

end GlobalGaugeGroup

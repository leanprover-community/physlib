module

public import PhyslibAlpha.ClassicalFieldTheory.GaugeTheory.GlobalGaugeGroup.SU
public import PhyslibAlpha.ClassicalFieldTheory.GaugeTheory.GlobalGaugeGroup.SU.Invariants.Basic
/-!
# The eigenspaces of the centre of `SU(N)`

The subspaces on which the central element `ω 1` of `SU(N)` acts by a scalar, and the tensors of
`SU(N)` with no invariants for that reason.

## i. Overview

The centre of `SU(N)` is generated by `ω 1`, for `ω` a primitive `N`-th root of unity
(`GlobalGaugeGroup.SU.centreGenerator`). `centreEigenspace` names the subspace on which it acts by
a scalar `ε` (A). For a representation on an algebra by algebra maps the scalar of a product is the
product of the scalars (B), and a vector that the group fixes and that lies in an eigenspace with
`ε ≠ 1` is zero, also modulo a stable submodule `S` (C).

The element `ω 1` acts on a fundamental index by `ω`, on an anti-fundamental index by `ω̄ = ω⁻¹`
and on an adjoint index by `1`, so on the tensors with colours `c` by `ω` to the number of
fundamental minus anti-fundamental colours of `c` (D). When this power is not one there are no
invariant tensors but zero. For `N ≥ 3` this is the case for two fundamental, or two
anti-fundamental, indices, `ω² ≠ 1` (E).

## ii. Key results

- `suTensor.centreEigenspace` : the subspace on which the centre acts by `ε`.
- `suTensor.mul_le_centreEigenspace` : the scalar of a product is the product of the scalars.
- `suTensor.mem_of_invariant_of_mem_sup_centreEigenspace` : a subspace on which the centre acts by
  `ε ≠ 1` carries no invariant beyond a stable submodule `S`.
- `suTensor.tensorRep_centreGenerator` : the centre acts on the tensors by `ω` to the number of
  fundamental minus anti-fundamental colours.
- `suTensor.invariants_eq_bot_of_zpow_ne_one` : the tensors on which the centre does not act
  trivially have no invariants but zero.
- `suTensor.invariants_fund_pow_two_eq_bot` : for `N ≥ 3` there are no invariant tensors with two
  fundamental indices but zero, and its anti-fundamental twin.

## iii. Table of contents

- A. The eigenspaces of the centre
- B. Scalars multiply
- C. The classification modulo a stable submodule
- D. The centre on the tensors
- E. Tensors with no invariants

## iv. References

The same pattern for `SL(2,ℂ)` is
`PhyslibAlpha.Relativity.LorentzGroup.Invariants.CentreEigenspace`.

-/

@[expose] public section

namespace suTensor

open Matrix MatrixGroups TensorSpecies
open GlobalGaugeGroup (rootOfUnity rootOfUnity_isPrimitiveRoot rootOfUnity_mul_star)
open GlobalGaugeGroup.SU (centreGenerator)

variable {N : ℕ} {V : Type*} [AddCommGroup V] [Module ℂ V]

/-!

## A. The eigenspaces of the centre

-/

/-- The subspace on which the central element `ω 1` of `SU(N)` acts by the scalar `ε`. -/
noncomputable def centreEigenspace (hN : N ≠ 0) (ρ : Representation ℂ (SU N) V) (ε : ℂ) :
    Submodule ℂ V :=
  Module.End.eigenspace (ρ (centreGenerator N hN)) ε

/-- Membership of `centreEigenspace` unfolded: the centre scales the vector by `ε`. -/
lemma mem_centreEigenspace {hN : N ≠ 0} {ρ : Representation ℂ (SU N) V} {ε : ℂ} {x : V} :
    x ∈ centreEigenspace hN ρ ε ↔ ρ (centreGenerator N hN) x = ε • x := by
  simp [centreEigenspace]

/-- Dualising a representation inverts the scalar by which the centre acts. -/
lemma dual_centreGenerator_eq_smul_id {hN : N ≠ 0} {ρ : Representation ℂ (SU N) V} {ε : ℂ}
    (hε : ε ≠ 0) (hρ : ρ (centreGenerator N hN) = ε • LinearMap.id) :
    ρ.dual (centreGenerator N hN) = ε⁻¹ • LinearMap.id := by
  have hinv : ρ (centreGenerator N hN)⁻¹ = ε⁻¹ • LinearMap.id := calc
    ρ (centreGenerator N hN)⁻¹ = ε⁻¹ • (ε • ρ (centreGenerator N hN)⁻¹) := by
      rw [smul_smul, inv_mul_cancel₀ hε, one_smul]
    _ = ε⁻¹ • (ρ (centreGenerator N hN)⁻¹ * ρ (centreGenerator N hN)) := by
      rw [hρ]
      ext x
      simp
    _ = ε⁻¹ • LinearMap.id := by
      rw [← map_mul, inv_mul_cancel, map_one]
      rfl
  ext φ x
  simp [Representation.dual_apply, Module.Dual.transpose_apply, hinv]

/-!

## B. Scalars multiply

-/

variable {A : Type} [Ring A] [Algebra ℂ A]

/-- For a representation by multiplicative maps, the scalar of a product is the product of the
  scalars. -/
lemma mul_le_centreEigenspace {hN : N ≠ 0} {ρ : Representation ℂ (SU N) A}
    (hmul : ∀ (g : SU N) (x y : A), ρ g (x * y) = ρ g x * ρ g y)
    {W₁ W₂ : Submodule ℂ A} {ε₁ ε₂ : ℂ} (h₁ : W₁ ≤ centreEigenspace hN ρ ε₁)
    (h₂ : W₂ ≤ centreEigenspace hN ρ ε₂) :
    W₁ * W₂ ≤ centreEigenspace hN ρ (ε₁ * ε₂) := by
  refine Submodule.mul_le.2 fun a ha b hb => ?_
  rw [mem_centreEigenspace, hmul, mem_centreEigenspace.1 (h₁ ha),
    mem_centreEigenspace.1 (h₂ hb), Algebra.smul_mul_assoc, Algebra.mul_smul_comm, smul_smul]

/-!

## C. The classification modulo a stable submodule

-/

/-- A subspace on which the centre acts by `ε ≠ 1` carries no invariant beyond a stable submodule
  `S`: an invariant of the join with `S` already lies in `S`. -/
lemma mem_of_invariant_of_mem_sup_centreEigenspace {hN : N ≠ 0} {ρ : Representation ℂ (SU N) V}
    {ε : ℂ} (hε : ε ≠ 1) {W : Submodule ℂ V} (hW : W ≤ centreEigenspace hN ρ ε)
    (S : Submodule ℂ V) (hS : ∀ g : SU N, ∀ y ∈ S, ρ g y ∈ S) {x : V} (hx : x ∈ W ⊔ S)
    (hinv : ∀ g : SU N, ρ g x = x) : x ∈ S := by
  simpa using reducesInvariantsTo_bot_of_apply_eq_smul (σ := fun g => ρ g) (centreGenerator N hN)
    hε (fun v hv => mem_centreEigenspace.1 (hW hv)) S hS x hx hinv

/-!

## D. The centre on the tensors

-/

/-- The scalar by which the centre acts on a colour: `ω` on the fundamental colour, `ω̄` on the
  anti-fundamental colour and `1` on the adjoint colour. -/
noncomputable def centreScalar (N : ℕ) : Color → ℂ
  | .fund => rootOfUnity N
  | .antiFund => star (rootOfUnity N)
  | .adj => 1

/-- The centre acts on the representation of each colour by its scalar. -/
lemma rep_centreGenerator (hN : N ≠ 0) (k : Color) (v : modules N k) :
    rep N k (centreGenerator N hN) v = centreScalar N k • v := by
  have hval : (centreGenerator N hN).1 = rootOfUnity N • 1 := rfl
  cases k
  · change (centreGenerator N hN).1 *ᵥ v = rootOfUnity N • v
    ext i
    simp [hval, Matrix.mulVec, dotProduct, Matrix.one_apply]
  · change ((centreGenerator N hN)⁻¹).1ᵀ *ᵥ v = star (rootOfUnity N) • v
    ext i
    simp [val_inv, hval, Matrix.mulVec, dotProduct, Matrix.one_apply]
  · refine adjMat_injective ?_
    change adjMat N (adjRep N (centreGenerator N hN) v) = adjMat N ((1 : ℂ) • v)
    rw [adjMat_adjRep, val_inv, hval, star_smul, star_one, one_smul, smul_mul_assoc,
      Matrix.one_mul, mul_smul_comm, Matrix.mul_one, smul_smul, mul_comm, rootOfUnity_mul_star,
      one_smul]

/-- The centre acts on the tensors with colours `c` by `ω` to the number of fundamental minus
  anti-fundamental colours of `c`. -/
lemma tensorRep_centreGenerator (hN : N ≠ 0) {n : ℕ} (c : Fin n → Color) :
    (suTensor N).tensorRep c (centreGenerator N hN) =
      rootOfUnity N ^ (((Finset.univ.filter fun i => c i = .fund).card : ℤ) -
        (Finset.univ.filter fun i => c i = .antiFund).card) • LinearMap.id := by
  have hω : rootOfUnity N ≠ 0 := (rootOfUnity_isPrimitiveRoot hN).ne_zero hN
  have hstar : star (rootOfUnity N) = (rootOfUnity N)⁻¹ :=
    (eq_inv_of_mul_eq_one_right rootOfUnity_mul_star)
  have hs : ∀ k, centreScalar N k = rootOfUnity N ^ (if k = .fund then 1 else 0) *
      (rootOfUnity N)⁻¹ ^ (if k = .antiFund then 1 else 0) := fun k => by
    cases k <;> simp [centreScalar, hstar]
  rw [tensorRep_eq_prod_smul (fun k v => rep_centreGenerator hN k v) c]
  congr 1
  simp only [hs, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, Finset.sum_boole,
    Nat.cast_id]
  rw [zpow_sub₀ hω, zpow_natCast, zpow_natCast, div_eq_mul_inv, inv_pow]

/-!

## E. Tensors with no invariants

-/

/-- When the centre does not act trivially on the tensors with colours `c`, there are no invariant
  tensors but zero: an invariant tensor is fixed by the centre and scaled by a scalar `≠ 1`. -/
lemma invariants_eq_bot_of_zpow_ne_one (hN : N ≠ 0) {n : ℕ} {c : Fin n → Color}
    (h : rootOfUnity N ^ (((Finset.univ.filter fun i => c i = .fund).card : ℤ) -
      (Finset.univ.filter fun i => c i = .antiFund).card) ≠ 1) :
    ((suTensor N).tensorRep c).invariants = ⊥ := by
  refine Representation.invariants_eq_bot_of_forall fun t ht => ?_
  have h1 := ht (centreGenerator N hN)
  rw [tensorRep_centreGenerator, LinearMap.smul_apply, LinearMap.id_apply] at h1
  have h2 : (rootOfUnity N ^ (((Finset.univ.filter fun i => c i = .fund).card : ℤ) -
      (Finset.univ.filter fun i => c i = .antiFund).card) - 1) • t = 0 := by
    rw [sub_smul, h1, one_smul, sub_self]
  exact (smul_eq_zero.1 h2).resolve_left (sub_ne_zero.2 h)

/-- For `N ≥ 3`, `ω² ≠ 1`. -/
lemma rootOfUnity_sq_ne_one (hN : 3 ≤ N) : rootOfUnity N ^ 2 ≠ 1 :=
  (rootOfUnity_isPrimitiveRoot (by omega)).pow_ne_one_of_pos_of_lt two_ne_zero (by omega)

/-- For `N ≥ 3` there are no invariant tensors with two fundamental indices but zero. The centre
  scales them by `ω² ≠ 1`. -/
lemma invariants_fund_pow_two_eq_bot (hN : 3 ≤ N) :
    ((suTensor N).tensorRep fun _ : Fin 2 => .fund).invariants = ⊥ := by
  refine invariants_eq_bot_of_zpow_ne_one (by omega) ?_
  simpa using rootOfUnity_sq_ne_one hN

/-- For `N ≥ 3` there are no invariant tensors with two anti-fundamental indices but zero. The
  centre scales them by `ω⁻² ≠ 1`. -/
lemma invariants_antiFund_pow_two_eq_bot (hN : 3 ≤ N) :
    ((suTensor N).tensorRep fun _ : Fin 2 => .antiFund).invariants = ⊥ := by
  refine invariants_eq_bot_of_zpow_ne_one (by omega) ?_
  simpa using rootOfUnity_sq_ne_one hN

variable {B : Type*} [AddCommGroup B] [Module ℂ B] {ρ : Representation ℂ (SU N) B}

/-- For `N ≥ 3` and a family with two fundamental labels whose map is equivariant, the
  invariants of the span reduce to `⊥`. -/
lemma reducesInvariantsTo_bot_span_fund (hN : 3 ≤ N) {T : (Fin 2 → Fin N) → B}
    (hT : (suTensor N).IsEquivariant (fun _ => .fund) ρ (liftComponents T)) :
    ReducesInvariantsTo (fun g : SU N => ρ g) (Submodule.span ℂ (Set.range T)) ⊥ := by
  rw [← range_liftComponents (S := suTensor N) (c := fun _ : Fin 2 => Color.fund) T]
  exact hT.reducesInvariantsTo_bot (hasReynolds N _) (invariants_fund_pow_two_eq_bot hN)

/-- For `N ≥ 3` and a family with two anti-fundamental labels whose map is equivariant, the
  invariants of the span reduce to `⊥`. -/
lemma reducesInvariantsTo_bot_span_antiFund (hN : 3 ≤ N) {T : (Fin 2 → Fin N) → B}
    (hT : (suTensor N).IsEquivariant (fun _ => .antiFund) ρ (liftComponents T)) :
    ReducesInvariantsTo (fun g : SU N => ρ g) (Submodule.span ℂ (Set.range T)) ⊥ := by
  rw [← range_liftComponents (S := suTensor N) (c := fun _ : Fin 2 => Color.antiFund) T]
  exact hT.reducesInvariantsTo_bot (hasReynolds N _) (invariants_antiFund_pow_two_eq_bot hN)

end suTensor

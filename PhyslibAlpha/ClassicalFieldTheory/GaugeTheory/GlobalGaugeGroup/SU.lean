module

public import PhyslibAlpha.ClassicalFieldTheory.GaugeTheory.GlobalGaugeGroup.LieAlgebra.Basic
public import Physlib.Mathematics.ForMathlib.DataStructures.Matrix.LieTrace
public import Mathlib.RingTheory.RootsOfUnity.Complex
/-!
# The global gauge group SU(n)

The special unitary group, as a global gauge group.

## i. Overview

The gauge groups of the strong and weak interactions are `SU(3)` and `SU(2)`, and `SU(n)`
is the gauge group of Yang–Mills theory with `n` colours. It is the group of unitary
`n × n` complex matrices of determinant one. Both conditions are closed, so `SU(n)` is a
closed submonoid of matrices. It is closed under the conjugate transpose, which is the
inverse of a unitary matrix, so an invertible matrix lies in the global gauge group `SU(n)`
exactly when it is special unitary.

Every traceless anti-hermitian matrix `X` is a generator of `SU(n)`. The exponential
`exp (t X)` is unitary, its conjugate transpose being `exp (−t X)`, and has determinant
`exp (t tr X) = 1`. The hermitian generators of physics, such as the Gell-Mann matrices for
`SU(3)`, are `−i X`.

The scalar matrices in `SU(n)` are the multiples of the identity by an `n`-th root of unity.
They form the centre `ℤ_n` of `SU(n)`, generated by the multiple of the identity by the primitive
root of unity `exp (2 π i / n)`.

## ii. Key results

- `GlobalGaugeGroup.SU` : the global gauge group `SU(n)`.
- `GlobalGaugeGroup.mem_SU_iff` : an invertible matrix lies in `SU(n)` exactly when it is
  unitary of determinant one.
- `GlobalGaugeGroup.mem_lieAlgebra_SU` : traceless anti-hermitian matrices are generators of
  `SU(n)`.
- `GlobalGaugeGroup.trace_eq_zero_of_mem_lieAlgebra_SU` : generators of `SU(n)` are traceless.
- `GlobalGaugeGroup.SU.centreGenerator` : the generator of the centre `ℤ_n` of `SU(n)`.

## iii. Table of contents

- A. The group SU(n)
- B. The Lie algebra of SU(n)
- C. The centre of SU(n)

## iv. References

* None.

-/

@[expose] public section

open Matrix

namespace GlobalGaugeGroup

/-!

## A. The group SU(n)

-/

/-- The special unitary matrices form a closed set, as unitarity and the determinant are
  closed conditions. -/
lemma isClosed_specialUnitaryGroup (n : ℕ) :
    IsClosed (specialUnitaryGroup (Fin n) ℂ : Set (Matrix (Fin n) (Fin n) ℂ)) := by
  rw [specialUnitaryGroup, Submonoid.coe_inf, MonoidHom.coe_mker]
  exact isClosed_unitary.inter (isClosed_singleton.preimage continuous_id.matrix_det)

/-- The global gauge group `SU(n)`, the unitary `n × n` complex matrices of determinant
  one. -/
def SU (n : ℕ) : GlobalGaugeGroup (Fin n) :=
  ofSubmonoid (specialUnitaryGroup (Fin n) ℂ) (isClosed_specialUnitaryGroup n)

/-- An invertible matrix lies in `SU(n)` exactly when it is unitary of determinant one. -/
lemma mem_SU_iff {n : ℕ} {g : GeneralLinearGroup (Fin n) ℂ} :
    g ∈ (SU n).group ↔ (g : Matrix (Fin n) (Fin n) ℂ) ∈ specialUnitaryGroup (Fin n) ℂ :=
  mem_ofSubmonoid_iff_of_star_mem inf_le_left fun A hA =>
    (star (⟨A, hA⟩ : specialUnitaryGroup (Fin n) ℂ)).2

/-- The special unitary matrices are the elements of the global gauge group `SU(n)`. -/
noncomputable def SU.groupEquiv (n : ℕ) : specialUnitaryGroup (Fin n) ℂ ≃* (SU n).group where
  toFun g := ⟨⟨g.1, star g.1, mem_unitaryGroup_iff.mp (mem_specialUnitaryGroup_iff.mp g.2).1,
      mem_unitaryGroup_iff'.mp (mem_specialUnitaryGroup_iff.mp g.2).1⟩, mem_SU_iff.2 g.2⟩
  invFun g := ⟨g.1.1, mem_SU_iff.1 g.2⟩
  left_inv _ := rfl
  right_inv _ := Subtype.ext (Units.ext rfl)
  map_mul' _ _ := Subtype.ext (Units.ext rfl)

@[simp]
lemma SU.groupEquiv_val {n : ℕ} (g : specialUnitaryGroup (Fin n) ℂ) :
    (((SU.groupEquiv n g : (SU n).group) : GeneralLinearGroup (Fin n) ℂ) :
      Matrix (Fin n) (Fin n) ℂ) = g := rfl

/-!

## B. The Lie algebra of SU(n)

-/

/-- A traceless anti-hermitian matrix is a generator of `SU(n)`. Its exponential is unitary,
  with conjugate transpose the exponential of `−X`, and has determinant `exp (tr X) = 1`. -/
lemma mem_lieAlgebra_SU {n : ℕ} {X : Matrix (Fin n) (Fin n) ℂ} (hX : star X = -X)
    (htr : X.trace = 0) : X ∈ (SU n).lieAlgebra := by
  intro t
  have hY : star (t • X) = -(t • X) := by rw [star_smul, hX, star_trivial, smul_neg]
  have hu : NormedSpace.exp (t • X) * star (NormedSpace.exp (t • X)) = 1 := by
    rw [star_eq_conjTranspose, ← Matrix.exp_conjTranspose, ← star_eq_conjTranspose, hY,
      ← Matrix.exp_add_of_commute _ _ (Commute.refl (t • X)).neg_right, add_neg_cancel,
      NormedSpace.exp_zero]
  have hdet : (NormedSpace.exp (t • X)).det = 1 := by
    rw [Matrix.det_exp, trace_smul, htr, smul_zero, NormedSpace.exp_zero]
  exact ⟨⟨(isUnit_exp (t • X)).unit, mem_SU_iff.2 (mem_specialUnitaryGroup_iff.2
    ⟨mem_unitaryGroup_iff.2 hu, hdet⟩)⟩, rfl⟩

/-- A generator of `SU(n)` is traceless. The determinant of `exp (t X)` is `exp (t tr X)`, and
  it is one for all real `t`, so the derivative `tr X` of this function at `t = 0` vanishes. -/
lemma trace_eq_zero_of_mem_lieAlgebra_SU {n : ℕ} {X : Matrix (Fin n) (Fin n) ℂ}
    (hX : X ∈ (SU n).lieAlgebra) : X.trace = 0 := by
  have h1 : ∀ t : ℝ, Complex.exp (t * X.trace) = 1 := fun t => by
    obtain ⟨g, hg⟩ := hX t
    have hdet := (mem_specialUnitaryGroup_iff.mp (mem_SU_iff.mp g.2)).2
    rw [show (g.1 : Matrix (Fin n) (Fin n) ℂ) = _ from hg, Matrix.det_exp, trace_smul] at hdet
    simpa [← Complex.exp_eq_exp_ℂ] using hdet
  have hd : HasDerivAt (fun t : ℝ => Complex.exp (t * X.trace)) X.trace 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const X.trace).cexp
  have hd0 : HasDerivAt (fun t : ℝ => Complex.exp (t * X.trace)) 0 0 :=
    (hasDerivAt_const (0 : ℝ) (1 : ℂ)).congr_of_eventuallyEq
      (Filter.Eventually.of_forall h1)
  exact hd.unique hd0

/-!

## C. The centre of SU(n)

-/

/-- The primitive `N`-th root of unity `exp (2 π i / N)`. -/
noncomputable def rootOfUnity (N : ℕ) : ℂ := Complex.exp (2 * Real.pi * Complex.I / N)

/-- For `N ≠ 0`, `exp (2 π i / N)` is a primitive `N`-th root of unity. -/
lemma rootOfUnity_isPrimitiveRoot {N : ℕ} (hN : N ≠ 0) :
    IsPrimitiveRoot (rootOfUnity N) N :=
  Complex.isPrimitiveRoot_exp N hN

/-- The root of unity `exp (2 π i / N)` has modulus one, so it times its complex conjugate is
  one. -/
lemma rootOfUnity_mul_star {N : ℕ} : rootOfUnity N * star (rootOfUnity N) = 1 := by
  have h : starRingEnd ℂ (2 * Real.pi * Complex.I / N) = -(2 * Real.pi * Complex.I / N) := by
    simp [map_div₀, Complex.conj_ofReal, Complex.conj_I, neg_div, map_ofNat]
  rw [rootOfUnity, Complex.star_def, ← Complex.exp_conj, h, ← Complex.exp_add, add_neg_cancel,
    Complex.exp_zero]

/-- The generator `ω 1` of the centre `ℤ_N` of `SU(N)`, for `ω = exp (2 π i / N)` the primitive
  `N`-th root of unity. The scalar matrix `ω 1` is unitary and has determinant `ω ^ N = 1`. -/
noncomputable def SU.centreGenerator (N : ℕ) (hN : N ≠ 0) : specialUnitaryGroup (Fin N) ℂ :=
  ⟨rootOfUnity N • 1, by
    rw [mem_specialUnitaryGroup_iff, mem_unitaryGroup_iff, star_smul, star_one, smul_mul_smul,
      Matrix.one_mul, rootOfUnity_mul_star, one_smul, det_smul, det_one, mul_one,
      Fintype.card_fin]
    exact ⟨rfl, (rootOfUnity_isPrimitiveRoot hN).pow_eq_one⟩⟩

end GlobalGaugeGroup

module

public import PhyslibAlpha.ProbabilisticTheory.HilbertSpace.Unbounded.StarHomSpec.Functional
public import PhyslibAlpha.ProbabilisticTheory.HilbertSpace.Unbounded.StarHomSpec.Commutant
public import Mathlib.Analysis.CStarAlgebra.GelfandDuality
public import Mathlib.Topology.Algebra.StarSubalgebra

/-!

# The joint spectral measure of a commuting family

A commuting family of bounded operators closed under adjoints has a joint spectral measure on the
Gelfand spectrum of the C⋆-algebra it generates.

## i. Overview

The closed ⋆-subalgebra of `B(H)` generated by a family of operators that commute with each other
and with each other's adjoints is a commutative C⋆-algebra `A`. By Gelfand duality it is the
algebra of continuous functions on its character space, so the inclusion `A → B(H)` is a unital
⋆-homomorphism from `C(X, ℂ)`, where `X` is the character space. Its spectral measure is the joint
spectral measure of the family: every operator of the family is the integral of its Gelfand
transform, and every operator commuting with the family commutes with the spectral measure.

## ii. Key results

- `CommutingStarFamily` : a commuting family of operators closed under adjoints.
- `CommutingStarFamily.algebra` : the commutative C⋆-algebra generated by the family.
- `CommutingStarFamily.spectralMeasure` : the joint spectral measure, on the character space.
- `CommutingStarFamily.boundedIntegral_gelfandTransform` : each operator of the algebra is the
  integral of its Gelfand transform.
- `CommutingStarFamily.spectralMeasure_commute` : the spectral measure commutes with every operator
  commuting with the family.

## iii. Table of contents

- A. The commutative C⋆-algebra of a family
- B. The joint spectral measure

## iv. References

* None.

-/

@[expose] public section

noncomputable section

namespace ProbabilisticTheory

open MeasureTheory Set Topology WeakDual
open scoped ComplexOrder CStarAlgebra InnerProductSpace

namespace QuantumMechanics

variable (H : Type*) [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- A commuting family of bounded operators closed under adjoints. -/
structure CommutingStarFamily where
  /-- The operators of the family. -/
  carrier : Set (H →L[ℂ] H)
  /-- Any two operators of the family commute. -/
  commute : ∀ a ∈ carrier, ∀ b ∈ carrier, Commute a b
  /-- The adjoint of an operator of the family belongs to the family. -/
  star_mem : ∀ a ∈ carrier, star a ∈ carrier

namespace CommutingStarFamily

variable {H}
variable (F : CommutingStarFamily H)

/-! ## A. The commutative C⋆-algebra of a family -/

lemma isStarNormal_of_mem {a : H →L[ℂ] H} (ha : a ∈ F.carrier) : IsStarNormal a :=
  ⟨F.commute _ ha _ (F.star_mem _ ha) |>.symm⟩

instance isMulCommutative_adjoin : IsMulCommutative (StarAlgebra.adjoin ℂ F.carrier) :=
  StarAlgebra.isMulCommutative_adjoin ℂ (fun _ ha => F.isStarNormal_of_mem ha)
    (fun a ha b hb _ => F.commute a ha b hb)
    (fun a ha b hb _ => F.commute a ha (star b) (F.star_mem b hb))

/-- The closed ⋆-subalgebra of the bounded operators generated by a commuting ⋆-family. -/
def algebra : StarSubalgebra ℂ (H →L[ℂ] H) := (StarAlgebra.adjoin ℂ F.carrier).topologicalClosure

lemma carrier_subset_algebra : F.carrier ⊆ F.algebra := fun _ ha =>
  (StarAlgebra.adjoin ℂ F.carrier).le_topologicalClosure (StarAlgebra.subset_adjoin ℂ _ ha)

instance isClosed_algebra : IsClosed (F.algebra : Set (H →L[ℂ] H)) :=
  StarSubalgebra.isClosed_topologicalClosure _

instance isMulCommutative_algebra : IsMulCommutative F.algebra :=
  inferInstanceAs (IsMulCommutative (StarAlgebra.adjoin ℂ F.carrier).topologicalClosure)

open scoped IsMulCommutative in
/-- The algebra generated by a commuting ⋆-family is a commutative C⋆-algebra. -/
instance commCStarAlgebraAlgebra : CommCStarAlgebra F.algebra where

lemma commute_of_forall_mem_carrier {T : H →L[ℂ] H} (hT : ∀ a ∈ F.carrier, Commute a T)
    {b : H →L[ℂ] H} (hb : b ∈ F.algebra) : Commute b T := by
  have hsub : (StarAlgebra.adjoin ℂ F.carrier : Set (H →L[ℂ] H)) ⊆ Set.centralizer {T} := by
    have h1 : (StarAlgebra.adjoin ℂ F.carrier).toSubalgebra ≤
        Subalgebra.centralizer ℂ ({T} : Set (H →L[ℂ] H)) := by
      rw [StarAlgebra.adjoin_toSubalgebra]
      refine Algebra.adjoin_le fun a ha => ?_
      rcases ha with ha | ha
      · rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
        intro t ht
        rw [Set.mem_singleton_iff.mp ht]
        exact (hT a ha).eq.symm
      · have ha' : a ∈ F.carrier := by
          have := F.star_mem _ ha
          simpa using this
        rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
        intro t ht
        rw [Set.mem_singleton_iff.mp ht]
        exact (hT _ ha').eq.symm
    exact fun x hx => h1 hx
  have hcl : (F.algebra : Set (H →L[ℂ] H)) ⊆ Set.centralizer {T} := by
    rw [algebra, StarSubalgebra.topologicalClosure_coe]
    exact closure_minimal hsub (Set.isClosed_centralizer _)
  exact (Set.mem_centralizer_iff.mp (hcl hb) T rfl).symm

/-! ## B. The joint spectral measure -/

open CharacterSpace in
instance : MeasurableSpace (characterSpace ℂ F.algebra) := borel _

instance : BorelSpace (characterSpace ℂ F.algebra) := ⟨rfl⟩

/-- The inclusion of the algebra as a representation of the continuous functions on its character
space, by Gelfand duality. -/
def starHom : C(characterSpace ℂ F.algebra, ℂ) →⋆ₐ[ℂ] (H →L[ℂ] H) :=
  F.algebra.subtype.comp
    (gelfandStarTransform F.algebra).symm.toStarAlgHom

lemma starHom_gelfandStarTransform (a : F.algebra) :
    F.starHom (gelfandStarTransform F.algebra a) = a := by
  simp [starHom]

lemma starHom_mem_algebra (f : C(characterSpace ℂ F.algebra, ℂ)) : F.starHom f ∈ F.algebra :=
  ((gelfandStarTransform F.algebra).symm f).2

/-- The joint spectral measure of a commuting ⋆-family, on the character space of the
C⋆-algebra it generates. -/
def spectralMeasure : WOTSpectralMeasure (characterSpace ℂ F.algebra) H :=
  starHomSpectralMeasure F.starHom

/-- Every operator of the algebra generated by the family is the integral of its Gelfand
transform against the joint spectral measure. -/
lemma boundedIntegral_gelfandStarTransform [Nonempty (characterSpace ℂ F.algebra)]
    (a : F.algebra) :
    ContinuousLinearMapWOT.toCLM
      (WOTSpectralMeasure.boundedIntegral F.spectralMeasure (gelfandStarTransform F.algebra a)
        (gelfandStarTransform F.algebra a).continuous.measurable
        (boundedIntegral_bound_of_continuous _)) = a := by
  have := starHomSpectralMeasure_boundedIntegral F.starHom (gelfandStarTransform F.algebra a)
  rw [starHom_gelfandStarTransform] at this
  exact this

/-- The joint spectral measure commutes with every bounded operator commuting with the family. -/
lemma spectralMeasure_commute {T : H →L[ℂ] H} (hT : ∀ a ∈ F.carrier, Commute a T) (S : Set _) :
    F.spectralMeasure S * ContinuousLinearMapWOT.ofCLM T =
      ContinuousLinearMapWOT.ofCLM T * F.spectralMeasure S :=
  starHomSpectralMeasure_commute_of_commute F.starHom
    (fun f => F.commute_of_forall_mem_carrier hT (F.starHom_mem_algebra f)) S

end CommutingStarFamily

end QuantumMechanics

end ProbabilisticTheory

end

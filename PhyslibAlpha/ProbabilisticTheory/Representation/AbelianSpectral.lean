public import Mathlib.Topology.Algebra.PontryaginDual

/-!

# The spectral measure of a unitary representation of an abelian group

A unitary representation of a discrete abelian group on a Hilbert space is the integral of the
characters of the group against a projection-valued measure on the Pontryagin dual.

## i. Overview

The unitary operators `π(g)` of a representation of an abelian group commute and are closed under
adjoints, so they have a joint spectral measure on the character space of the C⋆-algebra they
generate. A character of that algebra restricts to a unitary character of the group, which gives
a map from the character space to the Pontryagin dual of the group. Pushing the joint spectral
measure forward along this map gives a projection-valued measure `P` on the dual with
`π(g) = ∫ χ(g) dP(χ)`. Every bounded operator commuting with the representation commutes with `P`.

## ii. Key results

- `UnitaryRep.family` : the commuting ⋆-family of the operators of the representation.
- `UnitaryRep.spectralMeasure` : the projection-valued measure on the Pontryagin dual.
- `UnitaryRep.boundedIntegral_character` : `π(g) = ∫ χ(g) dP(χ)`.
- `UnitaryRep.spectralMeasure_commute` : `P` commutes with every operator commuting with `π`.

## iii. Table of contents

- A. The family of the representation
- B. From the algebra's characters to the dual group
- C. The spectral measure

## iv. References

* None.

-/

@[expose] public section

noncomputable section

namespace ProbabilisticTheory

open MeasureTheory Set Topology WeakDual
open scoped ComplexOrder CStarAlgebra InnerProductSpace

namespace QuantumMechanics

namespace UnitaryRep

variable {G : Type*} [AddCommGroup G]
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
variable (π : Multiplicative G →* unitary (H →L[ℂ] H))

/-! ## A. The family of the representation -/

/-- The operators of a unitary representation of an abelian group, as a commuting ⋆-family. -/
def family : CommutingStarFamily H where
  carrier := Set.range fun g : Multiplicative G => ((π g : unitary (H →L[ℂ] H)) : H →L[ℂ] H)
  commute := by
    rintro _ ⟨g, rfl⟩ _ ⟨h, rfl⟩
    change ((π g : unitary (H →L[ℂ] H)) : H →L[ℂ] H) * (π h : H →L[ℂ] H) =
      (π h : H →L[ℂ] H) * (π g : H →L[ℂ] H)
    rw [← Submonoid.coe_mul, ← Submonoid.coe_mul, ← map_mul, ← map_mul, mul_comm]
  star_mem := by
    rintro _ ⟨g, rfl⟩
    refine ⟨g⁻¹, ?_⟩
    show ((π g⁻¹ : unitary (H →L[ℂ] H)) : H →L[ℂ] H) = star ((π g : unitary
      (H →L[ℂ] H)) : H →L[ℂ] H)
    rw [map_inv, ← Unitary.star_eq_inv, Unitary.coe_star]

lemma mem_family (g : Multiplicative G) :
    ((π g : unitary (H →L[ℂ] H)) : H →L[ℂ] H) ∈ (family π).carrier := ⟨g, rfl⟩

/-! ## B. From the algebra's characters to the dual group -/

/-- The element of the algebra generated by the representation given by `π g`. -/
def elem (g : Multiplicative G) : (family π).algebra :=
  ⟨(π g : H →L[ℂ] H), (family π).carrier_subset_algebra (mem_family π g)⟩

lemma elem_mul (g h : Multiplicative G) : elem π (g * h) = elem π g * elem π h :=
  Subtype.ext (by simp [elem])

lemma elem_one : elem π 1 = 1 := Subtype.ext (by simp [elem])

lemma star_elem (g : Multiplicative G) : star (elem π g) = elem π g⁻¹ :=
  Subtype.ext (by
    show star ((π g : unitary (H →L[ℂ] H)) : H →L[ℂ] H) =
      ((π g⁻¹ : unitary (H →L[ℂ] H)) : H →L[ℂ] H)
    rw [map_inv, ← Unitary.star_eq_inv, Unitary.coe_star])

/-- The value at `π g` of a character of the algebra generated by the representation. -/
def charValue (ψ : characterSpace ℂ (family π).algebra) (g : Multiplicative G) : ℂ :=
  ψ (elem π g)

lemma norm_charValue (ψ : characterSpace ℂ (family π).algebra) (g : Multiplicative G) :
    ‖charValue π ψ g‖ = 1 := by
  have h : charValue π ψ g * star (charValue π ψ g) = 1 := by
    have := congrArg ψ (show elem π g * star (elem π g) = 1 by
      rw [star_elem, ← elem_mul, mul_inv_cancel, elem_one])
    simpa [charValue, map_mul, map_star] using this
  have h2 : ‖charValue π ψ g‖ ^ 2 = 1 := by
    have := congrArg norm h
    simp only [norm_mul, norm_star, norm_one] at this
    nlinarith [norm_nonneg (charValue π ψ g)]
  nlinarith [norm_nonneg (charValue π ψ g)]

lemma charValue_mul (ψ : characterSpace ℂ (family π).algebra) (g h : Multiplicative G) :
    charValue π ψ (g * h) = charValue π ψ g * charValue π ψ h := by
  simp [charValue, elem_mul, map_mul]

lemma charValue_one (ψ : characterSpace ℂ (family π).algebra) : charValue π ψ 1 = 1 := by
  simp [charValue, elem_one]

lemma continuous_charValue (g : Multiplicative G) :
    Continuous fun ψ : characterSpace ℂ (family π).algebra => charValue π ψ g :=
  (WeakDual.eval_continuous (elem π g)).comp continuous_subtype_val

variable [TopologicalSpace G] [DiscreteTopology G]

/-- A character of the algebra generated by the representation restricts to a unitary character
of the group. -/
def dual (ψ : characterSpace ℂ (family π).algebra) : PontryaginDual (Multiplicative G) where
  toFun g := ⟨charValue π ψ g, mem_sphere_zero_iff_norm.mpr (norm_charValue π ψ g)⟩
  map_one' := Circle.ext (charValue_one π ψ)
  map_mul' g h := Circle.ext (charValue_mul π ψ g h)
  continuous_toFun := continuous_of_discreteTopology

@[simp]
lemma coe_dual (ψ : characterSpace ℂ (family π).algebra) (g : Multiplicative G) :
    ((dual π ψ g : Circle) : ℂ) = ψ (elem π g) := rfl

lemma continuous_dual : Continuous (dual π) := by
  refine ContinuousMonoidHom.continuous_of_continuous_uncurry _
    (continuous_prod_of_discrete_right.mpr fun g => ?_)
  exact (continuous_charValue π g).subtype_mk _

/-! ## C. The spectral measure -/

section Spectral

variable [MeasurableSpace (PontryaginDual (Multiplicative G))]
  [BorelSpace (PontryaginDual (Multiplicative G))]

/-- The projection-valued measure of a unitary representation of an abelian group, on the
Pontryagin dual of the group. -/
def spectralMeasure : WOTSpectralMeasure (PontryaginDual (Multiplicative G)) H :=
  (family π).spectralMeasure.map (dual π) (continuous_dual π).measurable

/-- **Spectral theorem for unitary representations of abelian groups**: every operator `π(g)` of
the representation is the integral of the character `χ ↦ χ(g)` against the projection-valued
measure on the Pontryagin dual. -/
lemma boundedIntegral_character (g : Multiplicative G) :
    ContinuousLinearMapWOT.toCLM
      (WOTSpectralMeasure.boundedIntegral (spectralMeasure π)
        (fun χ : PontryaginDual (Multiplicative G) => ((χ g : Circle) : ℂ))
        (TauCeti.PontryaginDual.continuous_coe_eval_const g).measurable
        ⟨1, fun χ => by simp⟩) = ((π g : unitary (H →L[ℂ] H)) : H →L[ℂ] H) := by
  rcases subsingleton_or_nontrivial H with hH | hH
  · exact Subsingleton.elim _ _
  · have : Nontrivial (family π).algebra := ⟨⟨0, 1, fun h => zero_ne_one (congrArg Subtype.val h)⟩⟩
    have : Nonempty (PontryaginDual (Multiplicative G)) := ⟨1⟩
    have hcont := TauCeti.PontryaginDual.continuous_coe_eval_const (G := Multiplicative G) g
    have hmap := starHomSpectralMeasure_boundedIntegral_map (family π).starHom
      (continuous_dual π).measurable (g := fun χ : PontryaginDual (Multiplicative G) =>
        ((χ g : Circle) : ℂ)) hcont.measurable ⟨1, fun χ => by simp⟩
    have hgel := (family π).boundedIntegral_gelfandStarTransform (elem π g)
    refine Eq.trans ?_ hgel
    show ContinuousLinearMapWOT.toCLM (WOTSpectralMeasure.boundedIntegral
      ((starHomSpectralMeasure (family π).starHom).map (dual π) _) _ _ _) = _
    rw [hmap]
    congr 1

end Spectral

end UnitaryRep

end QuantumMechanics

end ProbabilisticTheory

end

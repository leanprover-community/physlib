/-!

# Linearized diffeomorphism gauge transformations

Pure-gauge shifts `δh_{ij} = ∂_i ξ_j + ∂_j ξ_i` and gauge invariance of the linearized Riemann,
Ricci, and Einstein tensors under infinitesimal coordinate transformations.

## i. Overview

An infinitesimal coordinate transformation `x^μ ↦ x^μ - ξ^μ(x)` generated by a `C³` covector
field `ξ` induces the pure-gauge metric perturbation `pureGauge ξ` and transforms `P` to
`gaugeTransform P ξ = P.add (pureGauge ξ)`. By symmetry of second partial derivatives
`∂_μ ∂_ν = ∂_ν ∂_μ`, `linearizedRiemann (pureGauge ξ)` vanishes identically, so `linearizedRiemann`,
`linearizedRicci`, and `linearizedEinstein` are gauge invariant.

## ii. Key results

- `pureGauge`, `gaugeTransform` : pure-gauge perturbation and linearized gauge transformation.
- `linearizedRiemann_pureGauge` : pure-gauge perturbations have zero linearized Riemann curvature.
- `linearizedRiemann_gauge_invariant`, `linearizedRicci_gauge_invariant`,
  `linearizedEinstein_gauge_invariant` : gauge invariance of linearized curvature tensors.

## iii. Table of contents

- A. Gauge transformations and linearized curvature invariance

## iv. References

* R. M. Wald, *General Relativity* (1984), Ch. 4 (Sec. 4.4). [ref: wald_1984_general_relativity]
* C. W. Misner, K. S. Thorne, and J. A. Wheeler, *Gravitation* (1973), Ch. 18.
  [ref: mtw_1973_gravitation]
* S. M. Carroll, *Lecture Notes on General Relativity* (1997), Ch. 6
  (https://arxiv.org/pdf/gr-qc/9712019#page=144). [ref: Carroll1997]
-/

@[expose] public section

namespace GeneralRelativity

namespace Linearized

open Pipeline

/-!

## A. Gauge transformations and linearized curvature invariance

Commutativity of partial derivatives causes infinitesimal coordinate gauge transformations
`δh_{ij} = ∂_i ξ_j + ∂_j ξ_i` to drop out of all linearized curvature tensors.

-/

/-- Pure-gauge metric perturbation `δh_{ij} = ∂_i ξ_j + ∂_j ξ_i`. -/
noncomputable def pureGauge (ξ : (Fin 4 → ℝ) → (Fin 4 → ℝ)) : MetricPerturbation where
  h x i j := coordDeriv i (fun y => ξ y j) x + coordDeriv j (fun y => ξ y i) x
  symm _ := Matrix.IsSymm.ext fun _ _ => add_comm _ _

/-- Infinitesimal coordinate gauge transformation `h'_{ij} = h_{ij} + ∂_i ξ_j + ∂_j ξ_i`. -/
noncomputable def gaugeTransform (P : MetricPerturbation)
    (ξ : (Fin 4 → ℝ) → (Fin 4 → ℝ)) : MetricPerturbation :=
  P.add (pureGauge ξ)

private lemma linearizedChristoffel_pureGauge (ξ : (Fin 4 → ℝ) → (Fin 4 → ℝ)) (x : Fin 4 → ℝ)
    (hξ : ∀ a, ContDiffAt ℝ 2 (fun z => ξ z a) x) (k i j : Fin 4) :
    linearizedChristoffel (pureGauge ξ) x k i j
      = minkowskiMetric4 k k * coordDeriv j (coordDeriv i fun z => ξ z k) x := by
  have d_ki : DifferentiableAt ℝ (coordDeriv k fun z => ξ z i) x :=
    coordDeriv_differentiableAt k (hξ i)
  have d_ik : DifferentiableAt ℝ (coordDeriv i fun z => ξ z k) x :=
    coordDeriv_differentiableAt i (hξ k)
  have d_kj : DifferentiableAt ℝ (coordDeriv k fun z => ξ z j) x :=
    coordDeriv_differentiableAt k (hξ j)
  have d_jk : DifferentiableAt ℝ (coordDeriv j fun z => ξ z k) x :=
    coordDeriv_differentiableAt j (hξ k)
  have d_ij : DifferentiableAt ℝ (coordDeriv i fun z => ξ z j) x :=
    coordDeriv_differentiableAt i (hξ j)
  have d_ji : DifferentiableAt ℝ (coordDeriv j fun z => ξ z i) x :=
    coordDeriv_differentiableAt j (hξ i)
  simp only [linearizedChristoffel, pureGauge]
  rw [coordDeriv_add j x (slice_differentiableAt j d_ki) (slice_differentiableAt j d_ik),
    coordDeriv_add i x (slice_differentiableAt i d_kj) (slice_differentiableAt i d_jk),
    coordDeriv_add k x (slice_differentiableAt k d_ij) (slice_differentiableAt k d_ji),
    coordDeriv_comm k i (hξ j), coordDeriv_comm k j (hξ i), coordDeriv_comm i j (hξ k)]
  ring

/-- Vanishing of the linearized Riemann tensor on any `C³` pure-gauge perturbation
`δh_{ij} = ∂_i ξ_j + ∂_j ξ_i`. -/
lemma linearizedRiemann_pureGauge (ξ : (Fin 4 → ℝ) → (Fin 4 → ℝ)) (x : Fin 4 → ℝ)
    (hξ : ∀ a, ContDiffAt ℝ 3 (fun z => ξ z a) x) (r s m n : Fin 4) :
    linearizedRiemann (pureGauge ξ) x r s m n = 0 := by
  have nh : ∀ᶠ y in nhds x, ∀ a, ContDiffAt ℝ 2 (fun z => ξ z a) y := by
    rw [Filter.eventually_all]; intro a
    exact ((hξ a).of_le (by norm_num)).eventually (by simp)
  have hcongr : ∀ a b,
      (fun y => linearizedChristoffel (pureGauge ξ) y r a b) =ᶠ[nhds x]
        fun y => minkowskiMetric4 r r * coordDeriv b (coordDeriv a fun z => ξ z r) y := by
    intro a b
    filter_upwards [nh] with y hy
    exact linearizedChristoffel_pureGauge ξ y hy r a b
  rw [linearizedRiemann, coordDeriv_congr_nhds m x (hcongr n s),
    coordDeriv_congr_nhds n x (hcongr m s), coordDeriv_const_mul, coordDeriv_const_mul]
  have hcomm1 : (fun y => coordDeriv s (coordDeriv n fun z => ξ z r) y)
      =ᶠ[nhds x] fun y => coordDeriv n (coordDeriv s fun z => ξ z r) y := by
    filter_upwards [nh] with y hy; exact coordDeriv_comm s n (hy r)
  have hcomm2 : (fun y => coordDeriv s (coordDeriv m fun z => ξ z r) y)
      =ᶠ[nhds x] fun y => coordDeriv m (coordDeriv s fun z => ξ z r) y := by
    filter_upwards [nh] with y hy; exact coordDeriv_comm s m (hy r)
  rw [coordDeriv_congr_nhds m x hcomm1, coordDeriv_congr_nhds n x hcomm2]
  have hpds : ContDiffAt ℝ 2 (coordDeriv s fun z => ξ z r) x := contDiffAt_coordDeriv s (hξ r)
  rw [coordDeriv_comm m n hpds]
  ring

/-- Linearized Riemann curvature tensor is invariant under `C³` infinitesimal diffeomorphisms
`h' = h + ∂_i ξ_j + ∂_j ξ_i`. -/
lemma linearizedRiemann_gauge_invariant (P : MetricPerturbation)
    (ξ : (Fin 4 → ℝ) → (Fin 4 → ℝ)) (x : Fin 4 → ℝ)
    (hP : P.IsC2At x) (hξ : ∀ a, ContDiffAt ℝ 3 (fun z => ξ z a) x) (r s m n : Fin 4) :
    linearizedRiemann (gaugeTransform P ξ) x r s m n = linearizedRiemann P x r s m n := by
  have hpg : (pureGauge ξ).IsC2At x := fun a b =>
    (contDiffAt_coordDeriv a (hξ b)).add (contDiffAt_coordDeriv b (hξ a))
  rw [gaugeTransform, linearizedRiemann_add P (pureGauge ξ) x hP hpg r s m n,
    linearizedRiemann_pureGauge ξ x hξ r s m n, add_zero]

/-- Linearized Ricci tensor is gauge invariant under `C³` infinitesimal diffeomorphisms. -/
lemma linearizedRicci_gauge_invariant (P : MetricPerturbation)
    (ξ : (Fin 4 → ℝ) → (Fin 4 → ℝ)) (x : Fin 4 → ℝ)
    (hP : P.IsC2At x) (hξ : ∀ a, ContDiffAt ℝ 3 (fun z => ξ z a) x) (i j : Fin 4) :
    linearizedRicci (gaugeTransform P ξ) x i j = linearizedRicci P x i j := by
  simp only [linearizedRicci]
  exact Finset.sum_congr rfl fun r _ => linearizedRiemann_gauge_invariant P ξ x hP hξ r i r j

/-- Linearized Einstein tensor is gauge invariant under `C³` infinitesimal diffeomorphisms. -/
lemma linearizedEinstein_gauge_invariant (P : MetricPerturbation)
    (ξ : (Fin 4 → ℝ) → (Fin 4 → ℝ)) (x : Fin 4 → ℝ)
    (hP : P.IsC2At x) (hξ : ∀ a, ContDiffAt ℝ 3 (fun z => ξ z a) x) (i j : Fin 4) :
    linearizedEinstein (gaugeTransform P ξ) x i j = linearizedEinstein P x i j := by
  simp only [linearizedEinstein, linearizedRicciScalar,
    linearizedRicci_gauge_invariant P ξ x hP hξ]

end Linearized

end GeneralRelativity
